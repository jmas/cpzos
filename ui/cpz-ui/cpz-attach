#!/bin/sh
# Publish the compositor environment to the tmux server, then attach.
# The server starts before cage, so it cannot know WAYLAND_DISPLAY/DISPLAY.
#
# A tab is the app the user chose: when the app exits, the tab closes. If it
# was the last tab, the session ends; this loop recreates the Home session and
# attaches again instead of taking cage down with it.
set -eu
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    tmux -L cpz set-environment -g WAYLAND_DISPLAY "$WAYLAND_DISPLAY"
fi
if [ -n "${DISPLAY:-}" ]; then
    tmux -L cpz set-environment -g DISPLAY "$DISPLAY"
fi
if [ -n "${XAUTHORITY:-}" ]; then
    tmux -L cpz set-environment -g XAUTHORITY "$XAUTHORITY"
fi
# cage is a pixman-only compositor: SDL clients must use the software renderer
# and ALSA directly. Publish this once so every app launched from a tmux pane
# gets the same environment, including apps started from an older shell.
tmux -L cpz set-environment -g SDL_VIDEODRIVER wayland
tmux -L cpz set-environment -g SDL_RENDER_DRIVER software
tmux -L cpz set-environment -g SDL_AUDIODRIVER alsa

while :; do
    if ! tmux -L cpz has-session -t main 2>/dev/null; then
        tmux -f /etc/cpz/tmux.conf -L cpz new-session -d -s main -n Home || exit 1
    fi
    tmux -f /etc/cpz/tmux.conf -L cpz attach -t main || true
    sleep 0.2
done
