# CPZ image configuration.
# Copy to ./config before running ./build.sh.

IMG_NAME="cardputerzero-trixie-arm64"
# Output names default to a dated name (YYYY-MM-DD-IMG_NAME). Set IMG_FILENAME
# or ARCHIVE_FILENAME only when you need a stable name; that file is replaced
# on every build.
RELEASE="trixie"
DEPLOY_COMPRESSION="xz"
TARGET_HOSTNAME="cpz"
FIRST_USER_NAME="cpz"
FIRST_USER_PASS="cpz"
# SSH is enabled for recovery. Log in as the first user with this password;
# sudo uses the same password (PASSWORDLESS_SUDO stays off).
ENABLE_SSH=1
LOCALE_DEFAULT="en_US.UTF-8"
KEYBOARD_KEYMAP="us"
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT="UTC"

PASSWORDLESS_SUDO=0
CPZ_DEBUG_BOOT=0

# Wi-Fi regulatory domain (ISO 3166-1 alpha-2, e.g. US/GB/DE). Empty keeps
# Wi-Fi off until the user turns the radio on in Settings.
WPA_COUNTRY=""

# CardputerZero driver overlay commit. Keep this pinned for reproducible
# images; set it to "main" only when intentionally tracking upstream.
CPZ_DTOVERLAYS_REF="4f7aeee9fc103ebb03d22cac476bb191ecfb321e"

# Optional HDMI mode pin for monitors that renegotiate or lose their EDID after
# standby. Empty = use the monitor's EDID. Do not use ':D' here: forcing HPD
# always-connected would defeat the "panel off while HDMI is active" policy.
# Example: CPZ_HDMI_VIDEO="HDMI-A-1:1920x1080@60"
CPZ_HDMI_VIDEO=""

# Terminal Trove catalog index used by Settings -> Applications. Leave empty
# for the hosted default, or point at a local/alternate JSON or JSON.gz file.
CPZ_TROVE_INDEX_URL=""
