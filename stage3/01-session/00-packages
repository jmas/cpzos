# CPZ terminal session (fbcon + tmux).
tmux

# Input, network and audio plumbing used by the CPZ status bar and settings.
network-manager
polkitd
iw
rfkill
bluez
bluez-tools
pipewire
wireplumber

# Fonts: the fbcon session uses Terminus PSF fonts only. The OTB/X11 variant
# and the DejaVu font stack are not used by the console session.
fonts-terminus

# Terminal tooling.
nano
vim
less
lf
file
util-linux
fzf
htop
chafa
rsync
python3
# Interactive package browser used by Settings > Applications.
aptitude
# terminfo for tmux-256color, used by the Settings TUI and other curses apps.
ncurses-term

# First-boot account/network provisioning. rpi-preseed is what Raspberry Pi
# Imager writes; the other packages provide the helper scripts it calls.
raspberrypi-sys-mods
userconf-pi
raspi-config
rpi-preseed
whois
