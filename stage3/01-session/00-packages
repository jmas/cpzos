# CPZ graphical session (cage + foot + tmux). These are all installed in one
# apt transaction here instead of a separate 00-graphics install: one dpkg
# lock, one dependency solve, one set of triggers per stage3 rebuild.
# Xwayland is explicit because the Raspberry Pi build does not depend on it.
cage
foot
libgl1-mesa-dri
xauth
xwayland
tmux

# Input, network and audio plumbing used by the CPZ status bar and settings.
network-manager
polkitd
iw
rfkill
bluez
bluez-tools
pipewire
wireplumber

# Fonts: every family in Settings > Display > Font must be installed, because
# foot resolves the saved family through fontconfig/FreeType. Terminus also
# needs the OTB build for foot; the PSF build stays for the fbcon recovery
# consoles on tty2/tty3. Keep this list in sync with cpz-settings
# FONT_FAMILIES and cpz-foot-config.
fontconfig
fonts-terminus
fonts-terminus-otb
fonts-dejavu-core
fonts-liberation
fonts-noto-mono
fonts-hack
fonts-firacode
fonts-jetbrains-mono
# Japanese and Chinese UI catalogs need CJK glyphs; fontconfig falls back to
# Noto when the selected family does not cover a character.
fonts-noto-cjk

# Terminal tooling.
nano
vim
less
mc
lf
file
util-linux
fzf
htop
chafa

# Minimal Wayland viewers for mc/lf. imv renders through wl_shm and mpv uses
# its wlshm output, because cage (pixman) cannot import dmabuf/GL windows.
imv
mpv
cmus
rsync
python3
# terminfo for tmux-256color, used by the Settings TUI and other curses apps.
ncurses-term

# First-boot account/network provisioning. rpi-preseed is what Raspberry Pi
# Imager writes; the other packages provide the helper scripts it calls.
raspberrypi-sys-mods
userconf-pi
raspi-config
rpi-preseed
whois
