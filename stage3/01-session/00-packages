# CPZ graphical session (cage + foot + tmux). cage, foot and the Mesa DRI
# drivers are installed by 00-graphics.
tmux

# Input, network and audio plumbing used by the CPZ status bar and settings.
network-manager
polkitd
iw
rfkill
bluez
bluez-tools
pipewire
wireplumber

# Fonts: foot renders Terminus through fontconfig/FreeType, so the OTB build
# is required. The PSF build stays for the fbcon recovery consoles on tty2/tty3.
fonts-dejavu-core
fontconfig
fonts-terminus
fonts-terminus-otb

# Terminal tooling.
nano
vim
less
mc
lf
file
util-linux
fzf
htop
chafa
rsync
python3
# terminfo for tmux-256color, used by the Settings TUI and other curses apps.
ncurses-term

# First-boot account/network provisioning. rpi-preseed is what Raspberry Pi
# Imager writes; the other packages provide the helper scripts it calls.
raspberrypi-sys-mods
userconf-pi
raspi-config
rpi-preseed
whois
