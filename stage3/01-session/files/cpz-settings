    current = timedatectl_value("NTP").lower()
    target = "false" if current == "yes" else "true"
    rc = run_privileged(screen, ["timedatectl", "set-ntp", target])
    return None if rc == 0 else "Time sync change failed"


def timezone_action(zone: str):
    def action(screen, _data) -> str | None:
        rc = run_privileged(screen, ["timedatectl", "set-timezone", zone])
        return "Time zone set" if rc == 0 else "Time zone change failed"

    return action


def power_action(action: str, question: str):
    def run(screen, _data) -> None:
        if not confirm(screen, question):
            return
        # logind allows the active local seat to reboot/power off/suspend
        # without a password. Fall back to sudo only if polkit denies it.
        if run_interactive(screen, ["systemctl", action]) != 0:
            run_privileged(screen, ["systemctl", action])

    return run


