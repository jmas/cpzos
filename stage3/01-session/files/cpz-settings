def cli_install_tool(slug: str) -> int:
    """Install from CPZ Search without the curses Applications screen."""
    tool = find_trove_tool(slug)
    if tool is None:
        print(f"cpz-settings: unknown app '{slug}'", file=sys.stderr)
        return 2
    name = str(tool.get("name", "")).strip() or slug
    apt_names = trove_apt_names()
    apt = resolve_trove_apt(tool, apt_names)
    if apt["status"] == "installed":
        print(tr("{name} is already installed", name=name))
        return 0
    if apt["status"] == "missing":
        print(tr("{name} is not available in apt", name=name))
        commands = trove_install_commands(tool)
        if commands:
            print(tr("Install it manually:"))
            for manager, command in commands:
                print(f"  {manager}: {command}")
        return 1

    package = apt["package"]
    gui_signals = trove_gui_signals(tool, apt)
    if gui_signals:
        print(tr("Warning: this may be a desktop app, not a CLI/TUI app."))
        for signal in gui_signals:
            print(f"  - {signal}")
    print(tr("Installing {name} ({package})...", name=name, package=package))
    if apt.get("needs_update") == "1":
        print("Updating apt lists...")
        rc = subprocess.call(
            [
                "sudo",
                "env",
                "DEBIAN_FRONTEND=noninteractive",
                "apt-get",
                "update",
            ]
        )
        if rc != 0:
            print("apt update failed", file=sys.stderr)
            return 1
        _TROVE_APT_METADATA.clear()
        apt = resolve_trove_apt(tool, set())
        if apt["status"] == "installed":
            print(tr("{name} is already installed", name=name))
            return 0
        if apt["status"] == "missing":
            print(
                tr(
                    "{name} is not available in apt after update",
                    name=name,
                ),
                file=sys.stderr,
            )
            return 1
        package = apt["package"]
        updated_signals = trove_gui_signals(tool, apt)
        if updated_signals and updated_signals != gui_signals:
            print(
                tr("Warning: this may be a desktop app, not a CLI/TUI app.")
            )
            for signal in updated_signals:
                print(f"  - {signal}")

    rc = subprocess.call(["sudo", *TROVE_APT_INSTALL, package])
    if rc != 0:
        print("Install failed (try sudo apt update)", file=sys.stderr)
        return 1

    apps = read_trove_apps()
    apps[slug] = {
        "slug": slug,
        "name": name,
        "package": package,
        "version": apt_status(package).get("version", ""),
        "installed_at": datetime.now().isoformat(timespec="seconds"),
        "install_command": catalog_trove_apt(tool).get("command")
        or f"apt install {package}",
        "uninstall_command": f"apt-get purge {package}",
    }
    try:
        write_trove_apps(apps)
    except OSError:
        print(tr("Installed {name} (manager state not saved)", name=name))
        return 0
    print(tr("Installed {name}", name=name))
    print(tr("Open Search (Alt+O) to run it."))
    return 0


def simulate_removal(name: str) -> list[str] | None:
    try:
        result = subprocess.run(
            ["apt-get", "-s", "purge", name],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    planned = []
    for line in result.stdout.splitlines():
        if line.startswith(("Remv ", "Purg ")):
            planned.append(line.split()[1])
    return planned


def draw_loading(screen, text: str) -> None:
    screen.erase()
    height, _width = screen.getmaxyx()
    put(screen, max(0, height // 2), SCREEN_PAD, " " + tr(text))
    screen.refresh()


def draw_trove_list(
    screen,
    mode: str,
    tools: list[dict[str, Any]],
    selected: int,
    category_label: str,
    language_label: str,
    query: str,
    search_active: bool,
    managed: dict[str, dict[str, Any]],
    index_count: int,
    apt_only: bool = False,
) -> None:
    screen.erase()
    height, width = screen.getmaxyx()
    left = SCREEN_PAD
    cw = content_width(width)
    title = tr("Applications")
    if index_count:
        title += " · " + tr("{count} of {total}", count=len(tools), total=index_count)
    else:
        title += " · " + tr("catalog not downloaded")
    put(screen, 0, left, title, curses.A_BOLD)

    tab_x = left
    for text, tab_mode in (
        (" " + tr("Browse") + " ", "browse"),
        (" " + tr("Installed") + " ", "installed"),
    ):
        piece = text
        attr = curses.A_REVERSE if mode == tab_mode else curses.A_DIM
        put(screen, 1, tab_x, piece, attr)
        tab_x += len(piece)
    put(screen, 1, tab_x + 1, tr("Tab"), curses.A_DIM)

    if search_active:
        put(screen, 2, left, tr("Search: {query}", query=query) + "_")
    elif mode == "browse":
        filters = [
            tr("Category: {label}", label=tr(category_label)),
            tr("Language: {label}", label=tr(language_label)),
        ]
        if apt_only:
            filters.insert(0, tr("Apt only"))
        put(
            screen,
            2,
            left,
            text_truncate(" " + " · ".join(filters), cw),
        )

    top = 3
    list_bottom = max(top + 1, height - 2)
    visible = max(1, list_bottom - top)
    first = 0
    if selected >= visible:
        first = selected - visible + 1
    first = max(0, min(first, max(0, len(tools) - visible)))

    name_width = min(26, max(12, cw // 3))
    for offset, tool in enumerate(tools[first : first + visible]):
        row = first + offset
        marker = "*" if tool.get("slug") in managed else " "
        name = text_truncate(
            str(tool.get("name", tool.get("slug", "?"))),
            name_width,
        )
        if mode == "installed":
            record = tool.get("_record") or {}
            package = str(record.get("package", ""))
            version = str(record.get("version", "")).strip()
            text = (
                f"{marker}{'>' if row == selected else ' '} "
                f"{text_pad(name, name_width)} {package} {version}"
            )
        else:
            text = (
                f"{marker}{'>' if row == selected else ' '} "
                f"{text_pad(name, name_width)} {tool.get('summary', '')}"
            )
        put(
            screen,
            top + offset,
            left,
            text_pad(text, cw),
            curses.A_REVERSE if row == selected else 0,
        )
    if not tools:
        if not index_count:
            message = "No catalog. Press u to download it."
        elif mode == "installed":
            message = "Nothing installed yet. Tab opens Browse."
        elif apt_only:
            message = "No apt tools match. Press a for all."
        else:
            message = "No matches. Esc clears the filter."
        put(screen, top, left + 1, tr(message))
    if first > 0:
        put(screen, top, left + cw - 1, "^")
    if first + visible < len(tools):
        put(screen, top + visible - 1, left + cw - 1, "v")

    chosen = tools[selected] if tools and selected < len(tools) else None
    summary_y = list_bottom
    if chosen and summary_y < height - 1:
        put(screen, summary_y, left + 1, str(chosen.get("summary", "")))

    if search_active:
        hint = tr("Type to filter  Enter keep  Esc clear")
    elif not index_count:
        hint = tr("u download catalog  q back")
    elif mode == "browse":
        hint = tr("F/X move  / search  Enter info  i install  q back")
    else:
        hint = tr("F/X move  / search  Enter info  e run  q back")
    put(screen, height - 1, left, hint, hint_attr())
    screen.refresh()


def trove_details_screen(
    screen,
    tool: dict[str, Any],
    record: dict[str, Any] | None,
    apt_names: set[str] | None = None,
) -> None:
    offset = 0
    if apt_names is None:
        apt_names = trove_apt_names()
    gui_signals = trove_gui_signals(
        tool, resolve_trove_apt(tool, apt_names)
    )
    while True:
        apt = resolve_trove_apt(tool, apt_names)
        managed = read_trove_apps()
        current = managed.get(str(tool.get("slug", "")))
        record = current
        _height, width = screen.getmaxyx()
        left = SCREEN_PAD
        cw = content_width(width)
        lines = trove_details_lines(tool, apt, record, cw, gui_signals)
        screen.erase()
        height, _width = screen.getmaxyx()
        title = str(tool.get("name", tool.get("slug", "?")))
        put(screen, 0, left, title, curses.A_BOLD)
        visible = max(1, height - 4)
        offset = max(0, min(offset, max(0, len(lines) - visible)))
        for index in range(visible):
            line = lines[offset + index] if offset + index < len(lines) else ""
            put(screen, 2 + index, left, tr(line))
        put(
            screen,
            height - 1,
            left,
            tr("F/X scroll i install d remove e run q"),
            hint_attr(),
        )
        screen.refresh()

        key = screen.getch()
        if key == curses.KEY_MOUSE:
            event = read_mouse()
            if event is None:
                continue
            delta = mouse_wheel_delta(event[2])
            if delta:
                offset = max(
                    0,
                    min(max(0, len(lines) - visible), offset + delta),
                )
            continue
        if key in (ord("q"), ord("Q"), 27):
            return
        if key in NAV_UP:
            offset = max(0, offset - 1)
            continue
        if key in NAV_DOWN:
            offset = min(max(0, len(lines) - visible), offset + 1)
            continue
        if key == curses.KEY_PPAGE:
            offset = max(0, offset - visible)
            continue
        if key == curses.KEY_NPAGE:
            offset = min(max(0, len(lines) - visible), offset + visible)
            continue
        if key in (ord("i"), ord("I")):
            if record:
                notify(
                    screen,
                    "Already installed through the manager",
                    title="Applications",
                    error=False,
                )
            elif apt["status"] == "missing":
                notify(
                    screen,
                    "No apt package. Use the install command above.",
                    title="Applications",
                )
            else:
                notify(
                    screen,
                    trove_install_tool(screen, tool, apt_names),
                    title="Applications",
                )
                gui_signals = trove_gui_signals(
                    tool, resolve_trove_apt(tool, apt_names)
                )
            continue
        if key in (ord("e"), ord("E")):
            error = run_trove_app(screen, tool, record)
            if error:
                notify(screen, error, title="Applications", error=False)
            continue
        if key in (ord("d"), ord("D")):
            if record:
                notify(
                    screen,
                    trove_uninstall_tool(screen, record),
                    title="Applications",
                )
            else:
                notify(
                    screen,
                    "Not installed through the manager",
                    title="Applications",
                    error=False,
                )
            continue


def executable_names() -> set[str]:
    """Return executable names in PATH for the Trove launch hints."""
    names = set()
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            continue
        try:
            entries = os.scandir(directory)
        except OSError:
            continue
        with entries:
            for entry in entries:
                if any(ord(char) < 32 for char in entry.name):
                    continue
                try:
                    if entry.is_file() and os.access(entry.path, os.X_OK):
                        names.add(entry.name)
                except OSError:
                    continue
    return names


def trove_command(tool: dict[str, Any], available: set[str]) -> str:
    """Pick the command that Terminal Trove's tool most likely installs."""
    name = str(tool.get("name", "")).strip().lower()
    candidates = [
        str(tool.get("slug", "")).strip(),
        name.replace(" ", "-"),
        name.replace(" ", ""),
        catalog_trove_apt(tool).get("package", ""),
    ]
    for candidate in candidates:
        if candidate and candidate in available:
            return candidate
    return ""


def package_executables(package: str) -> list[str]:
    """Executable names that dpkg says an installed package provides."""
    if not package or not APT_NAME_RE.fullmatch(package):
        return []
    rc, out, _ = nm_run(["dpkg", "-L", package], timeout=10)
    if rc != 0:
        return []
    names = []
    for path in out.splitlines():
        path = path.strip()
        if not path or os.path.dirname(path) not in (
            "/usr/local/bin",
            "/usr/bin",
            "/bin",
            "/usr/local/sbin",
            "/usr/sbin",
            "/sbin",
        ):
            continue
        try:
            if os.path.isfile(path) and os.access(path, os.X_OK):
                names.append(os.path.basename(path))
        except OSError:
            continue
    return sorted(set(names))


def managed_trove_command(
    record: dict[str, Any], available: set[str]
) -> str:
    """Find the command of an app installed through the manager.

    Most packages install a binary named like the package, but a few (for
    example ``github-cli``) use a different name. dpkg -L covers those so an
    installed app can still be run from Search.
    """
    name = str(record.get("name", "")).strip().lower()
    candidates = (
        str(record.get("slug", "")).strip(),
        str(record.get("package", "")).strip(),
        name.replace(" ", "-"),
        name.replace(" ", ""),
    )
    for candidate in candidates:
        if candidate and candidate in available:
            return candidate
    installed_names = [
        name
        for name in package_executables(str(record.get("package", "")).strip())
        if name in available
    ]
    for candidate in candidates:
        if candidate and candidate in installed_names:
            return candidate
    for name in installed_names:
        if any(
            candidate and (name.startswith(candidate) or candidate.startswith(name))
            for candidate in candidates
        ):
            return name
    return installed_names[0] if installed_names else ""


def list_tools_payload() -> dict[str, Any]:
    """Machine-readable app list used by CPZ Search (Alt+O, apps provider)."""
    index = load_trove_index()
    managed = read_trove_apps()
    available = executable_names()
    apt_names = trove_apt_names()
    tools = []
    for tool in index.get("tools", []):
        slug = str(tool.get("slug", "")).strip()
        if not slug:
            continue
        record = managed.get(slug)
        command = trove_command(tool, available)
        if not command and record:
            command = managed_trove_command(record, available)
        apt = catalog_trove_apt(tool)
        tools.append(
            {
                "slug": slug,
                "name": str(tool.get("name", "")).strip() or slug,
                "summary": str(tool.get("summary", "")).strip(),
                "categories": list(tool.get("categories") or []),
                "command": command,
                "installed": bool(command or record),
                "managed": record is not None,
                "apt": apt.get("package", ""),
                "available": bool(
                    record or trove_tool_apt_supported(tool, apt_names)
                ),
            }
        )
    seen = {str(tool.get("slug", "")) for tool in tools}
    for slug, record in managed.items():
        if slug in seen:
            continue
        tools.append(
            {
                "slug": slug,
                "name": str(record.get("name", "")).strip() or slug,
                "summary": tr("Managed apt package"),
                "categories": [],
                "command": managed_trove_command(record, available),
                "installed": True,
                "managed": True,
                "apt": str(record.get("package", "")).strip(),
                "available": True,
            }
        )
    return {"schema": 1, "tools": tools}


def run_trove_app(
    screen,
    tool: dict[str, Any],
    record: dict[str, Any] | None = None,
) -> str | None:
    """Run an installed catalog app and return an error message, if any."""
    available = executable_names()
    command = trove_command(tool, available)
    if not command and record:
        command = managed_trove_command(record, available)
    if not command:
        package = str(
            tool.get("_package") or catalog_trove_apt(tool).get("package", "")
        ).strip()
        command = next(
            (
                name
                for name in package_executables(package)
                if name in available
            ),
            "",
        )
    if not command:
        return "No runnable command found"
    # The tmux server predates cage, so it does not hold WAYLAND_DISPLAY or
    # XAUTHORITY. cpz-run applies the environment published by foot before
    # starting the app.
    runner = "/usr/local/bin/cpz-run"
    command_line = [runner, command] if os.access(runner, os.X_OK) else [command]
    run_interactive(screen, command_line)
    return None


def browse_trove_tools(
    tools: list[dict[str, Any]],
    apt_names: set[str],
    apt_candidates: list[str],
    query: str,
    category: str,
    language: str,
    apt_only: bool,
    apt_search_cache: dict[tuple[str, tuple[str, ...]], list[dict[str, Any]]],
) -> list[dict[str, Any]]:
    """Return the Browse list for one query.

    A plain listing stays on the catalog index (apt-filtered by default). Once
    the user searches, catalog matches stay first and ordinary apt packages are
    appended after them.
    """
    shown = filter_trove_tools(
        tools,
        query,
        category,
        language,
        apt_names if apt_only else None,
    )
    if len(query.strip()) < 2:
        return shown
    # Skip packages already represented by a visible catalog row, so one app
    # cannot appear twice. The index rows always keep their position at the top.
    skip_packages = set()
    for tool in shown:
        skip_packages.add(str(tool.get("slug", "")).strip().lower())
        skip_packages.add(str(tool.get("name", "")).strip().lower())
        skip_packages.add(
            catalog_trove_apt(tool).get("package", "").lower()
        )
    skip_packages.discard("")
    cache_key = (query, tuple(sorted(skip_packages)))
    if cache_key not in apt_search_cache:
        apt_search_cache[cache_key] = apt_search_tools(
            query,
            apt_names,
            skip_packages,
            candidates=apt_candidates,
        )
    return shown + apt_search_cache[cache_key]


def trove_apps_screen(screen, focus_slug: str | None = None) -> None:
    data = load_settings()
    apply_language(data["language"])
    enable_mouse()
    draw_loading(screen, "Loading app catalog...")
    index = load_trove_index()
    tools = index.get("tools", [])
    managed = read_trove_apps()
    categories = trove_category_options(index)
    languages = trove_language_options(index)
    draw_loading(screen, "Checking installable apps...")
    apt_names = trove_apt_names()
    apt_available = bool(apt_names)
    apt_candidates = [
        name for name in apt_names if apt_looks_like_app(name)
    ]
    apt_only = apt_available and not focus_slug
    mode = "browse"
    category = ""
    language = ""
    query = focus_slug or ""
    search_active = False
    row = {"browse": 0, "installed": 0}
    apt_search_cache: dict[tuple[str, tuple[str, ...]], list[dict[str, Any]]] = {}
    if not tools and not (focus_slug and focus_slug in managed):
        notify(
            screen,
            "Catalog not downloaded. Press u to update.",
            title="Applications",
            wait=True,
        )
    elif not apt_available:
        notify(
            screen,
            "Package list unavailable; showing all apps",
            title="Applications",
            wait=True,
            error=False,
        )
    if focus_slug:
        # CPZ Search's "Enter info" and Ctrl+O name one app, so show that app's
        # details straight away. Landing on a filtered catalog list made it look
        # as if the app page had not opened at all.
        focused = next(
            (
                tool
                for tool in tools
                if str(tool.get("slug", "")).strip() == focus_slug
            ),
            None,
        )
        if focused is None and focus_slug in managed:
            focused = trove_tool_from_record(managed[focus_slug])
        if focused is not None:
            trove_details_screen(
                screen, focused, managed.get(focus_slug), apt_names or None
            )
            return

    while True:
        if mode == "browse":
            shown = browse_trove_tools(
                tools,
                apt_names,
                apt_candidates,
                query,
                category,
                language,
                apt_only,
                apt_search_cache,
            )
        else:
            shown = trove_installed_tools(index, managed, query)
        position = min(row[mode], max(0, len(shown) - 1))
        if focus_slug:
            for offset, tool in enumerate(shown):
                if str(tool.get("slug", "")) == focus_slug:
                    position = offset
                    break
            focus_slug = None
        row[mode] = position
        draw_trove_list(
            screen,
            mode,
            shown,
            position,
            trove_option_label(categories, category, "All"),
            trove_option_label(languages, language, "All"),
            query,
            search_active,
            managed,
            len(tools),
            apt_only=apt_only,
        )
        key = screen.getch()
        if key == curses.KEY_MOUSE:
            wheel = read_wheel_key()
            if wheel is None:
                continue
            key = wheel

        if key == 9:  # Tab
            mode = "installed" if mode == "browse" else "browse"
            search_active = False
            continue
        if search_active:
            if key == 27:
                if query:
                    query = ""
                    row[mode] = 0
                else:
                    search_active = False
                continue
            if key in (10, 13):
                search_active = False
                continue
            if key in (curses.KEY_BACKSPACE, 8, 127):
                query = query[:-1]
                row[mode] = 0
                continue
            if 32 <= key < 127:
                query += chr(key)
                row[mode] = 0
                continue
            if key in NAV_UP and shown:
                row[mode] = (position - 1) % len(shown)
                continue
            if key in NAV_DOWN and shown:
                row[mode] = (position + 1) % len(shown)
                continue
            continue
        if key in (ord("a"), ord("A")) and mode == "browse":
            if not apt_available:
                notify(
                    screen,
                    "Package list unavailable",
                    title="Applications",
                    wait=True,
                    error=False,
                )
                continue
            apt_only = not apt_only
            row["browse"] = 0
            notify(
                screen,
                "Showing apt packages only"
                if apt_only
                else "Showing all catalog tools",
                title="Applications",
                error=False,
            )
            continue
        if key in (ord("q"), ord("Q"), 27):
            if query:
                query = ""
                row[mode] = 0
                continue
            return
        if key in (ord("/"), ord("s"), ord("S")):
            search_active = True
            continue

        if key in (ord("u"), ord("U")):
            draw_loading(screen, "Updating catalog...")
            ok, message = download_trove_index()
            notify(screen, message, title="Applications", error=not ok)
            if ok:
                index = load_trove_index()
                tools = index.get("tools", [])
                categories = trove_category_options(index)
                languages = trove_language_options(index)
                draw_loading(screen, "Checking installable apps...")
                apt_names = trove_apt_names()
                apt_available = bool(apt_names)
                apt_candidates = [
                    name for name in apt_names if apt_looks_like_app(name)
                ]
                if not apt_available:
                    apt_only = False
                row = {"browse": 0, "installed": 0}
                apt_search_cache.clear()
            continue
        if key in (ord("t"), ord("T")) and mode == "browse":
            value = trove_filter_popup(screen, "Category", categories, category)
            if value is not None:
                category = value
                row["browse"] = 0
            continue
        if key in (ord("g"), ord("G")) and mode == "browse":
            value = trove_filter_popup(screen, "Language", languages, language)
            if value is not None:
                language = value
                row["browse"] = 0
            continue
        if key in NAV_LEFT and mode == "browse":
            if categories:
                slugs = [item[0] for item in categories]
                current = slugs.index(category) if category in slugs else 0
                category = slugs[(current - 1) % len(slugs)]
                row["browse"] = 0
            continue
        if key in NAV_RIGHT and mode == "browse":
            if categories:
                slugs = [item[0] for item in categories]
                current = slugs.index(category) if category in slugs else 0
                category = slugs[(current + 1) % len(slugs)]
                row["browse"] = 0
            continue
        if key in NAV_UP:
            if shown:
                row[mode] = (position - 1) % len(shown)
            continue
        if key in NAV_DOWN:
            if shown:
                row[mode] = (position + 1) % len(shown)
            continue
        if key in (curses.KEY_PPAGE, curses.KEY_NPAGE, curses.KEY_HOME, curses.KEY_END):
            if not shown:
                continue
            page = max(1, screen.getmaxyx()[0] - 5)
            if key == curses.KEY_PPAGE:
                position = max(0, position - page)
            elif key == curses.KEY_NPAGE:
                position = min(len(shown) - 1, position + page)
            elif key == curses.KEY_HOME:
                position = 0
            else:
                position = len(shown) - 1
            row[mode] = position
            continue
        if key in (10, 13, ord(" ")) and shown:
            tool = shown[position]
            record = tool.get("_record") if mode == "installed" else managed.get(
                str(tool.get("slug", ""))
            )
            trove_details_screen(screen, tool, record, apt_names)
            managed = read_trove_apps()
            continue
        if key in (ord("i"), ord("I")) and mode == "browse" and shown:
            notify(
                screen,
                trove_install_tool(screen, shown[position], apt_names),
                title="Applications",
            )
            managed = read_trove_apps()
            continue
        if key in (ord("e"), ord("E")) and shown:
            tool = shown[position]
            record = tool.get("_record") if mode == "installed" else managed.get(
                str(tool.get("slug", ""))
            )
            error = run_trove_app(screen, tool, record)
            if error:
                notify(screen, error, title="Applications", error=False)
            continue
        if key in (ord("d"), ord("D")) and mode == "installed" and shown:
            record = shown[position].get("_record") or managed.get(
                str(shown[position].get("slug", ""))
            )
            if record:
                notify(
                    screen,
                    trove_uninstall_tool(screen, record),
                    title="Applications",
                )
                managed = read_trove_apps()
            continue


