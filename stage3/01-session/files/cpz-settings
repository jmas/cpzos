def draw_hub_list(
    screen,
    mode: str,
    tools: list[dict[str, Any]],
    selected: int,
    query: str,
    search_active: bool,
    managed: dict[str, dict[str, Any]],
    installed: dict[str, str],
    index_count: int,
) -> None:
    screen.erase()
    height, width = screen.getmaxyx()
    left = SCREEN_PAD
    cw = content_width(width)
    title = tr("Applications")
    if index_count:
        title += " · " + tr("{count} apps", count=index_count)
    put(screen, 0, left, title, curses.A_BOLD)

    tab_x = left
    for text, tab_mode in (
        (" " + tr("Browse") + " ", "browse"),
        (" " + tr("Installed") + " ", "installed"),
    ):
        attr = curses.A_REVERSE if mode == tab_mode else curses.A_DIM
        put(screen, 1, tab_x, text, attr)
        tab_x += len(text)
    put(screen, 1, tab_x + 1, tr("Tab"), curses.A_DIM)

    if search_active:
        put(screen, 2, left, tr("Search: {query}", query=query) + "_")
    elif mode == "browse":
        put(
            screen,
            2,
            left,
            tr("Catalog: {count} apps", count=index_count),
        )

    top = 3
    list_bottom = max(top + 1, height - 2)
    visible = max(1, list_bottom - top)
    first = 0
    if selected >= visible:
        first = selected - visible + 1
    first = max(0, min(first, max(0, len(tools) - visible)))

    name_width = min(26, max(12, cw // 3))
    for offset, tool in enumerate(tools[first : first + visible]):
        row = first + offset
        status = hub_app_status(tool, managed, installed)
        marker = "*" if status == "managed" else "+" if status == "system" else " "
        name = text_truncate(str(tool.get("name", tool.get("id", "?"))), name_width)
        if mode == "installed":
            record = tool.get("_record") or {}
            package = str(record.get("package", ""))
            version = str(record.get("version", "")).strip()
            text = (
                f"{marker}{'>' if row == selected else ' '} "
                f"{text_pad(name, name_width)} {package} {version}"
            )
        else:
            text = (
                f"{marker}{'>' if row == selected else ' '} "
                f"{text_pad(name, name_width)} {tool.get('summary', '')}"
            )
        put(
            screen,
            top + offset,
            left,
            text_pad(text, cw),
            curses.A_REVERSE if row == selected else 0,
        )
    if not tools:
        if not index_count:
            message = "No app catalog. Press u to update."
        elif mode == "installed":
            message = "Nothing installed yet. Tab opens Browse."
        else:
            message = "No matches. Esc clears the filter."
        put(screen, top, left + 1, tr(message))
    if first > 0:
        put(screen, top, left + cw - 1, "^")
    if first + visible < len(tools):
        put(screen, top + visible - 1, left + cw - 1, "v")

    chosen = tools[selected] if tools and selected < len(tools) else None
    summary_y = list_bottom
    if chosen and summary_y < height - 1:
        put(screen, summary_y, left + 1, str(chosen.get("summary", "")))

    if search_active:
        hint = tr("Type to filter  Enter keep  Esc clear")
    elif mode == "browse":
        hint = tr("F/X move  / search  Enter info  i install  u update  q back")
    else:
        hint = tr("F/X move  / search  Enter info  e run  d remove  q back")
    put(screen, height - 1, left, hint, hint_attr())
    screen.refresh()


def hub_details_screen(
    screen,
    app: dict[str, Any],
    record: dict[str, Any] | None = None,
) -> None:
    offset = 0
    while True:
        installed = dpkg_installed()
        managed = read_hub_apps()
        record = managed.get(str(app.get("id", "")))
        _height, width = screen.getmaxyx()
        left = SCREEN_PAD
        cw = content_width(width)
        lines = hub_details_lines(app, record, installed, cw)
        screen.erase()
        height, _width = screen.getmaxyx()
        put(screen, 0, left, str(app.get("name", app.get("id", "?"))), curses.A_BOLD)
        visible = max(1, height - 4)
        offset = max(0, min(offset, max(0, len(lines) - visible)))
        for index in range(visible):
            line = lines[offset + index] if offset + index < len(lines) else ""
            put(screen, 2 + index, left, tr(line))
        put(
            screen,
            height - 1,
            left,
            tr("F/X scroll i install d remove e run q"),
            hint_attr(),
        )
        screen.refresh()

        key = screen.getch()
        if key == curses.KEY_MOUSE:
            event = read_mouse()
            if event is None:
                continue
            delta = mouse_wheel_delta(event[2])
            if delta:
                offset = max(0, min(max(0, len(lines) - visible), offset + delta))
            continue
        if key in (ord("q"), ord("Q"), 27):
            return
        if key in NAV_UP:
            offset = max(0, offset - 1)
            continue
        if key in NAV_DOWN:
            offset = min(max(0, len(lines) - visible), offset + 1)
            continue
        if key == curses.KEY_PPAGE:
            offset = max(0, offset - visible)
            continue
        if key == curses.KEY_NPAGE:
            offset = min(max(0, len(lines) - visible), offset + visible)
            continue
        if key in (ord("i"), ord("I")):
            notify(
                screen,
                hub_install_tool(screen, app),
                title="Applications",
            )
            continue
        if key in (ord("e"), ord("E")):
            error = run_hub_app(screen, app, record)
            if error:
                notify(screen, error, title="Applications", error=False)
            continue
        if key in (ord("d"), ord("D")):
            if record:
                notify(
                    screen,
                    hub_uninstall_tool(screen, record),
                    title="Applications",
                )
            else:
                notify(
                    screen,
                    "Not installed through the manager",
                    title="Applications",
                    error=False,
                )
            continue


def executable_names() -> set[str]:
    names = set()
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            continue
        try:
            entries = os.scandir(directory)
        except OSError:
            continue
        with entries:
            for entry in entries:
                if any(ord(char) < 32 for char in entry.name):
                    continue
                try:
                    if entry.is_file() and os.access(entry.path, os.X_OK):
                        names.add(entry.name)
                except OSError:
                    continue
    return names


def package_executables(package: str) -> list[str]:
    if not package or not APT_NAME_RE.fullmatch(package):
        return []
    try:
        result = subprocess.run(
            ["dpkg", "-L", package],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    if result.returncode != 0:
        return []
    names = []
    for path in result.stdout.splitlines():
        path = path.strip()
        if not path or os.path.dirname(path) not in (
            "/usr/local/bin",
            "/usr/bin",
            "/bin",
            "/usr/local/sbin",
            "/usr/sbin",
            "/sbin",
        ):
            continue
        try:
            if os.path.isfile(path) and os.access(path, os.X_OK):
                names.append(os.path.basename(path))
        except OSError:
            continue
    return sorted(set(names))


def hub_command(
    app: dict[str, Any],
    available: set[str],
    record: dict[str, Any] | None = None,
    installed_packages: dict[str, str] | None = None,
) -> str:
    candidates = [
        str(app.get("command", "")).strip(),
        str(app.get("id", "")).strip(),
        str(app.get("name", "")).strip().lower().replace(" ", "-"),
        str(app.get("name", "")).strip().lower().replace(" ", ""),
        str(app.get("package", "")).strip(),
        str((record or {}).get("slug", "")).strip(),
        str((record or {}).get("package", "")).strip(),
    ]
    for candidate in candidates:
        if candidate and candidate in available:
            return candidate
    package = str(app.get("package", "")).strip()
    if installed_packages is not None and package not in installed_packages:
        return ""
    installed_names = [
        name for name in package_executables(package) if name in available
    ]
    for candidate in candidates:
        if candidate and candidate in installed_names:
            return candidate
    for name in installed_names:
        if any(
            candidate and (name.startswith(candidate) or candidate.startswith(name))
            for candidate in candidates
        ):
            return name
    return installed_names[0] if installed_names else ""


def list_tools_payload() -> dict[str, Any]:
    """Machine-readable app list used by CPZ Search (Alt+O, apps provider)."""
    index = load_hub_index()
    managed = read_hub_apps()
    installed = dpkg_installed()
    available = executable_names()
    tools = []
    seen = set()
    for app in index.get("apps", []):
        slug = str(app.get("id", "")).strip()
        if not slug:
            continue
        seen.add(slug)
        record = managed.get(slug)
        command = hub_command(app, available, record, installed)
        package = str(app.get("package", "")).strip()
        tools.append(
            {
                "slug": slug,
                "name": str(app.get("name", "")).strip() or slug,
                "summary": str(app.get("summary", "")).strip(),
                "categories": list(app.get("categories") or []),
                "kind": str(app.get("kind", "apt")),
                "command": command,
                "installed": bool(record or package in installed),
                "managed": record is not None,
                "package": package,
                "version": installed.get(package, "")
                or (record or {}).get("version")
                or str(app.get("version", "")),
                "available": True,
            }
        )
    for slug, record in managed.items():
        if slug in seen:
            continue
        package = str(record.get("package", "")).strip()
        tools.append(
            {
                "slug": slug,
                "name": str(record.get("name", "")).strip() or slug,
                "summary": tr("Managed package"),
                "categories": [],
                "kind": str(record.get("kind", "apt")),
                "command": hub_command(
                    {
                        "id": slug,
                        "name": str(record.get("name", "")),
                        "package": package,
                    },
                    available,
                    record,
                    installed,
                ),
                "installed": True,
                "managed": True,
                "package": package,
                "version": str(record.get("version", "")).strip()
                or installed.get(package, ""),
                "available": True,
            }
        )
    return {"schema": 1, "tools": tools}


def run_hub_app(
    screen,
    app: dict[str, Any],
    record: dict[str, Any] | None = None,
) -> str | None:
    available = executable_names()
    command = hub_command(app, available, record, dpkg_installed())
    if not command:
        return "No runnable command found"
    runner = "/usr/local/bin/cpz-run"
    command_line = [runner, command] if os.access(runner, os.X_OK) else [command]
    run_interactive(screen, command_line)
    return None


def hub_apps_screen(screen, focus_slug: str | None = None) -> None:
    data = load_settings()
    apply_language(data["language"])
    enable_mouse()
    refresh_proc = start_hub_refresh()
    index = load_hub_index()
    apps = index.get("apps", [])
    managed = read_hub_apps()
    installed = dpkg_installed()
    mode = "browse"
    query = focus_slug or ""
    search_active = False
    row = {"browse": 0, "installed": 0}
    if not apps and not managed:
        notify(
            screen,
            "No app catalog in this image. Press u to update.",
            title="Applications",
            wait=True,
        )
    if focus_slug:
        focused = hub_app_by_id(focus_slug, apps)
        if focused is not None:
            hub_details_screen(screen, focused, managed.get(focus_slug))
            return

    while True:
        if refresh_proc is not None and refresh_proc.poll() is not None:
            if refresh_proc.returncode == 0:
                updated = load_hub_index()
                if updated.get("generated_at") != index.get("generated_at"):
                    index = updated
                    apps = index.get("apps", [])
            refresh_proc = None
            managed = read_hub_apps()
            installed = dpkg_installed()

        if mode == "browse":
            shown = filter_hub_apps(apps, query)
        else:
            shown = hub_installed_tools(index, managed, installed, query)
        position = min(row[mode], max(0, len(shown) - 1))
        if focus_slug:
            for offset, tool in enumerate(shown):
                if str(tool.get("id", "")) == focus_slug:
                    position = offset
                    break
            focus_slug = None
        row[mode] = position
        draw_hub_list(
            screen,
            mode,
            shown,
            position,
            query,
            search_active,
            managed,
            installed,
            len(apps),
        )
        key = screen.getch()
        if key == curses.KEY_MOUSE:
            wheel = read_wheel_key()
            if wheel is None:
                continue
            key = wheel

        if key == 9:  # Tab
            mode = "installed" if mode == "browse" else "browse"
            search_active = False
            continue
        if search_active:
            if key == 27:
                if query:
                    query = ""
                    row[mode] = 0
                else:
                    search_active = False
                continue
            if key in (10, 13):
                search_active = False
                continue
            if key in (curses.KEY_BACKSPACE, 8, 127):
                query = query[:-1]
                row[mode] = 0
                continue
            if 32 <= key < 127:
                query += chr(key)
                row[mode] = 0
                continue
            if key in NAV_UP and shown:
                row[mode] = (position - 1) % len(shown)
                continue
            if key in NAV_DOWN and shown:
                row[mode] = (position + 1) % len(shown)
                continue
            continue
        if key in (ord("q"), ord("Q"), 27):
            if query:
                query = ""
                row[mode] = 0
                continue
            return
        if key in (ord("/"), ord("s"), ord("S")):
            search_active = True
            continue
        if key in (ord("u"), ord("U")):
            if refresh_proc is None or refresh_proc.poll() is not None:
                refresh_proc = start_hub_refresh(force=True)
            notify(
                screen,
                "Updating app catalog in the background",
                title="Applications",
                error=False,
            )
            continue
        if key in NAV_UP:
            if shown:
                row[mode] = (position - 1) % len(shown)
            continue
        if key in NAV_DOWN:
            if shown:
                row[mode] = (position + 1) % len(shown)
            continue
        if key in (curses.KEY_PPAGE, curses.KEY_NPAGE, curses.KEY_HOME, curses.KEY_END):
            if not shown:
                continue
            page = max(1, screen.getmaxyx()[0] - 5)
            if key == curses.KEY_PPAGE:
                position = max(0, position - page)
            elif key == curses.KEY_NPAGE:
                position = min(len(shown) - 1, position + page)
            elif key == curses.KEY_HOME:
                position = 0
            else:
                position = len(shown) - 1
            row[mode] = position
            continue
        if key in (10, 13, ord(" ")) and shown:
            tool = shown[position]
            hub_details_screen(
                screen,
                tool,
                tool.get("_record")
                or managed.get(str(tool.get("id", ""))),
            )
            managed = read_hub_apps()
            installed = dpkg_installed()
            continue
        if key in (ord("i"), ord("I")) and mode == "browse" and shown:
            notify(
                screen,
                hub_install_tool(screen, shown[position]),
                title="Applications",
            )
            managed = read_hub_apps()
            installed = dpkg_installed()
            continue
        if key in (ord("e"), ord("E")) and shown:
            tool = shown[position]
            record = tool.get("_record") or managed.get(str(tool.get("id", "")))
            error = run_hub_app(screen, tool, record)
            if error:
                notify(screen, error, title="Applications", error=False)
            continue
        if key in (ord("d"), ord("D")) and mode == "installed" and shown:
            record = shown[position].get("_record") or managed.get(
                str(shown[position].get("id", ""))
            )
            if record:
                notify(
                    screen,
                    hub_uninstall_tool(screen, record),
                    title="Applications",
                )
                managed = read_hub_apps()
                installed = dpkg_installed()
            continue



