def power_action(action: str, question: str, title: str):
    def run(screen, _data) -> None:
        danger = action in ("poweroff", "reboot")
        if not confirm(screen, question, title=title, danger=danger):
            return
        # logind allows the active local seat to reboot/power off/suspend
        # without a password. Fall back to sudo only if polkit denies it.
        if run_interactive(screen, ["systemctl", action]) != 0:
            run_privileged(screen, ["systemctl", action])

    return run


def password_action(screen, _data) -> None:
    run_interactive(screen, ["passwd"])


def reset_settings_action(screen, data) -> str | None:
    if not confirm(
        screen,
        "Reset all settings?",
        title="Reset Settings",
        detail="Only preferences are reset. Files and apps are kept.",
        danger=True,
    ):
        return None
    data.clear()
    data.update(DEFAULTS)
    save_settings(data)
    # Apply the fast path once. Calling apply_live for theme, font and display
    # would queue several terminal replacements and output runs for the same
    # reset.
    for name in data:
        if name in (
            "theme",
            "font_family",
            "font_size_panel",
            "font_size_hdmi",
            "display",
        ):
            continue
        apply_live(data, name)
    apply_theme(data["theme"])
    reload_foot()
    request_output_apply()
    try:
        keys = keys_module()
        keys.clear_all_overrides()
        keys.apply_tmux()
    except FileNotFoundError:
        pass
    reload_keyboard_layout(screen)
    return "Settings reset"


