def read_layouts() -> tuple:
    """Read layout codes and labels from xkb-data's evdev.lst."""
    layouts = []
    seen = set()
    try:
        with open(XKB_LAYOUTS_FILE, "r", encoding="utf-8") as handle:
            in_layout = False
            for raw in handle:
                line = raw.strip()
                if line.startswith("!"):
                    in_layout = line == "! layout"
                    continue
                if not in_layout or not line:
                    continue
                parts = line.split(None, 1)
                if len(parts) != 2:
                    continue
                code, label = parts[0].strip(), parts[1].strip()
                # "custom" is not a ckbcomp layout.
                if code == "custom" or not re.match(r"^[a-z][a-z0-9_]*$", code):
                    continue
                if code in seen:
                    continue
                seen.add(code)
                layouts.append((code, label))
    except OSError:
        return FALLBACK_LAYOUTS
    if not layouts:
        return FALLBACK_LAYOUTS
    labels = dict(layouts)
    preferred = [
        (code, labels[code]) for code in PREFERRED_LAYOUTS if code in labels
    ]
    rest = [item for item in layouts if item[0] not in PREFERRED_LAYOUTS]
    return tuple(preferred + rest)


