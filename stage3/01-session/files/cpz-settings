def set_choice_value(item: dict, data: dict, value, screen=None) -> None:
    key = item.get("key")
    if not key or data.get(key) == value:
        return
    data[key] = value
    save_settings(data)
    apply_live(data, key)
    if key in ("keyboard_layout", "keyboard_layout_active") and screen is not None:
        reload_keyboard_layout(screen)


def apply_choice(item: dict, data: dict, value, screen) -> None:
    setter = item.get("set")
    if setter:
        setter(data, value, screen)
        return
    set_choice_value(item, data, value, screen)


def select_popup(screen, item: dict, data: dict):
    if not item.get("key") and not item.get("values"):
        return None
    values = item_choices(item)
    if not values:
        return None
    labels = item_choice_labels(item)
    current = item_current_choice(item, data)
    selected = values.index(current) if current in values else 0
    title = item.get("label", "Select")
    hint = "F/X move  Enter apply  Esc cancel"
    title = tr(title)
    hint = tr(hint)

    height, width = screen.getmaxyx()
    popup_height = min(max(len(values) + 6, 8), max(6, height - 2), 16)
    longest = max(
        text_width(str(labels.get(value, value))) for value in values
    )
    popup_width = min(
        max(
            longest + 8,
            text_width(title) + 6,
            text_width(hint) + 2 * MODAL_TEXT_COLUMN,
            20,
        ),
        max(20, width - 2),
    )
    top = max(0, (height - popup_height) // 2)
    left = max(0, (width - popup_width) // 2)
    try:
        popup = curses.newwin(popup_height, popup_width, top, left)
    except curses.error:
        return None
    popup.keypad(True)

    visible = max(1, popup_height - 5)
    content_cols = max(0, popup_width - 2 * MODAL_TEXT_COLUMN)
    first = 0
    if selected >= visible:
        first = selected - visible + 1
    first = max(0, min(first, max(0, len(values) - visible)))

    while True:
        draw_modal_frame(popup, title, hint)
        for offset, value in enumerate(values[first : first + visible]):
            row = first + offset
            label = tr(str(labels.get(value, value)))
            text = f"{'>' if row == selected else ' '} {label}"
            attr = curses.A_REVERSE if row == selected else 0
            put(
                popup,
                2 + offset,
                MODAL_TEXT_COLUMN,
                text_pad(text, content_cols),
                attr,
            )
        popup.refresh()

        key = popup.getch()
        if key == curses.KEY_MOUSE:
            event = read_mouse()
            if event is None:
                continue
            _mx, my, bstate = event
            delta = mouse_wheel_delta(bstate)
            if delta:
                selected = max(0, min(len(values) - 1, selected + delta))
                if selected < first:
                    first = selected
                elif selected >= first + visible:
                    first = selected - visible + 1
                first = max(0, min(first, max(0, len(values) - visible)))
                continue
            popup_top = popup.getbegyx()[0]
            local_y = my - popup_top
            if 2 <= local_y < 2 + visible:
                row = first + (local_y - 2)
                if row < len(values):
                    if bstate & (
                        curses.BUTTON1_DOUBLE_CLICKED
                        | curses.BUTTON1_TRIPLE_CLICKED
                    ):
                        selected = row
                        key = 10
                    elif bstate & (
                        curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED
                    ):
                        selected = row
                        if selected < first:
                            first = selected
                        elif selected >= first + visible:
                            first = selected - visible + 1
                        first = max(
                            0, min(first, max(0, len(values) - visible))
                        )
                        continue
                    else:
                        continue
                else:
                    continue
            else:
                continue
        if key in (*NAV_LEFT, ord("q"), ord("Q"), 27):
            del popup
            return None
        if key in NAV_UP:
            selected = (selected - 1) % len(values)
        elif key in NAV_DOWN:
            selected = (selected + 1) % len(values)
        elif key in (curses.KEY_PPAGE,):
            selected = max(0, selected - visible)
        elif key in (curses.KEY_NPAGE,):
            selected = min(len(values) - 1, selected + visible)
        elif key in (*NAV_RIGHT, ord(" "), 10, 13):
            del popup
            return values[selected]
        else:
            continue

        if selected < first:
            first = selected
        elif selected >= first + visible:
            first = selected - visible + 1
        first = max(0, min(first, max(0, len(values) - visible)))


def draw_page(
    screen,
    title: str,
    items: list,
    values: list,
    selected: int,
    data: dict,
    issues: list[str],
    is_main: bool,
    hint: str = "",
    query: str = "",
    searching: bool = False,
    searchable: bool = False,
) -> None:
    screen.erase()
    height, width = screen.getmaxyx()
    left = SCREEN_PAD
    cw = content_width(width)
    put(screen, 0, left, tr(title), curses.A_BOLD)
    if is_main and issues:
        warning = "! " + " + ".join(tr(issue) for issue in issues)
        put(
            screen,
            1,
            left,
            text_pad(text_truncate(warning, cw), cw),
            curses.A_REVERSE | curses.A_BOLD,
        )
    elif searching or query:
        put(screen, 1, left, f"/{query}" + ("_" if searching else ""))

    top, visible, first = page_geometry(selected, len(items), height)
    if not items:
        put(screen, top, left + 1, tr("No matches"))

    for offset, item in enumerate(items[first : first + visible]):
        row = first + offset
        y = top + offset
        value = values[row] if row < len(values) else item_value(item, data)
        label = item.get("label", "")
        text = (
            f"{'>' if row == selected else ' '} "
            f"{text_pad(tr(label), 16)} {tr(value)}"
        )
        attr = curses.A_REVERSE if row == selected else 0
        put(screen, y, left, text_pad(text, cw), attr)

    if first > 0:
        put(screen, 1, left + cw - 1, "^")
    if first + visible < len(items):
        put(screen, 1, left + cw - 1, "v" if first == 0 else "*")

    if hint:
        footer = tr(hint)
    else:
        kind = items[selected].get("kind") if items and selected < len(items) else "info"
        if kind in ("submenu", "action"):
            action = "Enter open"
        elif kind == "info":
            action = ""
        elif kind == "toggle":
            action = "Enter toggle"
        elif kind == "keybind":
            action = "Enter rebind"
        elif kind == "picker":
            action = "Enter list"
        elif kind == "scale":
            action = "Z/C change  Enter list"
        else:
            action = "Z/C change"
        parts = [tr("F/X move")] + ([tr(action)] if action else [])
        if searchable:
            parts.append(tr("/ filter"))
        parts.append(tr("q close") if is_main else tr("q back"))
        footer = "  ".join(parts)
    put(screen, height - 1, left, footer, hint_attr())
    screen.refresh()


def run(screen, start_page: str | None = None) -> None:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    screen.keypad(True)
    enable_mouse()

    data = load_settings()
    apply_language(data["language"])
    stack = initial_stack(start_page, data)
    items = []
    values = []
    issues = []
    query = ""
    searching = False
    dirty = True

    while True:
        request = take_request()
        if request:
            request_kind, value = request
            if request_kind == "page" and value in PAGE_TITLES:
                start_page = value
                data = load_settings()
                stack = initial_stack(value, data)
                query = ""
                searching = False
                dirty = True
            elif request_kind == "tool":
                # Applications is an action, not a page, so the catalog runs in
                # place and the user returns to the page they came from.
                trove_apps_screen(screen, value)
                data = load_settings()
                dirty = True
        page_name, selected = stack[-1]
        searchable = page_name in FILTERABLE_PAGES
        if not searchable and (query or searching):
            query = ""
            searching = False
        if dirty:
            items = page_items(page_name, data, screen)
            if not items:
                items = [{"label": "Empty", "kind": "info", "get": lambda _d: ""}]
            # Getters can shell out (nmcli, bluetoothctl, wpctl). Resolve them
            # once per page/change instead of on every keypress.
            values = [item_value(item, data) for item in items]
            issues = security_issues() if page_name == "main" else []
            dirty = False
        visible_items = filter_item_indices(items, values, query)
        shown = [items[index] for index in visible_items]
        shown_values = [values[index] for index in visible_items]
        selected = max(0, min(selected, len(shown) - 1)) if shown else 0
        stack[-1] = (page_name, selected)
        title = PAGE_TITLES.get(page_name, page_name.title())
        if len(stack) > 2:
            parent = PAGE_TITLES.get(stack[-2][0], stack[-2][0].title())
            title = f"{parent} > {title}"
        draw_page(
            screen,
            title,
            shown,
            shown_values,
            selected,
            data,
            issues,
            page_name == "main" or (start_page is not None and len(stack) == 1),
            query=query,
            searching=searching,
            searchable=searchable,
        )
        key = screen.getch()

        if key == curses.KEY_MOUSE:
            event = read_mouse()
            if event is None:
                continue
            _mx, my, bstate = event
            delta = mouse_wheel_delta(bstate)
            if delta:
                selected = max(0, min(len(shown) - 1, selected + delta))
                stack[-1] = (page_name, selected)
                continue
            top, visible, first = page_geometry(
                selected, len(shown), screen.getmaxyx()[0]
            )
            row = page_row_at(my, top, first, visible, len(shown))
            if row is None:
                continue
            if bstate & (curses.BUTTON1_DOUBLE_CLICKED | curses.BUTTON1_TRIPLE_CLICKED):
                selected = row
                stack[-1] = (page_name, selected)
                key = 10
            elif bstate & (curses.BUTTON1_CLICKED | curses.BUTTON1_PRESSED):
                stack[-1] = (page_name, row)
                continue
            else:
                continue

        if searching:
            if key == 27:
                if query:
                    query = ""
                    selected = 0
                else:
                    searching = False
                continue
            if key in (10, 13):
                # Keep the filter and return to normal navigation.
                searching = False
                continue
            if key in (curses.KEY_BACKSPACE, 8, 127):
                if query:
                    query = query[:-1]
                selected = 0
                continue
            if shown and key in (curses.KEY_UP, curses.KEY_PPAGE):
                selected = (selected - 1) % len(shown)
                continue
            if shown and key in (curses.KEY_DOWN, curses.KEY_NPAGE):
                selected = (selected + 1) % len(shown)
                continue
            if 32 <= key < 127:
                query += chr(key)
                selected = 0
                continue
            continue

        if key == ord("/") and searchable:
            searching = True
            continue

        if key == 27 and query:
            query = ""
            selected = 0
            continue

        if key in (ord("q"), ord("Q"), 27):
            if len(stack) > 1:
                stack.pop()
                data = load_settings()
                query = ""
                searching = False
                dirty = True
                continue
            return
        if shown and key in NAV_UP:
            stack[-1] = (page_name, (selected - 1) % len(shown))
            continue
        if shown and key in NAV_DOWN:
            stack[-1] = (page_name, (selected + 1) % len(shown))
            continue
        if key in (curses.KEY_PPAGE, curses.KEY_NPAGE, curses.KEY_HOME, curses.KEY_END):
            page = max(1, screen.getmaxyx()[0] - 3)
            if key == curses.KEY_PPAGE:
                selected = max(0, selected - page)
            elif key == curses.KEY_NPAGE:
                selected = min(len(shown) - 1, selected + page)
            elif key == curses.KEY_HOME:
                selected = 0
            else:
                selected = max(0, len(shown) - 1)
            stack[-1] = (page_name, selected)
            continue

        item = shown[selected] if shown else {"kind": "info"}
        kind = item.get("kind")
        if kind == "submenu":
            if key in (*NAV_RIGHT, ord(" "), 10, 13):
                data = load_settings()
                stack.append(
                    (item["page"], page_initial_index(item["page"], data))
                )
                query = ""
                searching = False
                dirty = True
            continue
        if kind == "action":
            if key in (*NAV_RIGHT, ord(" "), 10, 13):
                result = item["action"](screen, data)
                if result:
                    notify(screen, result)
                dirty = True
            continue
        if kind == "info":
            continue
        if kind == "keybind":
            if key in (*NAV_RIGHT, ord(" "), 10, 13):
                rebind_action(screen, item)
                dirty = True
            continue
        if kind in ("picker", "scale"):
            if key in (10, 13, ord(" ")):
                value = select_popup(screen, item, data)
                if value is not None:
                    apply_choice(item, data, value, screen)
                    dirty = True
            elif kind == "scale" and key in NAV_LEFT:
                item_change(item, data, -1, screen)
                dirty = True
            elif kind == "scale" and key in NAV_RIGHT:
                item_change(item, data, 1, screen)
                dirty = True
            continue
        if key in NAV_LEFT:
            item_change(item, data, -1, screen)
            dirty = True
            continue
        if key in (*NAV_RIGHT, ord(" "), 10, 13):
            item_change(item, data, 1, screen)
            dirty = True
            continue


def check_pages() -> int:
    """Structural self-test for the menu definitions (no TUI required)."""
    data = dict(DEFAULTS)
    errors = []

    main_items = page_items("main", data, None)
    if len(main_items) > 9:
        errors.append(f"main: {len(main_items)} rows do not fit the panel")

    for page in PAGE_TITLES:
        try:
            items = page_items(page, data, None)
        except Exception as error:  # noqa: BLE001 - report any page failure
            errors.append(f"{page}: {error}")
            continue
        if not items:
            errors.append(f"{page}: no items")
            continue
        labels = [item.get("label", "") for item in items]
        duplicates = sorted({label for label in labels if labels.count(label) > 1})
        if duplicates:
            errors.append(f"{page}: duplicate labels: {', '.join(duplicates)}")
        for item in items:
            target = item.get("page")
            if target and target not in PAGE_TITLES:
                errors.append(f"{page}: unknown submenu target {target}")
            kind = item.get("kind")
            label = item.get("label", "")
            if kind == "cycle":
                errors.append(
                    f"{page}: {label}: named choices use picker or scale, not cycle"
                )
            if kind in ("picker", "scale"):
                if item.get("values") is None:
                    errors.append(f"{page}: {label}: {kind} has no values")
                if kind == "picker" and not item.get("key") and not item.get("set"):
                    errors.append(
                        f"{page}: {label}: picker needs a key or a setter"
                    )
            if kind == "special" and item.get("values") is not None:
                errors.append(
                    f"{page}: {label}: special cannot hide a choice list"
                )

    if errors:
        for message in errors:
            print(f"cpz-settings: {message}", file=sys.stderr)
        return 1
    print(f"cpz-settings: {len(PAGE_TITLES)} pages OK")
    return 0


def main() -> int:
    arguments = sys.argv[1:]
    if "--check-pages" in arguments:
        return check_pages()
    if "--list-pages" in arguments:
        set_language(load_settings()["language"])
        for page, title in PAGE_TITLES.items():
            print(f"{page}\t{tr(title)}")
        return 0
    if "--list-tools" in arguments:
        print(json.dumps(list_tools_payload(), ensure_ascii=False))
        return 0
    if "--install-tool" in arguments:
        index = arguments.index("--install-tool")
        if index + 1 >= len(arguments):
            print("cpz-settings: --install-tool needs a slug", file=sys.stderr)
            return 2
        try:
            return cli_install_tool(arguments[index + 1])
        finally:
            pause_for_close()

    start_page = None
    start_tool = None
    if arguments:
        if len(arguments) == 2 and arguments[0] == "--page":
            start_page = arguments[1]
            if start_page not in PAGE_TITLES:
                print(
                    f"cpz-settings: unknown page '{start_page}'",
                    file=sys.stderr,
                )
                return 2
        elif len(arguments) == 2 and arguments[0] == "--tool":
            start_tool = arguments[1].strip()
            if not start_tool:
                print("cpz-settings: --tool needs a slug", file=sys.stderr)
                return 2
        else:
            print(
                f"cpz-settings: unknown arguments: {' '.join(arguments)}",
                file=sys.stderr,
            )
            return 2

    if not sys.stdout.isatty():
        print("cpz-settings: this is a TUI; run it from the terminal.", file=sys.stderr)
        return 1
    try:
        if start_tool:
            curses.wrapper(trove_apps_screen, start_tool)
        else:
            curses.wrapper(run, start_page)
    except KeyboardInterrupt:
        return 0
    except curses.error as error:
        print(f"cpz-settings: terminal error: {error}", file=sys.stderr)
        print(f"cpz-settings: TERM={os.environ.get('TERM', '?')}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"cpz-settings: cannot save settings: {error}", file=sys.stderr)
        print(
            "cpz-settings: ~/.config/cpz must be writable by the "
            f"logged-in user (uid {os.getuid()}, HOME={os.environ.get('HOME', '?')})",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
