# applications. Names are matched because a fresh image only has the build-time
# package-name snapshot and no apt metadata until the first apt update.
APT_LIBRARY_RE = re.compile(r"^lib[a-z0-9+.-]*[0-9][a-z0-9+.-]*$")
APT_NON_APP_SUFFIX_RE = re.compile(
    r"-(?:dev|dbg|dbgsym|doc|docs|data|common|headers|examples?|tests?|"
    r"locale|l10n|translations?|icons?|themes?|fonts?)$"
)
APT_NON_APP_PREFIXES = (
    "firmware-",
    "fonts-",
    "golang-",
    "linux-headers-",
    "linux-image-",
    "node-",
    "perl-",
    "ruby-",
    "texlive-",
)
PKG_CORE = frozenset(
    {
        "apt",
        "bash",
        "bluez",
        "cage",
        "coreutils",
        "dpkg",
        "fonts-terminus-otb",
        "foot",
        "iw",
        "ncurses-term",
        "network-manager",
        "pipewire",
        "polkitd",
        "python3",
        "rfkill",
        "sudo",
        "systemd",
        "tmux",
        "util-linux",
        "wireplumber",
    }
)


def trove_cache_path() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(
        os.path.expanduser("~"), ".cache"
    )
    return os.path.join(base, "cpz", "trove-index.json")


def trove_state_path() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state"
    )
    return os.path.join(base, "cpz", "trove-apps.json")


def trove_index_url() -> str:
    override = os.environ.get("CPZ_TROVE_INDEX_URL", "").strip()
    if override:
        return override
    try:
        with open(TROVE_INDEX_URL_FILE, "r", encoding="utf-8") as handle:
            value = handle.read().strip()
            if value:
                return value
    except OSError:
        pass
    return TROVE_INDEX_DEFAULT_URL


def read_json_file(path: str):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def valid_trove_index(data) -> bool:
    return (
        isinstance(data, dict)
        and data.get("schema") == 1
        and isinstance(data.get("tools"), list)
    )


def normalize_trove_tool(raw) -> dict[str, Any] | None:
    if not isinstance(raw, dict):
        return None
    slug = str(raw.get("slug", "")).strip()
    name = str(raw.get("name", "")).strip() or slug
    if not slug or not name:
        return None
    categories = []
    for item in raw.get("categories") or []:
        value = str(item).strip()
        if value and value not in categories:
            categories.append(value)
    platforms = []
    for item in raw.get("platforms") or []:
        value = str(item).strip()
        if value and value not in platforms:
            platforms.append(value)
    install = raw.get("install")
    apt = raw.get("apt")
    return {
        "slug": slug,
        "name": name,
        "url": str(raw.get("url", "")).strip()
        or f"https://terminaltrove.com/{slug}/",
        "summary": str(raw.get("summary", "")).strip(),
        "description": str(raw.get("description", "")).strip(),
        "language": str(raw.get("language", "")).strip().lower(),
        "language_label": str(raw.get("language_label", "")).strip(),
        "categories": categories,
        "platforms": platforms,
        "install": install if isinstance(install, dict) else {},
        "apt": apt if isinstance(apt, dict) else {},
        "website": str(raw.get("website", "")).strip(),
        "source": str(raw.get("source", "")).strip(),
        "license": str(raw.get("license", "")).strip(),
        "stars": raw.get("stars") if isinstance(raw.get("stars"), int) else 0,
        "release": str(raw.get("release", "")).strip(),
    }


def load_trove_index() -> dict[str, Any]:
    empty: dict[str, Any] = {
        "schema": 1,
        "tools": [],
        "categories": [],
        "languages": [],
        "count": 0,
        "path": "",
    }
    candidates: list[tuple[str, str, dict[str, Any]]] = []
    for path in (trove_cache_path(), TROVE_INDEX_SYSTEM):
        try:
            if os.path.getsize(path) > 50 * 1024 * 1024:
                continue
        except OSError:
            continue
        data = read_json_file(path)
        if not valid_trove_index(data):
            continue
        generated = str(data.get("generated_at", ""))
        candidates.append((generated, path, data))
    if not candidates:
        return empty
    for _generated, path, data in sorted(
        candidates, key=lambda item: item[0], reverse=True
    ):
        tools = []
        for raw in data["tools"]:
            tool = normalize_trove_tool(raw)
            if tool:
                tools.append(tool)
        if not tools:
            continue
        data["tools"] = tools
        data["path"] = path
        data["count"] = len(tools)
        return data
    return empty


def download_trove_index() -> tuple[bool, str]:
    url = trove_index_url()
    request = urllib.request.Request(
        url, headers={"User-Agent": "cpz-settings/1"}
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read(20 * 1024 * 1024 + 1)
    except (urllib.error.URLError, OSError, ValueError) as error:
        return False, catalog_error(error_line(str(error)) or "network error")
    if len(raw) > 20 * 1024 * 1024:
        return False, catalog_error("index is too large")
    if raw[:2] == b"\x1f\x8b":
        try:
            raw = gzip.decompress(raw)
        except OSError:
            return False, catalog_error("bad gzip data")
    if len(raw) > 50 * 1024 * 1024:
        return False, catalog_error("index is too large")
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return False, catalog_error("invalid JSON")
    if not valid_trove_index(data):
        return False, catalog_error("unsupported index")
    if not data.get("tools"):
        return False, catalog_error("empty index")
    path = trove_cache_path()
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        temp = path + ".tmp"
        with open(temp, "wb") as handle:
            handle.write(raw)
        os.replace(temp, path)
    except OSError as error:
        return False, catalog_error(error_line(str(error)) or "cannot write cache")
    return True, tr(
        "Catalog updated: {count} tools",
        count=len(data.get("tools", [])),
    )


def catalog_error(reason: str) -> str:
    return tr("Catalog update failed: {reason}", reason=tr(reason))


def apt_command_package(command: str) -> str:
    """Return the package from a Debian/Ubuntu apt install command."""
    if not command:
        return ""
    text = re.split(r"[;&|]", command.strip(), maxsplit=1)[0].strip()
    match = re.search(
        r"(?:^|\s)(?:sudo\s+(?:-\S+\s+)*)?(?:env\s+\S+\s+)*"
        r"(?:[A-Z_][A-Z0-9_]*=\S+\s+)*apt(?:-get)?\s+"
        r"(?:install|add)\s+(.+)$",
        text,
    )
    if not match:
        return ""
    try:
        tokens = shlex.split(match.group(1))
    except ValueError:
        tokens = match.group(1).split()
    skip_next = False
    for token in tokens:
        if skip_next:
            skip_next = False
            continue
        if token.startswith("-"):
            if token in ("-t", "--target-release", "-o"):
                skip_next = True
            continue
        if "/" in token or token.startswith((".", "~")):
            return ""
        name = token.split("=", 1)[0].split(":", 1)[0]
        if APT_NAME_RE.fullmatch(name):
            return name
    return ""


def catalog_trove_apt(tool: dict[str, Any]) -> dict[str, str]:
    apt = tool.get("apt")
    if isinstance(apt, dict):
        package = str(apt.get("package", "")).strip()
        command = str(apt.get("command", "")).strip()
        if APT_NAME_RE.fullmatch(package):
            return {
                "package": package,
                "command": command or f"apt install {package}",
            }
    install = tool.get("install")
    if isinstance(install, dict):
        for platform_name in ("linux", "debian", "ubuntu"):
            entries = install.get(platform_name)
            if isinstance(entries, dict):
                for manager, command in entries.items():
                    lowered = str(manager).lower()
                    if "ubuntu" not in lowered and "debian" not in lowered:
                        continue
                    package = apt_command_package(str(command))
                    if package:
                        return {"package": package, "command": str(command)}
            elif isinstance(entries, str):
                package = apt_command_package(entries)
                if package:
                    return {"package": package, "command": entries}
    return {}


def package_from_text(value: str) -> str:
    name = re.sub(r"[^a-z0-9+.-]+", "-", value.lower()).strip("-.")
    return name if APT_NAME_RE.fullmatch(name) else ""


def apt_lists_present() -> bool:
    """True when apt has downloaded package lists."""
    try:
        with os.scandir("/var/lib/apt/lists") as entries:
            for entry in entries:
                if entry.is_file() and "Packages" in entry.name:
                    return True
    except OSError:
        return False
    return False


def apt_status(package: str) -> dict[str, str]:
    if not APT_NAME_RE.fullmatch(package):
        return {"package": package, "status": "missing", "version": ""}
    rc, out, _ = nm_run(
        ["dpkg-query", "-W", "-f=${Status}\n${Version}\n", package], timeout=10
    )
    lines = out.splitlines()
    if rc == 0 and lines and "install ok installed" in lines[0]:
        return {
            "package": package,
            "status": "installed",
            "version": lines[1] if len(lines) > 1 else "",
        }
    rc, out, _ = nm_run(["apt-cache", "policy", package], timeout=15)
    if rc == 0:
        installed = re.search(r"^\s*Installed:\s*(\S+)", out, re.MULTILINE)
        candidate = re.search(r"^\s*Candidate:\s*(\S+)", out, re.MULTILINE)
        if installed and installed.group(1) != "(none)":
            return {
                "package": package,
                "status": "installed",
                "version": installed.group(1),
            }
        if candidate and candidate.group(1) != "(none)":
            return {
                "package": package,
                "status": "available",
                "version": candidate.group(1),
            }
    return {"package": package, "status": "missing", "version": ""}


def apt_snapshot_lines(path: str):
    if path.endswith(".gz"):
        return gzip.open(path, "rt", encoding="utf-8", errors="replace")
    return open(path, "r", encoding="utf-8", errors="replace")


def trove_apt_names() -> set[str]:
    """Return every package name apt knows about, plus installed packages.

    ``apt-cache pkgnames`` is a single fast command, unlike running apt-cache
    policy once per catalog entry. dpkg-query covers packages that are
    installed but missing from the current apt lists. export-image deletes
    /var/lib/apt/lists, so the build also stores a compressed snapshot of the
    package names for offline use.
    """
    names: set[str] = set()
    for command in (
        ["apt-cache", "pkgnames"],
        ["dpkg-query", "-W", "-f=${Package}\n"],
    ):
        rc, out, _ = nm_run(command, timeout=60)
        if rc != 0:
            continue
        for line in out.splitlines():
            name = line.strip().split(":", 1)[0]
            if APT_NAME_RE.fullmatch(name):
                names.add(name)
    for path in (TROVE_APT_SNAPSHOT, TROVE_APT_SNAPSHOT_TXT):
        try:
            with apt_snapshot_lines(path) as handle:
                for line in handle:
                    name = line.strip().split(":", 1)[0]
                    if APT_NAME_RE.fullmatch(name):
                        names.add(name)
        except OSError:
            continue
    return names


def parse_apt_stanzas(text: str) -> dict[str, dict[str, str]]:
    """Parse the first apt/dpkg stanza per package.

    Only stable metadata is kept: the section, dependency lists and the short
    description. Continuation lines are dropped because the details page and
    the list only need the summary.
    """
    result: dict[str, dict[str, str]] = {}
    for block in re.split(r"\n\s*\n", text.strip()):
        fields: dict[str, str] = {}
        for line in block.splitlines():
            if line[:1].isspace():
                continue
            match = re.match(r"^([A-Za-z0-9-]+):\s*(.*)$", line)
            if not match:
                continue
            key = match.group(1).lower()
            value = match.group(2).strip()
            if key == "description":
                fields["summary"] = value
            else:
                fields[key] = value
        package = fields.get("package", "")
        if package and package not in result:
            result[package] = fields
    return result


def apt_metadata_many(packages: list[str]) -> dict[str, dict[str, str]]:
    """Return apt metadata for several packages in one or two subprocesses.

    The build-time snapshot contains package names only because export-image
    removes /var/lib/apt/lists. apt-cache provides richer metadata once the
    lists exist; dpkg-query covers installed packages on a fresh image.
    """
    wanted = [
        package
        for package in dict.fromkeys(packages)
        if APT_NAME_RE.fullmatch(package)
    ]
    missing = [package for package in wanted if package not in _TROVE_APT_METADATA]
    if missing:
        timeout = max(10, min(30, len(missing) * 2))
        rc, out, _ = nm_run(
            ["apt-cache", "show", "--no-all-versions", *missing],
            timeout=timeout,
        )
        if rc != 0 or not out:
            rc, out, _ = nm_run(
                ["apt-cache", "show", *missing],
                timeout=timeout,
            )
        if out:
            _TROVE_APT_METADATA.update(parse_apt_stanzas(out))
        still_missing = [
            package
            for package in missing
            if package not in _TROVE_APT_METADATA
        ]
        if still_missing:
            rc, out, _ = nm_run(
                [
                    "dpkg-query",
                    "-W",
                    "-f=${Package}\t${Section}\t${Depends}\n",
                    *still_missing,
                ],
                timeout=10,
            )
            if out:
                for line in out.splitlines():
                    parts = line.split("\t")
                    package = parts[0].strip().split(":", 1)[0]
                    if not APT_NAME_RE.fullmatch(package):
                        continue
                    _TROVE_APT_METADATA[package] = {
                        "package": package,
                        "section": parts[1].strip() if len(parts) > 1 else "",
                        "depends": parts[2].strip() if len(parts) > 2 else "",
                        "summary": "",
                    }
    return {
        package: _TROVE_APT_METADATA.get(package, {})
        for package in wanted
    }


def apt_metadata(package: str) -> dict[str, str]:
    return apt_metadata_many([package]).get(package, {})


def apt_looks_like_app(package: str) -> bool:
    """Reject packages that are clearly libraries, docs or build artifacts."""
    lowered = package.lower()
    if APT_LIBRARY_RE.fullmatch(lowered):
        return False
    if APT_NON_APP_SUFFIX_RE.search(lowered):
        return False
    return not lowered.startswith(APT_NON_APP_PREFIXES)


def apt_search_tools(
    query: str,
    apt_names: set[str],
    skip_packages: set[str] | None = None,
    limit: int = 30,
    candidates: list[str] | None = None,
) -> list[dict[str, Any]]:
    """Find ordinary apt packages that are not in the Terminal Trove catalog.

    Filtering happens against the package-name snapshot, so search works on a
    fresh image after export-image deletes /var/lib/apt/lists. Metadata is only
    requested for the short list that is about to be displayed.

    ``candidates`` is the precomputed app-like subset of ``apt_names``; the
    screen builds it once because the full snapshot is large.
    """
    words = [word.lower() for word in query.split() if word]
    if not words or len(query.strip()) < 2 or not apt_names:
        return []
    if candidates is None:
        candidates = [
            name for name in apt_names if apt_looks_like_app(name)
        ]
    skip = {package.lower() for package in (skip_packages or set())}
    matches = []
    for name in candidates:
        lowered = name.lower()
        if lowered in skip or not apt_looks_like_app(lowered):
            continue
        if all(word in lowered for word in words):
            matches.append(name)
    matches.sort(
        key=lambda name: (
            not name.lower().startswith(words[0]),
            len(name),
            name.lower(),
        )
    )
    matches = matches[: max(1, limit)]
    metadata = apt_metadata_many(matches)
    tools = []
    for package in matches:
        fields = metadata.get(package, {})
        tools.append(
            {
                "slug": package,
                "name": package,
                "summary": str(fields.get("summary", "")).strip(),
                "description": "",
                "language": "",
                "language_label": "",
                "categories": [],
                "platforms": ["linux"],
                "install": {},
                "apt": {
                    "command": f"apt install {package}",
                    "package": package,
                },
                "website": "",
                "source": "",
                "license": "",
                "stars": 0,
                "release": "",
                "_package": package,
                "_apt_search": True,
            }
        )
    return tools


def package_desktop_files(package: str) -> list[str]:
    """Return .desktop launchers shipped by an installed package."""
    if not package or not APT_NAME_RE.fullmatch(package):
        return []
    if not shutil.which("dpkg"):
        return []
    rc, out, _ = nm_run(["dpkg", "-L", package], timeout=10)
    if rc != 0:
        return []
    return [
        path.strip()
        for path in out.splitlines()
        if path.strip().startswith("/usr/share/applications/")
        and path.strip().endswith(".desktop")
    ]


def trove_gui_signals(
    tool: dict[str, Any], apt: dict[str, str]
) -> list[str]:
    """Return human-readable hints that an app is not CLI/TUI.

    This is deliberately a heuristic, not a gate: CPZ can run graphical apps
    through cage, but a desktop package usually needs integration that the
    device does not provide. The details page shows the hints before install.
    """
    package = str(tool.get("_package") or apt.get("package", "")).strip()
    if not package or not APT_NAME_RE.fullmatch(package):
        return []
    fields = apt_metadata(package)
    signals = []
    section = str(fields.get("section", "")).strip().lower()
    if section in GUI_SECTIONS:
        signals.append(tr("apt section: {section}", section=section))
    dependencies = " ".join(
        str(fields.get(key, ""))
        for key in ("depends", "pre-depends", "recommends")
    ).lower()
    for marker in GUI_DEPENDENCY_MARKERS:
        if marker in dependencies:
            signals.append(tr("depends on {library}", library=marker))
            break
    if package_desktop_files(package):
        signals.append(tr("installs a desktop launcher"))
    categories = {
        str(category).strip().lower()
        for category in tool.get("categories", [])
    }
    if categories & {"desktop", "gui"}:
        signals.append(tr("catalog category: {category}", category="GUI"))
    return list(dict.fromkeys(signals))


def trove_tool_from_record(
    record: dict[str, Any], tool: dict[str, Any] | None = None
) -> dict[str, Any]:
    """Build a catalog-shaped tool for a managed app missing from the index."""
    package = str(record.get("package", "")).strip()
    slug = str(record.get("slug", "")).strip() or package
    data = dict(tool or {})
    data.setdefault("slug", slug)
    data.setdefault("name", str(record.get("name", "")).strip() or slug)
    data.setdefault("summary", tr("Managed apt package"))
    data.setdefault("description", "")
    data.setdefault("language", "")
    data.setdefault("language_label", "")
    data.setdefault("categories", [])
    data.setdefault("platforms", ["linux"])
    data.setdefault("install", {})
    existing_apt = data.get("apt")
    if package and not (
        isinstance(existing_apt, dict) and existing_apt.get("package")
    ):
        data["apt"] = {
            "command": f"apt install {package}",
            "package": package,
        }
    data.setdefault("website", "")
    data.setdefault("source", "")
    data.setdefault("license", "")
    data.setdefault("stars", 0)
    data.setdefault("release", "")
    data["_record"] = record
    data["_package"] = package
    return data


def trove_tool_apt_supported(
    tool: dict[str, Any], apt_names: set[str]
) -> bool:
    """True when the tool has a package name present in apt."""
    if not apt_names:
        return False
    catalog = catalog_trove_apt(tool)
    if catalog:
        return catalog["package"] in apt_names
    for value in (tool.get("slug", ""), tool.get("name", "")):
        package = package_from_text(str(value))
        if package and package in apt_names:
            return True
    return False


def resolve_trove_apt(
    tool: dict[str, Any], apt_names: set[str] | None = None
) -> dict[str, str]:
    """Find the apt package for a catalog tool, if one exists.

    The catalog's Debian/Ubuntu command is authoritative. Only when the index
    has no apt command do we try the tool slug and name, which catches packages
    such as lazygit that Terminal Trove lists without an Ubuntu/Debian cell.

    ``apt_names`` is the offline package-name snapshot. It lets a fresh image
    report a package as available even though export-image removed
    /var/lib/apt/lists; install runs apt-get update before using it.
    """
    catalog = catalog_trove_apt(tool)
    candidates: list[tuple[str, str]] = []
    if catalog:
        candidates.append((catalog["package"], "catalog"))
    else:
        for value, source in (
            (str(tool.get("slug", "")), "slug"),
            (str(tool.get("name", "")), "name"),
        ):
            package = package_from_text(value)
            if package and all(package != item[0] for item in candidates):
                candidates.append((package, source))
    for package, source in candidates:
        status = apt_status(package)
        if status["status"] != "missing":
            return {**status, "source": source}
        if apt_names and package in apt_names and not apt_lists_present():
            return {
                "package": package,
                "status": "available",
                "version": "",
                "source": source,
                "needs_update": "1",
            }
    return {
        "package": candidates[0][0] if candidates else "",
        "status": "missing",
        "version": "",
        "source": candidates[0][1] if candidates else "",
    }


def trove_install_commands(tool: dict[str, Any]) -> list[tuple[str, str]]:
    install = tool.get("install")
    if not isinstance(install, dict):
        return []
    commands: list[tuple[str, str]] = []
    for platform_name, entries in install.items():
        if isinstance(entries, dict):
            for manager, command in entries.items():
                if str(command).strip():
                    commands.append(
                        (f"{platform_name} / {manager}", str(command).strip())
                    )
        elif isinstance(entries, str) and entries.strip():
            commands.append((str(platform_name), entries.strip()))
    commands.sort(key=lambda item: (0 if "linux" in item[0].lower() else 1, item[0]))
    return commands


def read_trove_apps() -> dict[str, dict[str, Any]]:
    data = read_json_file(trove_state_path())
    raw_apps = data.get("apps") if isinstance(data, dict) else None
    apps: dict[str, dict[str, Any]] = {}
    if not isinstance(raw_apps, list):
        return apps
    for raw in raw_apps:
        if not isinstance(raw, dict):
            continue
        slug = str(raw.get("slug", "")).strip()
        package = str(raw.get("package", "")).strip()
        if not slug or not APT_NAME_RE.fullmatch(package):
            continue
        apps[slug] = {
            "slug": slug,
            "name": str(raw.get("name", "")).strip() or slug,
            "package": package,
            "version": str(raw.get("version", "")).strip(),
            "installed_at": str(raw.get("installed_at", "")).strip(),
            "install_command": str(raw.get("install_command", "")).strip(),
            "uninstall_command": str(raw.get("uninstall_command", "")).strip(),
        }
    return apps


def write_trove_apps(apps: dict[str, dict[str, Any]]) -> None:
    path = trove_state_path()
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    payload = {
        "version": 1,
        "updated_at": datetime.now().isoformat(timespec="seconds"),
        "apps": [apps[slug] for slug in sorted(apps)],
    }
    temp = path + ".tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2)
        handle.write("\n")
    os.chmod(temp, 0o600)
    os.replace(temp, path)


def trove_haystack(tool: dict[str, Any]) -> str:
    parts = [
        str(tool.get("name", "")),
        str(tool.get("slug", "")),
        str(tool.get("summary", "")),
        str(tool.get("language", "")),
        str(tool.get("language_label", "")),
        str(tool.get("_package", "")),
    ]
    parts.extend(str(item) for item in tool.get("categories", []))
    parts.extend(str(item) for item in tool.get("platforms", []))
    apt = tool.get("apt")
    if isinstance(apt, dict):
        parts.append(str(apt.get("package", "")))
    return " ".join(parts).lower()


def trove_matches(tool: dict[str, Any], query: str) -> bool:
    words = [word for word in query.lower().split() if word]
    if not words:
        return True
    haystack = trove_haystack(tool)
    return all(word in haystack for word in words)


def filter_trove_tools(
    tools: list[dict[str, Any]],
    query: str = "",
    category: str = "",
    language: str = "",
    apt_names: set[str] | None = None,
) -> list[dict[str, Any]]:
    selected = []
    for tool in tools:
        if category and category not in tool.get("categories", []):
            continue
        if language and language != tool.get("language", ""):
            continue
        if apt_names is not None and not trove_tool_apt_supported(tool, apt_names):
            continue
        if not trove_matches(tool, query):
            continue
        selected.append(tool)
    return selected


def trove_category_options(index: dict[str, Any]) -> list[tuple[str, str, int]]:
    options = [("", "All categories", 0)]
