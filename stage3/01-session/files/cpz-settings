def nm_env() -> dict:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    return env


def nm_run(args, timeout: int = 30):
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=nm_env(),
            check=False,
        )
        return result.returncode, result.stdout.strip(), result.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, "", str(error)


def wifi_summary() -> str:
    if not shutil.which("nmcli"):
        return "no nmcli"
    rc, out, _ = nm_run(["nmcli", "-t", "-f", "WIFI", "general"])
    if rc == 0 and out.startswith("WIFI:"):
        if out.split(":", 1)[1] != "enabled":
            return "Off"
    for device in nm_devices():
        if device["type"] == "wifi":
            if device["state"] == "connected":
                return device["connection"] or "connected"
            return device["state"] or "Off"
    return "no adapter"


def open_network_tui() -> str:
    if not shutil.which("nmtui"):
        return "nmtui is not installed"
    # The image writes WirelessEnabled=false until a country is configured;
    # enable the radio before opening the NetworkManager TUI.
    nm_run(["nmcli", "radio", "wifi", "on"], timeout=15)

    # Run nmtui in a popup so its alternate-screen/terminal-mode changes do not
    # leak into the Settings pane or trigger a console/tmux resize.
    if os.environ.get("TMUX") and shutil.which("tmux"):
        result = subprocess.call(
            [
                "tmux",
                "display-popup",
                "-E",
                "-w",
                "100%",
                "-h",
                "100%",
                "nmtui",
            ],
            env=nm_env(),
        )
        return "" if result == 0 else "nmtui exited with an error"

    curses.def_prog_mode()
    curses.endwin()
    try:
        subprocess.call(["nmtui"], env=nm_env())
    except OSError as error:
        return str(error).splitlines()[0]
    finally:
        curses.reset_prog_mode()
        try:
            curses.curs_set(0)
        except curses.error:
            pass
    return ""


ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def clean_output(text: str) -> str:
    return ANSI_RE.sub("", text or "").strip()


def first_line(text: str) -> str:
    for line in clean_output(text).splitlines():
        line = line.strip()
        if line:
            return line
    return ""


def error_line(text: str) -> str:
    lines = [line.strip() for line in clean_output(text).splitlines() if line.strip()]
    for line in lines:
        low = line.lower()
        if any(
            word in low
            for word in ("fail", "error", "not available", "not authorized", "denied")
        ):
            return line
    return lines[-1] if lines else ""


def bt_env() -> dict:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    env["NO_COLOR"] = "1"
    return env


def bt_run(args, timeout: int = 20):
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=bt_env(),
            check=False,
        )
        return (
            result.returncode,
            clean_output(result.stdout),
            clean_output(result.stderr),
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, "", clean_output(str(error))


def bt_adapter() -> dict:
    if not shutil.which("bluetoothctl"):
        return {"name": "", "mac": "", "powered": False, "error": "no bluetoothctl"}
    rc, out, err = bt_run(["bluetoothctl", "show"], timeout=6)
    mac = ""
    name = ""
    powered = False
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("Controller "):
            parts = line.split()
            if len(parts) > 1:
                mac = parts[1]
        elif line.startswith("Name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("Alias:") and not name:
            name = line.split(":", 1)[1].strip()
        elif line.startswith("Powered:"):
            powered = line.split(":", 1)[1].strip().lower() == "yes"
    if not mac:
        return {
            "name": "",
            "mac": "",
            "powered": False,
            "error": first_line(err or out) or "no adapter",
        }
    return {"name": name or mac, "mac": mac, "powered": powered, "error": ""}


def bt_device_lines(command: str) -> list[tuple[str, str]]:
    """Return (mac, name) from `bluetoothctl devices [command]`."""
    rc, out, _ = bt_run(["bluetoothctl", "devices"] + command.split(), timeout=6)
    if rc != 0:
        return []
    devices = []
    for line in out.splitlines():
        if not line.startswith("Device "):
            continue
        rest = line[len("Device ") :].strip()
        mac, _, name = rest.partition(" ")
        mac = mac.strip()
        if mac:
            devices.append((mac, name.strip()))
    return devices


def bt_devices() -> list[dict]:
    if not shutil.which("bluetoothctl"):
        return []
    # `devices`, `devices Connected` and `devices Paired` are three cheap
    # calls. The previous implementation ran `bluetoothctl info` once per
    # device, so the Settings page could block for seconds on a busy adapter.
    named = dict(bt_device_lines(""))
    if not named:
        return []
    connected = {mac for mac, _name in bt_device_lines("Connected")}
    paired = {mac for mac, _name in bt_device_lines("Paired")}
    devices = [
        {
            "mac": mac,
            "name": name or mac,
            "paired": mac in paired,
            "connected": mac in connected,
        }
        for mac, name in named.items()
    ]
    devices.sort(
        key=lambda device: (
            not device["connected"],
            not device["paired"],
            str(device["name"]).lower(),
        )
    )
    return devices


def bt_scan(seconds: int = 6) -> str:
    rc, out, err = bt_run(
        ["bluetoothctl", "--timeout", str(seconds), "scan", "on"],
        timeout=seconds + 8,
    )
    if rc != 0:
        return error_line(err or out) or "scan failed"
    return ""


def bt_power(on: bool) -> str:
    rc, out, err = bt_run(
        ["bluetoothctl", "power", "on" if on else "off"], timeout=10
    )
    if rc != 0:
        return error_line(err or out) or "power failed"
    return ""


def bt_set_power(screen, on: bool) -> str:
    result = bt_power(on)
    if not result:
        return ""
    # A normal user may lack rfkill/BlueZ permission. Fall back to a single
    # sudo prompt, unblocking the radio first when enabling.
    if on:
        run_privileged(screen, ["rfkill", "unblock", "bluetooth"])
    rc = run_privileged(
        screen, ["bluetoothctl", "power", "on" if on else "off"]
    )
    if rc == 0:
        return ""
    return result or "power change failed"


def bt_connect(device: dict) -> str:
    rc, out, err = bt_run(
        ["bluetoothctl", "connect", device["mac"]], timeout=40
    )
    if rc != 0 or "fail" in (out + err).lower():
        return error_line(err or out) or "connect failed"
    return "connected"


def bt_disconnect(device: dict) -> str:
    rc, out, err = bt_run(
        ["bluetoothctl", "disconnect", device["mac"]], timeout=20
    )
    if rc != 0 or "fail" in (out + err).lower():
        return error_line(err or out) or "disconnect failed"
    return "disconnected"


def bt_pair_connect(device: dict) -> str:
    mac = device["mac"]
    if not device["paired"]:
        rc, out, err = bt_run(["bluetoothctl", "pair", mac], timeout=60)
        text = (out + "\n" + err).lower()
        if rc != 0 or "failed" in text or "not available" in text:
            return error_line(err or out) or "pairing failed"
        bt_run(["bluetoothctl", "trust", mac], timeout=10)
    return bt_connect(device)


def bluetooth_summary() -> str:
    if not shutil.which("bluetoothctl"):
        return "no bluetoothctl"
    adapter = bt_adapter()
    if adapter["error"]:
        return "no adapter" if "no adapter" in adapter["error"].lower() else "unavailable"
    if not adapter["powered"]:
        return "Off"
    devices = bt_devices()
    connected = [device["name"] for device in devices if device["connected"]]
    if connected:
        return connected[0]
    paired = sum(1 for device in devices if device["paired"])
    if paired:
        return f"{paired} paired"
    return "On"


def draw_bluetooth(screen, adapter: dict, devices: list, selected: int, notice: str = "") -> None:
    screen.erase()
    height, width = screen.getmaxyx()

    put(screen, 0, 0, " Bluetooth", curses.A_BOLD)
    put(screen, 1, 0, "-" * max(0, width - 1))

    if notice:
        put(screen, 2, 0, f" {notice}")
    elif adapter["error"]:
        put(screen, 2, 0, f" {adapter['error']}")
    else:
        state = "On" if adapter["powered"] else "Off"
        put(screen, 2, 0, f" {adapter['name']}: {state}")

    items = ["power", "scan"] + devices
    top = 3
    for index, item in enumerate(items):
        y = top + index
        if y >= height - 3:
            break
        if item == "power":
            mark = " "
            label = f"Power: {'On' if adapter['powered'] else 'Off'}"
        elif item == "scan":
            mark = " "
            label = "Scan for Devices"
        else:
            mark = "*" if item["connected"] else ("+" if item["paired"] else " ")
            label = item["name"]
        text = f"{'>' if index == selected else ' '} {mark} {label}"
        attr = curses.A_REVERSE if index == selected else 0
        put(screen, y, 0, text.ljust(max(0, width - 1)), attr)

    put(screen, height - 3, 0, " Up/Down move  Enter toggle/scan/pair")
    put(screen, height - 2, 0, " r rescan  p power  d disconnect  q back")
    screen.refresh()


def bluetooth_screen(screen) -> None:
    adapter = bt_adapter()
    devices = bt_devices()
    selected = 0
    notice = ""

    while True:
        draw_bluetooth(screen, adapter, devices, selected, notice)
        key = screen.getch()
        notice = ""
        count = 2 + len(devices)

        if key in (ord("q"), ord("Q"), 27):
            return
        if key in NAV_UP:
            selected = (selected - 1) % count
            continue
        if key in NAV_DOWN:
            selected = (selected + 1) % count
            continue
        if key in (ord("r"), ord("R")):
            draw_bluetooth(screen, adapter, devices, selected, "Scanning...")
            notice = bt_scan()
            adapter = bt_adapter()
            devices = bt_devices()
            selected = min(selected, 1 + len(devices))
            continue
        if key in (ord("p"), ord("P")):
            notice = bt_set_power(screen, not adapter["powered"])
            adapter = bt_adapter()
            devices = bt_devices()
            selected = min(selected, 1 + len(devices))
            continue
        if key in (ord("d"), ord("D")) and selected > 1:
            device = devices[selected - 2]
            notice = bt_disconnect(device) if device["connected"] else "not connected"
            adapter = bt_adapter()
            devices = bt_devices()
            selected = min(selected, 1 + len(devices))
            continue
        if key in (*NAV_LEFT, *NAV_RIGHT, ord(" "), 10, 13):
            if selected == 0:
                notice = bt_set_power(screen, not adapter["powered"])
            elif selected == 1:
                draw_bluetooth(screen, adapter, devices, selected, "Scanning...")
                notice = bt_scan()
            else:
                device = devices[selected - 2]
                if device["connected"]:
                    notice = bt_disconnect(device)
                elif device["paired"]:
                    notice = bt_connect(device)
                else:
                    notice = bt_pair_connect(device)
            adapter = bt_adapter()
            devices = bt_devices()
            selected = min(selected, 1 + len(devices))
            continue


def put(screen, y: int, x: int, text: str, attr: int = 0) -> None:
    height, width = screen.getmaxyx()
    if y < 0 or y >= height or x < 0 or x >= width:
        return
    try:
        screen.addstr(y, x, text[: max(0, width - x - 1)], attr)
    except curses.error:
        pass


def item_value(item: dict, data: dict) -> str:
    getter = item.get("get")
    if getter:
        try:
            return str(getter(data))
        except Exception:
            return "?"
    key = item.get("key")
    if not key:
        return ""
    kind = item.get("kind")
    if kind == "cycle":
        values = item.get("values")
        if callable(values):
            values = values()
        values = tuple(values or ())
        labels = item.get("labels") or {}
        current = data.get(key)
        return labels.get(current, str(current))
    return value_text(data, key)


def item_change(item: dict, data: dict, step: int, screen) -> None:
    if item.get("change"):
        item["change"](data, step, screen)
        return
    key = item.get("key")
    if not key:
        return
    if item.get("kind") == "toggle":
        data[key] = 0 if data[key] else 1
    elif item.get("kind") == "cycle":
        values = item.get("values")
        if callable(values):
            values = values()
        values = tuple(values or ())
        current = data.get(key)
        index = values.index(current) if current in values else 0
        data[key] = values[(index + step) % len(values)]
    else:
        return
    save_settings(data)
    apply_live(data, key)
    if key == "keyboard_layout_active":
        reload_keyboard_layout(screen)


def sound_volume_text(kind: str) -> str:
    percent, muted = wpctl_status(kind)
    if percent is None:
        return "unavailable"
    return f"{percent}%" + (" muted" if muted else "")


def sound_volume_change(kind: str, step: int) -> None:
    percent, _muted = wpctl_status(kind)
    if percent is None:
        return
    wpctl_set_volume(kind, percent + step * 5)


def sound_mute_text(kind: str) -> str:
    percent, muted = wpctl_status(kind)
    if percent is None:
        return "unavailable"
    return "On" if muted else "Off"


def sound_device_text(kind: str) -> str:
    nodes = wpctl_nodes(kind.capitalize())
    if not nodes:
        return "unavailable"
    for _node_id, name, default in nodes:
        if default:
            return name
    return nodes[0][1]


def sound_device_change(kind: str, step: int) -> None:
    nodes = wpctl_nodes(kind.capitalize())
    if not nodes:
        return
    current = 0
    for index, (_node_id, _name, default) in enumerate(nodes):
        if default:
            current = index
            break
    node_id = nodes[(current + step) % len(nodes)][0]
    wpctl_set_default(kind.capitalize(), node_id)


def hdmi_status_text() -> str:
    for path in glob.glob("/sys/class/drm/card*-HDMI-A-*/status"):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                return handle.read().strip()
        except OSError:
            continue
    return "no HDMI"


def hdmi_edid_size() -> int:
    size = 0
    for path in glob.glob("/sys/class/drm/card*-HDMI-A-*/edid"):
        try:
            size = max(size, os.path.getsize(path))
        except OSError:
            continue
    return size


def hdmi_pinned() -> bool:
    """True when cmdline.txt pins a real HDMI mode (video=HDMI-A-N:WxH@R)."""
    try:
        with open("/proc/cmdline", encoding="utf-8") as fh:
            tokens = fh.read().split()
    except OSError:
        return False
    for token in tokens:
        if not token.startswith("video=HDMI-A-"):
            continue
        _, _, mode = token.partition(":")
        if "x" in mode:
            return True
    return False


def hdmi_ready() -> bool:
    return hdmi_status_text() == "connected" and (
        hdmi_edid_size() >= 128 or hdmi_pinned()
    )


def active_output_text(data: dict) -> str:
    # Mirrors the policy in cpz-kmscon-output.
    connected = hdmi_status_text() == "connected"
    mode = data.get("display", "auto")
    if mode == "panel":
        return "CPZ panel (HDMI mirrors)"
    if mode == "hdmi":
        return "HDMI" if connected else "CPZ panel (no HDMI)"
    if hdmi_ready():
        return "HDMI (panel off)"
    if connected:
        return "CPZ panel (HDMI has no EDID)"
    return "CPZ panel"


def autologin_status() -> str:
    path = "/etc/systemd/system/multi-user.target.wants/kmsconvt@tty1.service"
    return "enabled (kmscon)" if os.path.exists(path) else "disabled"


def disk_info(path: str) -> str:
    try:
        usage = shutil.disk_usage(path)
    except OSError:
        return "n/a"
    total = usage.total // (1024**3)
    free = usage.free // (1024**3)
    return f"{free}G free / {total}G"


def event_sysfs(event: str) -> str:
    return f"/sys/class/input/{os.path.basename(event)}"


def typing_keyboard(event: str) -> bool:
    """True when the event node has udev's full-keyboard key mask."""
    try:
        with open(
            f"{event_sysfs(event)}/device/capabilities/key",
            "r",
            encoding="utf-8",
        ) as handle:
            words = handle.read().split()
    except OSError:
        return False
    # udev's input_id marks ID_INPUT_KEYBOARD when keycodes 1..31 (ESC, the
    # number row and Q to D) are present; that is 0xfffffffe in the low word.
    return bool(words) and words[-1].lower().endswith("fffffffe")


def usb_keyboard_present_fallback() -> bool:
    """Host fallback when cpz-keyboard-layout is not installed."""
    internal_link = "/dev/input/cardputer-zero-internal"
    internal_target = (
        os.path.realpath(internal_link) if os.path.islink(internal_link) else ""
    )
    for event in glob.glob("/dev/input/event*"):
        if internal_target and os.path.realpath(event) == internal_target:
            continue
        try:
            with open(
                f"{event_sysfs(event)}/device/id/bustype",
                "r",
                encoding="utf-8",
            ) as handle:
                bustype = handle.read().strip().lower()
        except OSError:
            continue
        # BUS_I2C: the Cardputer's TCA8418 keyboard.
        if bustype == "0018" or "/3f804000.i2c" in os.path.realpath(
            f"{event_sysfs(event)}/device"
        ):
            continue
        name = ""
        try:
            with open(
                f"{event_sysfs(event)}/device/name",
                "r",
                encoding="utf-8",
            ) as handle:
                name = handle.read().strip().lower()
        except OSError:
            pass
        if any(
            word in name
            for word in ("tca8418", "m5stack", "cardputerzero", "cardputer zero")
        ):
            continue
        if not typing_keyboard(event):
            continue
        # BUS_USB, BUS_BLUETOOTH, BUS_I8042.
        if bustype in ("0003", "0005", "0011"):
            return True
    return False


def usb_keyboard_present() -> bool:
    helper = "/usr/local/bin/cpz-keyboard-layout"
    if os.path.exists(helper):
        rc, out, _ = nm_run([helper, "--detect"], timeout=5)
        if rc == 0:
            return out.splitlines()[:1] == ["external"]
    return usb_keyboard_present_fallback()


def cpu_temperature() -> str:
    for path in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                value = int(handle.read().strip()) / 1000
            return f"{value:.1f} C"
        except (OSError, ValueError):
            continue
    return "n/a"


def memory_info() -> str:
    try:
        values = {}
        with open("/proc/meminfo", "r", encoding="utf-8") as handle:
            for line in handle:
                key, raw = line.split(":", 1)
                values[key] = int(raw.split()[0])
        total = values["MemTotal"] // 1024
        available = values["MemAvailable"] // 1024
        return f"{total - available}M used / {total}M"
    except (OSError, KeyError, ValueError):
        return "n/a"


def uptime_info() -> str:
    try:
        with open("/proc/uptime", "r", encoding="utf-8") as handle:
            seconds = int(float(handle.read().split()[0]))
    except (OSError, ValueError):
        return "n/a"
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes = seconds // 60
    if days:
        return f"{days}d {hours}h {minutes}m"
    return f"{hours}h {minutes}m"


def load_info() -> str:
    try:
        with open("/proc/loadavg", "r", encoding="utf-8") as handle:
            return " ".join(handle.read().split()[:3])
    except OSError:
        return "n/a"


