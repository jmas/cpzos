def set_cycle_value(item: dict, data: dict, value, screen=None) -> None:
    key = item.get("key")
    if not key or data.get(key) == value:
        return
    data[key] = value
    save_settings(data)
    apply_live(data, key)
    if key == "keyboard_layout_active" and screen is not None:
        reload_keyboard_layout(screen)


def select_popup(screen, item: dict, data: dict):
    key = item.get("key")
    if not key:
        return None
    values = item.get("values")
    if callable(values):
        values = values()
    values = tuple(values or ())
    if not values:
        return None
    labels = item.get("labels") or {}
    current = data.get(key)
    selected = values.index(current) if current in values else 0

    height, width = screen.getmaxyx()
    popup_height = min(max(len(values) + 4, 6), max(6, height - 2), 16)
    longest = max(len(str(labels.get(value, value))) for value in values)
    popup_width = min(
        max(longest + 8, len(item.get("label", "Select")) + 4, 20),
        max(20, width - 2),
    )
    top = max(0, (height - popup_height) // 2)
    left = max(0, (width - popup_width) // 2)
    try:
        popup = curses.newwin(popup_height, popup_width, top, left)
    except curses.error:
        return None
    popup.keypad(True)

    visible = max(1, popup_height - 3)
    first = 0
    if selected >= visible:
        first = selected - visible + 1
    first = max(0, min(first, max(0, len(values) - visible)))

    while True:
        popup.erase()
        popup.box()
        put(popup, 0, 2, f" {item.get('label', 'Select')} ")
        for offset, value in enumerate(values[first : first + visible]):
            row = first + offset
            label = str(labels.get(value, value))
            text = f"{'>' if row == selected else ' '} {label}"
            attr = curses.A_REVERSE if row == selected else 0
            put(popup, 1 + offset, 1, text.ljust(max(0, popup_width - 2)), attr)
        if first > 0:
            put(popup, 0, popup_width - 2, "^")
        if first + visible < len(values):
            put(popup, popup_height - 1, popup_width - 2, "v")
        popup.refresh()

        key = popup.getch()
        if key in (*NAV_LEFT, ord("q"), ord("Q"), 27):
            del popup
            return None
        if key in NAV_UP:
            selected = (selected - 1) % len(values)
        elif key in NAV_DOWN:
            selected = (selected + 1) % len(values)
        elif key in (curses.KEY_PPAGE,):
            selected = max(0, selected - visible)
        elif key in (curses.KEY_NPAGE,):
            selected = min(len(values) - 1, selected + visible)
        elif key in (*NAV_RIGHT, ord(" "), 10, 13):
            del popup
            return values[selected]
        else:
            continue

        if selected < first:
            first = selected
        elif selected >= first + visible:
            first = selected - visible + 1
        first = max(0, min(first, max(0, len(values) - visible)))


def draw_page(screen, title: str, items: list, values: list, selected: int, data: dict, notice: str, issues: list[str], is_main: bool, hint: str = "") -> None:
    screen.erase()
    height, width = screen.getmaxyx()
    put(screen, 0, 0, f" {title}", curses.A_BOLD)
    if is_main and issues:
        warning = "! " + " + ".join(issues)
        put(
            screen,
            1,
            0,
            warning[: max(0, width - 1)].ljust(max(0, width - 1)),
            curses.A_REVERSE | curses.A_BOLD,
        )
    else:
        put(screen, 1, 0, "-" * max(0, width - 1))

    top = 2
    visible = max(1, (height - 3) - top)
    first = 0
    if selected >= visible:
        first = selected - visible + 1
    first = max(0, min(first, max(0, len(items) - visible)))

    for offset, item in enumerate(items[first : first + visible]):
        row = first + offset
        y = top + offset
        value = values[row] if row < len(values) else item_value(item, data)
        label = item.get("label", "")
        text = f"{'>' if row == selected else ' '} {label:<16} {value}"
        attr = curses.A_REVERSE if row == selected else 0
        put(screen, y, 0, text.ljust(max(0, width - 1)), attr)

    if first > 0:
        put(screen, 1, width - 2, "^")
    if first + visible < len(items):
        put(screen, 1, width - 2, "v" if first == 0 else "*")

    put(screen, height - 3, 0, " Up/Down move  PgUp/PgDn  Left/Right change")
    put(
        screen,
        height - 2,
        0,
        " Enter open/select  r refresh  q/Esc "
        + ("close" if is_main else "back"),
    )
    if notice:
        put(screen, height - 1, 0, f" {notice}")
    elif hint:
        put(screen, height - 1, 0, f" {hint}")
    screen.refresh()


def run(screen) -> None:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    screen.keypad(True)

    data = load_settings()
    stack = [("main", 0)]
    notice = ""
    items = []
    values = []
    issues = []
    dirty = True

    while True:
        page_name, selected = stack[-1]
        if dirty:
            items = page_items(page_name, data, screen)
            if not items:
                items = [{"label": "Empty", "kind": "info", "get": lambda _d: ""}]
            # Getters can shell out (nmcli, bluetoothctl, wpctl). Resolve them
            # once per page/change instead of on every keypress.
            values = [item_value(item, data) for item in items]
            issues = security_issues() if page_name == "main" else []
            dirty = False
        selected = max(0, min(selected, len(items) - 1))
        stack[-1] = (page_name, selected)
        title = PAGE_TITLES.get(page_name, page_name.title())
        if len(stack) > 2:
            parent = PAGE_TITLES.get(stack[-2][0], stack[-2][0].title())
            title = f"{parent} > {title}"
        draw_page(
            screen,
            title,
            items,
            values,
            selected,
            data,
            notice,
            issues,
            page_name == "main",
            PAGE_HINTS.get(page_name, ""),
        )
        key = screen.getch()
        notice = ""

        if key in (ord("q"), ord("Q"), 27):
            if len(stack) > 1:
                stack.pop()
                data = load_settings()
                dirty = True
                continue
            return
        if key in (ord("r"), ord("R")):
            data = load_settings()
            dirty = True
            notice = "Settings refreshed"
            continue
        if key in NAV_UP:
            stack[-1] = (page_name, (selected - 1) % len(items))
            continue
        if key in NAV_DOWN:
            stack[-1] = (page_name, (selected + 1) % len(items))
            continue
        if key in (curses.KEY_PPAGE, curses.KEY_NPAGE, curses.KEY_HOME, curses.KEY_END):
            page = max(1, screen.getmaxyx()[0] - 5)
            if key == curses.KEY_PPAGE:
                selected = max(0, selected - page)
            elif key == curses.KEY_NPAGE:
                selected = min(len(items) - 1, selected + page)
            elif key == curses.KEY_HOME:
                selected = 0
            else:
                selected = len(items) - 1
            stack[-1] = (page_name, selected)
            continue

        item = items[selected]
        kind = item.get("kind")
        if kind == "submenu":
            if key in (*NAV_RIGHT, ord(" "), 10, 13):
                data = load_settings()
                stack.append(
                    (item["page"], page_initial_index(item["page"], data))
                )
                dirty = True
            continue
        if kind == "action":
            if key in (*NAV_RIGHT, ord(" "), 10, 13):
                result = item["action"](screen, data)
                if result:
                    notice = result
                dirty = True
            continue
        if kind == "info":
            continue
        if kind == "cycle":
            if key in (10, 13, ord(" ")):
                value = select_popup(screen, item, data)
                if value is not None:
                    set_cycle_value(item, data, value, screen)
                    dirty = True
            elif key in NAV_LEFT:
                item_change(item, data, -1, screen)
                dirty = True
            elif key in NAV_RIGHT:
                item_change(item, data, 1, screen)
                dirty = True
            continue
        if key in NAV_LEFT:
            item_change(item, data, -1, screen)
            dirty = True
            continue
        if key in (*NAV_RIGHT, ord(" "), 10, 13):
            item_change(item, data, 1, screen)
            dirty = True
            continue


def check_pages() -> int:
    """Structural self-test for the menu definitions (no TUI required)."""
    data = dict(DEFAULTS)
    errors = []

    main_items = page_items("main", data, None)
    if len(main_items) > 9:
        errors.append(f"main: {len(main_items)} rows do not fit the panel")

    for page in PAGE_TITLES:
        try:
            items = page_items(page, data, None)
        except Exception as error:  # noqa: BLE001 - report any page failure
            errors.append(f"{page}: {error}")
            continue
        if not items:
            errors.append(f"{page}: no items")
            continue
        labels = [item.get("label", "") for item in items]
        duplicates = sorted({label for label in labels if labels.count(label) > 1})
        if duplicates:
            errors.append(f"{page}: duplicate labels: {', '.join(duplicates)}")
        for item in items:
            target = item.get("page")
            if target and target not in PAGE_TITLES:
                errors.append(f"{page}: unknown submenu target {target}")

    if errors:
        for message in errors:
            print(f"cpz-settings: {message}", file=sys.stderr)
        return 1
    print(f"cpz-settings: {len(PAGE_TITLES)} pages OK")
    return 0


def main() -> int:
    if "--check-pages" in sys.argv:
        return check_pages()
    if not sys.stdout.isatty():
        print("cpz-settings: this is a TUI; run it from the terminal.", file=sys.stderr)
        return 1
    try:
        curses.wrapper(run)
    except KeyboardInterrupt:
        return 0
    except curses.error as error:
        print(f"cpz-settings: terminal error: {error}", file=sys.stderr)
        print(f"cpz-settings: TERM={os.environ.get('TERM', '?')}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"cpz-settings: cannot save settings: {error}", file=sys.stderr)
        print(
            "cpz-settings: ~/.config/cpz must be writable by the "
            f"logged-in user (uid {os.getuid()}, HOME={os.environ.get('HOME', '?')})",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
