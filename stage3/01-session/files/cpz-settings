    )
    return os.path.join(base, "cpz", "hub.refreshed")


def hub_deb_dir() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(
        os.path.expanduser("~"), ".cache"
    )
    return os.path.join(base, "cpz", "hub")


def hub_state_path() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state"
    )
    return os.path.join(base, "cpz", "hub-apps.json")


def legacy_hub_state_path() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "state"
    )
    return os.path.join(base, "cpz", "trove-apps.json")


def hub_index_url() -> str:
    override = os.environ.get("CPZ_HUB_INDEX_URL", "").strip()
    if override and override.lower() not in ("none", "off", "0"):
        return override
    try:
        with open(HUB_INDEX_URL_FILE, "r", encoding="utf-8") as handle:
            value = handle.read().strip()
            if value:
                return value
    except OSError:
        pass
    return HUB_INDEX_DEFAULT_URL


def read_json_file(path: str):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def valid_hub_index(data) -> bool:
    return (
        isinstance(data, dict)
        and data.get("schema") == 1
        and isinstance(data.get("apps"), list)
    )


def normalize_hub_app(raw) -> dict[str, Any] | None:
    if not isinstance(raw, dict):
        return None
    app_id = str(raw.get("id", raw.get("slug", ""))).strip()
    name = str(raw.get("name", "")).strip() or app_id
    package = str(raw.get("package", raw.get("apt", ""))).strip()
    if not app_id or not name or not APT_NAME_RE.fullmatch(package):
        return None
    kind = str(raw.get("kind", "apt")).strip().lower()
    if kind not in ("apt", "deb"):
        return None
    categories = []
    for item in raw.get("categories") or []:
        value = str(item).strip()
        if value and value not in categories:
            categories.append(value)
    app: dict[str, Any] = {
        "id": app_id,
        "name": name,
        "summary": str(raw.get("summary", "")).strip(),
        "kind": kind,
        "package": package,
        "categories": categories,
        "license": str(raw.get("license", "")).strip(),
        "homepage": str(raw.get("homepage", "")).strip(),
        "source": str(raw.get("source", "")).strip(),
        "source_url": str(raw.get("source_url", "")).strip(),
    }
    version = str(raw.get("version", "")).strip()
    if version:
        app["version"] = version
    command = str(raw.get("command", "")).strip()
    if command and APT_NAME_RE.fullmatch(command):
        app["command"] = command
    if kind == "deb":
        deb = raw.get("deb")
        if not isinstance(deb, dict):
            return None
        url = str(deb.get("url", "")).strip()
        sha256 = str(deb.get("sha256", "")).strip().lower()
        if not url.startswith("https://") or len(sha256) != 64:
            return None
        if any(char not in "0123456789abcdef" for char in sha256):
            return None
        app["deb"] = {"url": url, "sha256": sha256}
        size = deb.get("size")
        if isinstance(size, int) and size > 0:
            app["deb"]["size"] = size
    return app


def load_hub_index() -> dict[str, Any]:
    empty: dict[str, Any] = {
        "schema": 1,
        "apps": [],
        "generated_at": "",
        "path": "",
    }
    candidates: list[tuple[str, float, str, dict[str, Any]]] = []
    for path in (hub_cache_path(), HUB_INDEX_SYSTEM):
        try:
            if os.path.getsize(path) > HUB_INDEX_MAX_BYTES:
                continue
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        data = read_json_file(path)
        if not valid_hub_index(data):
            continue
        generated = str(data.get("generated_at", ""))
        candidates.append((generated, mtime, path, data))
    if not candidates:
        return empty
    candidates.sort(key=lambda item: (item[0], item[1]), reverse=True)
    for generated, _mtime, path, data in candidates:
        apps = []
        seen = set()
        for raw in data["apps"]:
            app = normalize_hub_app(raw)
            if app is None or app["id"] in seen:
                continue
            seen.add(app["id"])
            apps.append(app)
        if not apps:
            continue
        data["apps"] = apps
        data["path"] = path
        data["generated_at"] = generated
        return data
    return empty


def download_hub_index() -> tuple[bool, str]:
    url = hub_index_url()
    request = urllib.request.Request(
        url, headers={"User-Agent": "cpz-settings/1"}
    )
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            raw = response.read(HUB_INDEX_MAX_BYTES + 1)
    except (urllib.error.URLError, OSError, ValueError) as error:
        return False, catalog_error(error_line(str(error)) or "network error")
    if len(raw) > HUB_INDEX_MAX_BYTES:
        return False, catalog_error("index is too large")
    if raw[:2] == b"\x1f\x8b":
        try:
            raw = gzip.decompress(raw)
        except OSError:
            return False, catalog_error("bad gzip data")
    if len(raw) > HUB_INDEX_MAX_BYTES:
        return False, catalog_error("index is too large")
    try:
        data = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return False, catalog_error("invalid JSON")
    if not valid_hub_index(data) or not data.get("apps"):
        return False, catalog_error("unsupported index")
    path = hub_cache_path()
    try:
        os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
        temp = path + ".tmp"
        with open(temp, "wb") as handle:
            handle.write(raw)
        os.chmod(temp, 0o600)
        os.replace(temp, path)
    except OSError as error:
        return False, catalog_error(error_line(str(error)) or "cannot write cache")
    return True, tr(
        "Catalog updated: {count} apps",
        count=len(data.get("apps", [])),
    )


def hub_refresh_due() -> bool:
    try:
        return time.time() - os.path.getmtime(hub_refresh_stamp_path()) > HUB_REFRESH_INTERVAL
    except OSError:
        return True


def start_hub_refresh(force: bool = False):
    """Start a detached index refresh and return the process, if any.

    The caller never waits for it. The next draw reloads the cache after the
    process exits with code 0.
    """
    if not force and not hub_refresh_due():
        return None
    stamp = hub_refresh_stamp_path()
    try:
        os.makedirs(os.path.dirname(stamp), mode=0o700, exist_ok=True)
        with open(stamp, "a", encoding="utf-8"):
            pass
        os.utime(stamp, None)
    except OSError:
        pass
    try:
        return subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--refresh-hub"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
        )
    except OSError:
        return None


def catalog_error(reason: str) -> str:
    return tr("Catalog update failed: {reason}", reason=tr(reason))


def dpkg_installed() -> dict[str, str]:
    """Package name -> installed version, read once per screen/lookup."""
    try:
        result = subprocess.run(
            ["dpkg-query", "-W", "-f=${Package}\t${Version}\n"],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=20,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    if result.returncode != 0:
        return {}
    installed = {}
    for line in result.stdout.splitlines():
        if "\t" not in line:
            continue
        package, version = line.split("\t", 1)
        package = package.strip()
        if APT_NAME_RE.fullmatch(package):
            installed[package] = version.strip()
    return installed


def apt_lists_present() -> bool:
    return bool(
        glob.glob("/var/lib/apt/lists/*Packages*")
        or glob.glob("/var/lib/apt/lists/*Packages")
    )


def read_hub_apps() -> dict[str, dict[str, Any]]:
    data = read_json_file(hub_state_path())
    if data is None:
        data = read_json_file(legacy_hub_state_path())
        if data is None:
            return {}
        apps = parse_hub_state(data)
        hub = load_hub_index()
        ids = {app["id"] for app in hub["apps"]}
        packages = {app["package"] for app in hub["apps"]}
        apps = {
            slug: record
            for slug, record in apps.items()
            if slug in ids or record.get("package") in packages
        }
        if ids:
            try:
                write_hub_apps(apps)
            except OSError:
                pass
        return apps
    return parse_hub_state(data)


def parse_hub_state(data) -> dict[str, dict[str, Any]]:
    raw_apps = data.get("apps") if isinstance(data, dict) else None
    apps: dict[str, dict[str, Any]] = {}
    if not isinstance(raw_apps, list):
        return apps
    for raw in raw_apps:
        if not isinstance(raw, dict):
            continue
        slug = str(raw.get("slug", raw.get("id", ""))).strip()
        package = str(raw.get("package", "")).strip()
        if not slug or not APT_NAME_RE.fullmatch(package):
            continue
        apps[slug] = {
            "slug": slug,
            "name": str(raw.get("name", "")).strip() or slug,
            "kind": str(raw.get("kind", "apt")).strip() or "apt",
            "package": package,
            "version": str(raw.get("version", "")).strip(),
            "installed_at": str(raw.get("installed_at", "")).strip(),
            "install_command": str(raw.get("install_command", "")).strip(),
            "uninstall_command": str(raw.get("uninstall_command", "")).strip(),
        }
    return apps


def write_hub_apps(apps: dict[str, dict[str, Any]]) -> None:
    path = hub_state_path()
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    payload = {
        "schema": 1,
        "updated_at": datetime.now().isoformat(timespec="seconds"),
        "apps": [apps[slug] for slug in sorted(apps)],
    }
    temp = path + ".tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, indent=2)
        handle.write("\n")
    os.chmod(temp, 0o600)
    os.replace(temp, path)


def hub_app_by_id(app_id: str, apps: list[dict[str, Any]] | None = None) -> dict[str, Any] | None:
    app_id = app_id.strip()
    if not app_id:
        return None
    for app in apps if apps is not None else load_hub_index()["apps"]:
        if app["id"] == app_id:
            return app
    record = read_hub_apps().get(app_id)
    if record:
        return {
            "id": app_id,
            "name": record["name"],
            "summary": "",
            "kind": record["kind"],
            "package": record["package"],
            "categories": [],
            "license": "",
            "homepage": "",
            "source": "",
            "source_url": "",
            "version": record.get("version", ""),
        }
    return None


def hub_haystack(app: dict[str, Any]) -> str:
    parts = [
        str(app.get("id", "")),
        str(app.get("name", "")),
        str(app.get("package", "")),
        str(app.get("summary", "")),
    ]
    parts.extend(str(item) for item in app.get("categories") or [])
    return " ".join(parts).casefold()


def hub_matches(app: dict[str, Any], query: str) -> bool:
    words = query.casefold().split()
    if not words:
        return True
    haystack = hub_haystack(app)
    return all(word in haystack for word in words)


def filter_hub_apps(apps: list[dict[str, Any]], query: str) -> list[dict[str, Any]]:
    shown = [app for app in apps if hub_matches(app, query)]
    return sorted(shown, key=lambda app: str(app.get("name", "")).casefold())


def hub_installed_tools(
    index: dict[str, Any],
    managed: dict[str, dict[str, Any]],
    installed: dict[str, str],
    query: str,
) -> list[dict[str, Any]]:
    by_id = {app["id"]: app for app in index.get("apps", [])}
    by_package = {app["package"]: app for app in index.get("apps", [])}
    tools = []
    for slug, record in managed.items():
        app = by_id.get(slug) or by_package.get(record.get("package", ""))
        tool = dict(app or {})
        tool.update(
            {
                "id": slug,
                "slug": slug,
                "name": record.get("name") or tool.get("name", slug),
                "package": record.get("package", tool.get("package", "")),
                "kind": record.get("kind", tool.get("kind", "apt")),
                "summary": tool.get("summary", ""),
                "version": installed.get(record.get("package", ""), "")
                or record.get("version", ""),
                "_record": record,
            }
        )
        if hub_matches(tool, query):
            tools.append(tool)
    return sorted(tools, key=lambda tool: str(tool.get("name", "")).casefold())


def hub_app_status(
    app: dict[str, Any],
    managed: dict[str, dict[str, Any]],
    installed: dict[str, str],
) -> str:
    if app["id"] in managed or any(
        record.get("package") == app["package"] for record in managed.values()
    ):
        return "managed"
    if app["package"] in installed:
        return "system"
    return "available"


def hub_details_lines(
    app: dict[str, Any],
    record: dict[str, Any] | None,
    installed: dict[str, str],
    width: int,
) -> list[str]:
    status = hub_app_status(app, {app["id"]: record} if record else {}, installed)
    lines: list[str] = []
    if app.get("summary"):
        lines.extend(textwrap.wrap(str(app["summary"]), max(20, width - 1)))
        lines.append("")
    lines.append(tr("Package: {package}", package=app.get("package", "-")))
    lines.append(
        tr(
            "Kind: {kind}",
            kind=tr("Debian package")
            if app.get("kind") == "apt"
            else tr("Bundled .deb"),
        )
    )
    version = (
        installed.get(str(app.get("package", "")), "")
        or (record or {}).get("version")
        or str(app.get("version", ""))
    )
    if version:
        lines.append(tr("Version: {version}", version=version))
    status_label = {
        "managed": tr("installed (managed)"),
        "system": tr("installed (system)"),
        "available": tr("available"),
    }[status]
    lines.append(tr("Status: {status}", status=status_label))
    categories = ", ".join(str(item) for item in app.get("categories") or []) or "-"
    lines.extend(
        textwrap.wrap(
            tr("Categories: {categories}", categories=categories),
            max(20, width - 1),
        )
    )
    if app.get("license"):
        lines.append(tr("License: {license}", license=app["license"]))
    if app.get("homepage"):
        lines.extend(
            textwrap.wrap(
                tr("Homepage: {url}", url=app["homepage"]),
                max(20, width - 1),
                break_long_words=True,
            )
        )
    if app.get("source"):
        lines.extend(
            textwrap.wrap(
                tr("Source: {url}", url=app["source"]),
                max(20, width - 1),
                break_long_words=True,
            )
        )
    lines.append("")
    if record:
        lines.append(
            tr(
                "Remove: {command}",
                command=record.get("uninstall_command")
                or f"apt-get purge {app['package']}",
            )
        )
        lines.append(tr("Press d to remove this app."))
    elif status == "system":
        lines.append(tr("Installed outside the manager; not tracked here."))
    elif app.get("kind") == "deb":
        lines.append(tr("Install: download the verified .deb and install it."))
    else:
        lines.append(tr("Install: apt install {package}", package=app["package"]))
    lines.append("")
    lines.append(tr("Press i to install, e to run, q to close."))
    return lines


def fetch_hub_deb(app: dict[str, Any]) -> tuple[str, str]:
    """Download and verify a pinned deb. Returns (path, error)."""
    deb = app.get("deb")
    if not isinstance(deb, dict):
        return "", "No deb metadata"
    url = str(deb.get("url", "")).strip()
    sha256 = str(deb.get("sha256", "")).strip().lower()
    version = str(app.get("version", "")).strip()
    app_id = str(app.get("id", "")).strip()
    if not url.startswith("https://") or len(sha256) != 64:
        return "", "Invalid deb metadata"
    if not APT_NAME_RE.fullmatch(app_id) or not HUB_VERSION_RE.fullmatch(version):
        return "", "Invalid deb name"
    directory = hub_deb_dir()
    path = os.path.join(directory, f"{app_id}-{version}.deb")
    try:
        os.makedirs(directory, mode=0o700, exist_ok=True)
    except OSError:
        return "", "Cannot create the download directory"
    if os.path.isfile(path):
        if file_sha256(path) == sha256:
            return path, ""
        try:
            os.unlink(path)
        except OSError:
            pass
    request = urllib.request.Request(
        url, headers={"User-Agent": "cpz-settings/1"}
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            raw = response.read(HUB_DEB_MAX_BYTES + 1)
    except (urllib.error.URLError, OSError, ValueError) as error:
        return "", error_line(str(error)) or "download failed"
    if len(raw) > HUB_DEB_MAX_BYTES:
        return "", "deb is too large"
    if hashlib.sha256(raw).hexdigest() != sha256:
        return "", "checksum mismatch"
    try:
        temp = path + ".tmp"
        with open(temp, "wb") as handle:
            handle.write(raw)
        os.chmod(temp, 0o600)
        os.replace(temp, path)
    except OSError as error:
        return "", error_line(str(error)) or "cannot save the deb"
    return path, ""


def file_sha256(path: str) -> str:
    digest = hashlib.sha256()
    try:
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
    except OSError:
        return ""
    return digest.hexdigest()


def hub_prepare_apt(screen) -> str:
    if apt_lists_present():
        return ""
    draw_loading(screen, "Updating apt lists...")
    rc = run_privileged(
        screen,
        ["env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "update"],
    )
    if rc != 0:
        return "apt update failed"
    return ""


def hub_install_tool(screen, app: dict[str, Any]) -> str | None:
    installed = dpkg_installed()
    managed = read_hub_apps()
    status = hub_app_status(app, managed, installed)
    name = str(app.get("name", app.get("id", "?")))
    if status == "managed":
        return tr("{name} is already installed", name=name)
    if status == "system":
        return tr(
            "{name} is already installed outside the manager",
            name=name,
        )
    package = str(app["package"])
    if package in PKG_CORE:
        return tr("{name} is a system package", name=name)
    detail = tr("apt package: {package}", package=package)
    if app.get("kind") == "deb":
        detail = tr("Verified .deb package: {package}", package=package)
    if not confirm(
        screen,
        tr("Install {name}?", name=name),
        title="Install App",
        detail=detail,
    ):
        return None
    package_path = ""
    if app.get("kind") == "deb":
        draw_loading(screen, "Downloading app...")
        package_path, error = fetch_hub_deb(app)
        if error:
            return tr("Download failed: {reason}", reason=error)
    error = hub_prepare_apt(screen)
    if error:
        return error
    command = list(HUB_APT_INSTALL) + [package_path or package]
    rc = run_privileged(screen, command)
    if rc != 0:
        return "Install failed (try sudo apt update)"
    apps = read_hub_apps()
    apps[str(app["id"])] = {
        "slug": str(app["id"]),
        "name": name,
        "kind": str(app.get("kind", "apt")),
        "package": package,
        "version": dpkg_installed().get(package, app.get("version", "")),
        "installed_at": datetime.now().isoformat(timespec="seconds"),
        "install_command": (
            f"apt install ./{os.path.basename(package_path)}"
            if package_path
            else f"apt install {package}"
        ),
        "uninstall_command": f"apt-get purge {package}",
    }
    try:
        write_hub_apps(apps)
    except OSError:
        return tr("Installed {name} (manager state not saved)", name=name)
    return tr("Installed {name}", name=name)


def hub_uninstall_tool(screen, record: dict[str, Any]) -> str | None:
    package = str(record.get("package", ""))
    name = str(record.get("name", package)) or package
    if package in PKG_CORE:
        return tr("{name} is a system package", name=name)
    installed = dpkg_installed()
    if package not in installed:
        apps = read_hub_apps()
        apps.pop(str(record.get("slug", "")), None)
        try:
            write_hub_apps(apps)
        except OSError:
            return "Cannot update manager state"
        return tr(
            "Removed {name} from the manager (package is gone)",
            name=name,
        )
    planned = simulate_removal(package)
    if planned is None:
        return "Cannot check what would be removed"
    if any(item in PKG_CORE for item in planned):
        return "Refused: would remove core packages"
    other_packages = {
        str(item.get("package", ""))
        for slug, item in read_hub_apps().items()
        if slug != record.get("slug")
    }
    if any(item in other_packages for item in planned if item != package):
        return "Refused: would remove another managed app"
    extra = [item for item in planned if item != package]
    label = name if name == package else f"{name} ({package})"
    question = tr("Remove {label}?", label=label)
    detail = ""
    if extra:
        question = tr(
            "Remove {label} and {count} more package(s)?",
            label=label,
            count=len(extra),
        )
        detail = tr("Also removes: {packages}", packages=", ".join(extra))
    if not confirm(screen, question, title="Remove App", detail=detail, danger=True):
        return None
    rc = run_privileged(screen, list(HUB_APT_PURGE) + [package])
    if rc != 0:
        return "Removal failed (try sudo apt update)"
    apps = read_hub_apps()
    apps.pop(str(record.get("slug", "")), None)
    try:
        write_hub_apps(apps)
    except OSError:
        return tr("Removed {name} (manager state not saved)", name=name)
    return tr("Removed {name}", name=name)


def find_hub_app(app_id: str) -> dict[str, Any] | None:
    return hub_app_by_id(app_id.strip())


def pause_for_close() -> None:
    """Keep the install output on screen when Search launches it in a pane."""
    if not sys.stdin.isatty():
        return
    try:
        input("\n" + tr("Press Enter to close."))
    except EOFError:
        pass


def cli_install_tool(slug: str) -> int:
    """Install from CPZ Search without the curses Applications screen."""
    app = find_hub_app(slug)
    if app is None:
        print(f"cpz-settings: unknown app '{slug}'", file=sys.stderr)
        return 2
    name = str(app.get("name", "")).strip() or slug
    installed = dpkg_installed()
    managed = read_hub_apps()
    status = hub_app_status(app, managed, installed)
    if status == "managed":
        print(tr("{name} is already installed", name=name))
        return 0
    if status == "system":
        print(tr("{name} is already installed outside the manager", name=name))
        return 0
    package = str(app["package"])
    if package in PKG_CORE:
        print(tr("{name} is a system package", name=name), file=sys.stderr)
        return 1
    package_path = ""
    if app.get("kind") == "deb":
        print(tr("Downloading {name}...", name=name))
        package_path, error = fetch_hub_deb(app)
        if error:
            print(tr("Download failed: {reason}", reason=error), file=sys.stderr)
            return 1
    if not apt_lists_present():
        print("Updating apt lists...")
        rc = subprocess.call(
            ["sudo", "env", "DEBIAN_FRONTEND=noninteractive", "apt-get", "update"]
        )
        if rc != 0:
            print("apt update failed", file=sys.stderr)
            return 1
    print(tr("Installing {name} ({package})...", name=name, package=package))
    rc = subprocess.call(
        ["sudo", *HUB_APT_INSTALL, package_path or package]
    )
    if rc != 0:
        print("Install failed (try sudo apt update)", file=sys.stderr)
        return 1
    apps = read_hub_apps()
    apps[slug] = {
        "slug": slug,
        "name": name,
        "kind": str(app.get("kind", "apt")),
        "package": package,
        "version": dpkg_installed().get(package, app.get("version", "")),
        "installed_at": datetime.now().isoformat(timespec="seconds"),
        "install_command": (
            f"apt install ./{os.path.basename(package_path)}"
            if package_path
            else f"apt install {package}"
        ),
        "uninstall_command": f"apt-get purge {package}",
    }
    try:
        write_hub_apps(apps)
    except OSError:
        print(tr("Installed {name} (manager state not saved)", name=name))
        return 0
    print(tr("Installed {name}", name=name))
    print(tr("Open Search (Alt+O) to run it."))
    return 0


def simulate_removal(name: str) -> list[str] | None:
    try:
        result = subprocess.run(
            ["apt-get", "-s", "purge", name],
            capture_output=True,
            text=True,
            errors="replace",
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    planned = []
    for line in result.stdout.splitlines():
        if line.startswith(("Remv ", "Purg ")):
            planned.append(line.split()[1])
    return planned


