def ssh_toggle(screen, _data) -> str | None:
    status = ssh_status()
    active = status.split(",", 1)[0].strip() == "active"
    command = (
        ["systemctl", "disable", "--now", "ssh"]
        if active
        else ["systemctl", "enable", "--now", "ssh"]
    )
    rc = run_privileged(screen, command)
    return None if rc == 0 else "SSH change failed"


