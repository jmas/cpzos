def trove_filter_popup(
    screen, title: str, options: list[tuple[str, str, int]], current: str
) -> str | None:
    """Pick a category/language. Printable keys narrow the list."""
    query = ""
    selected = 0
    height, width = screen.getmaxyx()
    hint = "Type to filter  Enter keep  Esc cancel"
    popup_height = min(16, max(8, height - 2))
    popup_width = min(
        max(
            28,
            text_width(title) + 12,
            text_width(hint) + 2 * MODAL_TEXT_COLUMN,
        ),
        max(20, width - 2),
    )
    top = max(0, (height - popup_height) // 2)
    left = max(0, (width - popup_width) // 2)
    try:
        popup = curses.newwin(popup_height, popup_width, top, left)
    except curses.error:
        return None
    popup.keypad(True)
    initialized = False

    while True:
        needle = query.lower()
        filtered = [
            item
            for item in options
            if not needle
            or needle in item[1].lower()
            or needle in item[0].lower()
        ]
        if not initialized:
            selected = next(
                (index for index, item in enumerate(filtered) if item[0] == current),
                0,
            )
            initialized = True
        selected = max(0, min(selected, len(filtered) - 1))
        visible = max(1, popup_height - 6)
        content_cols = max(0, popup_width - 2 * MODAL_TEXT_COLUMN)
        first = max(0, min(selected - visible + 1, len(filtered) - visible))
        first = max(0, first)

        draw_modal_frame(popup, title, hint)
        put(
            popup,
            2,
            MODAL_TEXT_COLUMN,
            text_truncate(
                tr("Search: {query}", query=query),
                content_cols,
            ),
        )
        for offset, (_value, label, count) in enumerate(
            filtered[first : first + visible]
        ):
            row = first + offset
            text = f"{'>' if row == selected else ' '} {label}"
            if count:
                text += f" ({count})"
            attr = curses.A_REVERSE if row == selected else 0
            put(
                popup,
                3 + offset,
                MODAL_TEXT_COLUMN,
                text_pad(text, content_cols),
                attr,
            )
        if not filtered:
            put(popup, 3, MODAL_TEXT_COLUMN, "No matches")
        popup.refresh()

        key = popup.getch()
        if key in (ord("q"), ord("Q"), 27):
            del popup
            return None
        if key in (curses.KEY_UP, curses.KEY_PPAGE):
            selected = max(0, selected - (visible if key == curses.KEY_PPAGE else 1))
            continue
        if key in (curses.KEY_DOWN, curses.KEY_NPAGE):
            selected = min(
                len(filtered) - 1,
                selected + (visible if key == curses.KEY_NPAGE else 1),
            )
            continue
        if key in (10, 13, curses.KEY_RIGHT):
            del popup
            return filtered[selected][0] if filtered else None
        if key in (curses.KEY_BACKSPACE, 8, 127):
            query = query[:-1]
            selected = 0
            continue
        if 32 <= key < 127:
            query += chr(key)
            selected = 0


def trove_installed_tools(
    index: dict[str, Any],
    apps: dict[str, dict[str, Any]],
    query: str = "",
) -> list[dict[str, Any]]:
    """Return the manager's journal only, never apt/system packages.

    ``apps`` is ``read_trove_apps()``. A catalog tool that dpkg reports as
    installed but that has no record here was installed by the image or by
    apt directly and must stay out of the Installed tab.
    """
    by_slug = {tool["slug"]: tool for tool in index.get("tools", [])}
    installed = []
    for slug, record in apps.items():
        tool = trove_tool_from_record(record, by_slug.get(slug))
        if not trove_matches(tool, query):
            continue
        installed.append(tool)
    return sorted(installed, key=lambda item: item.get("name", "").lower())


def trove_details_lines(
    tool: dict[str, Any],
    apt: dict[str, str],
    record: dict[str, Any] | None,
    width: int,
    gui_signals: list[str] | None = None,
) -> list[str]:
    name = tool.get("name", tool.get("slug", "?"))
    categories = ", ".join(
        trove_category_name(str(item)) for item in tool.get("categories", [])
    ) or "-"
    language = tool.get("language_label") or tool.get("language") or "-"
    platforms = ", ".join(tool.get("platforms", [])) or "-"
    status = "not installed"
    if record:
        status = "installed (managed)"
    elif apt.get("status") == "installed":
        status = "installed (system)"
    lines = [
        tr("Name: {name}", name=name),
        tr("Language: {language}", language=language),
    ]
    lines.extend(
        textwrap.wrap(
            tr("Categories: {categories}", categories=categories),
            max(20, width - 1),
        )
    )
    lines.extend(
        textwrap.wrap(
            tr("Platforms: {platforms}", platforms=platforms),
            max(20, width - 1),
        )
    )
    lines.append(tr("Status: {status}", status=tr(status)))
    if gui_signals is None:
        gui_signals = trove_gui_signals(tool, apt)
    if gui_signals:
        lines.extend(
            textwrap.wrap(
                tr("Warning: this may be a desktop app, not a CLI/TUI app."),
                max(20, width - 1),
            )
        )
        for signal in gui_signals:
            lines.extend(
                textwrap.wrap(
                    tr("  - {signal}", signal=signal),
                    max(20, width - 1),
                )
            )
    if tool.get("license"):
        lines.append(tr("License: {license}", license=tool["license"]))
    if tool.get("stars"):
        lines.append(tr("Stars: {stars}", stars=f"{int(tool['stars']):,}"))
    if tool.get("release"):
        lines.append(tr("Latest release: {release}", release=tool["release"]))
    if apt.get("package"):
        version = f" {apt['version']}" if apt.get("version") else ""
        lines.append(
            tr(
                "Apt package: {package}",
                package=f"{apt['package']}{version}",
            )
        )
    else:
        lines.append("Apt package: not available")
    if apt.get("needs_update") == "1":
        lines.append("Package lists: update before install")
    if record:
        lines.append(
            tr(
                "Remove: {command}",
                command=record.get("uninstall_command")
                or "apt-get purge " + record.get("package", ""),
            )
        )
    elif apt.get("status") == "available":
        command = catalog_trove_apt(tool).get("command") or (
            f"apt install {apt.get('package', '')}"
        )
        lines.append(tr("Install: {command}", command=command))
    elif apt.get("status") == "installed":
        lines.append("Installed outside the manager; not tracked here.")
    lines.append("")
    commands = trove_install_commands(tool)
    if apt.get("status") == "missing":
        lines.append("Not available in apt; install manually:")
        if commands:
            for manager, command in commands:
                lines.extend(
                    textwrap.wrap(
                        f"  {manager}: {command}",
                        max(20, width - 1),
                        break_long_words=True,
                    )
                )
        else:
            lines.append("  No install command was published.")
    lines.append("")
    if tool.get("summary"):
        lines.extend(textwrap.wrap(str(tool["summary"]), max(20, width - 1)))
        lines.append("")
    description = str(tool.get("description", ""))
    if description:
        for paragraph in description.split("\n\n"):
            lines.extend(
                textwrap.wrap(
                    " ".join(paragraph.split()),
                    max(20, width - 1),
                    break_long_words=True,
                )
            )
            lines.append("")
    if tool.get("url"):
        lines.append(tr("Catalog: {url}", url=tool["url"]))
    if tool.get("website"):
        lines.append(tr("Website: {url}", url=tool["website"]))
    return lines


def trove_install_tool(
    screen, tool: dict[str, Any], apt_names: set[str] | None = None
) -> str | None:
    if apt_names is None:
        apt_names = trove_apt_names()
    apt = resolve_trove_apt(tool, apt_names)
    name = tool.get("name", tool.get("slug", "?"))
    if apt["status"] == "missing":
        return tr(
            "{name} is not in apt; press Enter for instructions",
            name=name,
        )
    if apt["status"] == "installed":
        return tr("{name} is already installed", name=name)
    package = apt["package"]
    question = tr("Install {name}?", name=name)
    detail_lines = []
    if package != name:
        detail_lines.append(tr("apt package: {package}", package=package))
    gui_signals = trove_gui_signals(tool, apt)
    if gui_signals:
        detail_lines.append(
            tr("Warning: this may be a desktop app, not a CLI/TUI app.")
        )
        detail_lines.extend(f"  - {signal}" for signal in gui_signals)
    detail = "\n".join(detail_lines)
    if not confirm(screen, question, title="Install App", detail=detail):
        return None
    if apt.get("needs_update") == "1":
        draw_loading(screen, "Updating apt lists...")
        rc = run_privileged(
            screen,
            [
                "env",
                "DEBIAN_FRONTEND=noninteractive",
                "apt-get",
                "update",
            ],
        )
        if rc != 0:
            return "apt update failed"
        _TROVE_APT_METADATA.clear()
        apt = resolve_trove_apt(tool, set())
        if apt["status"] == "installed":
            return tr("{name} is already installed", name=name)
        if apt["status"] == "missing":
            return tr("{name} is not in apt after update", name=name)
        package = apt["package"]
        updated_signals = trove_gui_signals(tool, apt)
        if updated_signals and updated_signals != gui_signals:
            detail = "\n".join(
                [
                    tr("Warning: this may be a desktop app, not a CLI/TUI app."),
                    *(f"  - {signal}" for signal in updated_signals),
                ]
            )
            if not confirm(
                screen, question, title="Install App", detail=detail
            ):
                return None
    rc = run_privileged(screen, list(TROVE_APT_INSTALL) + [package])
    if rc != 0:
        return "Install failed (try sudo apt update)"
    apps = read_trove_apps()
    version = apt_status(package).get("version", "")
    apps[str(tool.get("slug", package))] = {
        "slug": str(tool.get("slug", package)),
        "name": name,
        "package": package,
        "version": version,
        "installed_at": datetime.now().isoformat(timespec="seconds"),
        "install_command": catalog_trove_apt(tool).get("command")
        or f"apt install {package}",
        "uninstall_command": f"apt-get purge {package}",
    }
    try:
        write_trove_apps(apps)
    except OSError:
        return tr("Installed {name} (manager state not saved)", name=name)
    return tr("Installed {name}", name=name)


def trove_uninstall_tool(screen, record: dict[str, Any]) -> str | None:
    package = str(record.get("package", ""))
    name = str(record.get("name", package)) or package
    if package in PKG_CORE:
        return tr("{name} is a system package", name=name)
    if apt_status(package)["status"] == "missing":
        apps = read_trove_apps()
        apps.pop(str(record.get("slug", "")), None)
        try:
            write_trove_apps(apps)
        except OSError:
            return "Cannot update manager state"
        return tr(
            "Removed {name} from the manager (package is gone)",
            name=name,
        )
    planned = simulate_removal(package)
    if planned is None:
        return "Cannot check what would be removed"
    if any(item in PKG_CORE for item in planned):
        return "Refused: would remove core packages"
    extra = [item for item in planned if item != package]
    label = name if name == package else f"{name} ({package})"
    question = tr("Remove {label}?", label=label)
    detail = ""
    if extra:
        question = tr(
            "Remove {label} and {count} more package(s)?",
            label=label,
            count=len(extra),
        )
        detail = tr("Also removes: {packages}", packages=", ".join(extra))
    if not confirm(screen, question, title="Remove App", detail=detail, danger=True):
        return None
    rc = run_privileged(
        screen,
        ["env", "DEBIAN_FRONTEND=noninteractive", "APT_LISTCHANGES_FRONTEND=none", "apt-get", "purge", "-y", package],
    )
    if rc != 0:
        return "Removal failed (try sudo apt update)"
    apps = read_trove_apps()
    apps.pop(str(record.get("slug", "")), None)
    try:
        write_trove_apps(apps)
    except OSError:
        return tr("Removed {name} (manager state not saved)", name=name)
    return tr("Removed {name}", name=name)


def find_trove_tool(slug: str) -> dict[str, Any] | None:
    slug = slug.strip()
    if not slug:
        return None
    index = load_trove_index()
    for tool in index.get("tools", []):
        if str(tool.get("slug", "")).strip() == slug:
            return tool
    record = read_trove_apps().get(slug)
    if record:
        # Apps installed as ordinary apt packages have no catalog entry.
        return trove_tool_from_record(record)
    return None


