def sort_layouts(layouts) -> tuple:
    """Return layout (code, label) pairs ordered alphabetically by label."""
    return tuple(sorted(layouts, key=lambda item: (item[1].casefold(), item[0])))


def read_layouts() -> tuple:
    """Read layout codes and labels from xkb-data's evdev.lst."""
    layouts = []
    seen = set()
    try:
        with open(XKB_LAYOUTS_FILE, "r", encoding="utf-8") as handle:
            in_layout = False
            for raw in handle:
                line = raw.strip()
                if line.startswith("!"):
                    in_layout = line == "! layout"
                    continue
                if not in_layout or not line:
                    continue
                parts = line.split(None, 1)
                if len(parts) != 2:
                    continue
                code, label = parts[0].strip(), parts[1].strip()
                # "custom" is not a ckbcomp layout.
                if code == "custom" or not re.match(r"^[a-z][a-z0-9_]*$", code):
                    continue
                if code in seen:
                    continue
                seen.add(code)
                layouts.append((code, label))
    except OSError:
        return sort_layouts(FALLBACK_LAYOUTS)
    if not layouts:
        return sort_layouts(FALLBACK_LAYOUTS)
    return sort_layouts(layouts)


