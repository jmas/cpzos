def pointer_status() -> dict[str, str]:
    """Read the effective mouse/cursor state from cpz-pointer."""
    global _POINTER_STATUS
    now = time.monotonic()
    if _POINTER_STATUS and now - _POINTER_STATUS[0] < 2.0:
        return _POINTER_STATUS[1]

    values = {"mouse": "unknown", "cursor": "unknown"}
    helper = "/usr/local/bin/cpz-pointer"
    if os.path.exists(helper):
        try:
            result = subprocess.run(
                (helper, "--json"),
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
                timeout=2,
            )
            if result.returncode == 0:
                parsed = json.loads(result.stdout)
                if isinstance(parsed, dict):
                    for key in values:
                        value = parsed.get(key)
                        if isinstance(value, str):
                            values[key] = value
        except (OSError, subprocess.TimeoutExpired, ValueError):
            pass
    _POINTER_STATUS = (now, values)
    return values


