TIMEZONE_TABLE = "/usr/share/zoneinfo/zone.tab"


def read_timezones() -> tuple:
    """Read every system time zone, keeping the common ones first."""
    zones = []
    seen = set()
    try:
        with open(TIMEZONE_TABLE, "r", encoding="utf-8") as handle:
            for raw in handle:
                line = raw.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split("\t")
                if len(parts) < 3:
                    parts = line.split(None, 3)
                if len(parts) < 3:
                    continue
                zone = parts[2].strip()
                if zone and zone not in seen:
                    seen.add(zone)
                    zones.append(zone)
    except OSError:
        return COMMON_TIMEZONES
    if not zones:
        return COMMON_TIMEZONES
    preferred = [
        zone for zone in COMMON_TIMEZONES if zone in seen or zone == "UTC"
    ]
    rest = sorted(
        (zone for zone in zones if zone not in COMMON_TIMEZONES),
        key=str.lower,
    )
    return tuple(preferred + rest)


_TIMEZONES = None


def timezones() -> tuple:
    global _TIMEZONES
    if _TIMEZONES is None:
        _TIMEZONES = read_timezones()
    return _TIMEZONES

