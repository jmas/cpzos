def shortcut_from_char(value: int, alt_prefix: bool = False) -> str:
    """Map a captured curses value to a registry key, or return an empty string.

    Alt+letter arrives either as ESC followed by the character or, with 8-bit
    meta handling, as the character with the high bit set. A plain character
    without either signal is not an Alt shortcut and is ignored, as are
    Shift+Alt and Ctrl combinations: CPZ shortcuts are one modifier plus one
    plain key.
    """
    meta = 128 <= value <= 255
    if meta:
        value -= 128
    if not (alt_prefix or meta):
        return ""
    if value == 9:
        return "M-Tab"
    if value == curses.KEY_BTAB:
        return "M-BTab"
    if value == ord(" "):
        return "M-Space"
    if 0 <= value < 128 and re.fullmatch(r"[a-z0-9]", chr(value)):
        return "M-" + chr(value)
    return ""


def capture_shortcut(screen, action: dict) -> str | None:
    """Ask for a new Alt+key. Returns a key, ``reset``, or None on cancel."""
    popup = modal_window(
        screen,
        tr("Rebind {name}", name=tr(action["label"])),
        "Press the new shortcut.\n\n"
        "Alt+letter, Alt+digit, Alt+Space or Alt+Tab.\n"
        "Backspace restores the default.\n"
        "Esc cancels.",
        "Alt+key  Backspace reset  Esc cancel",
    )
    try:
        while True:
            popup.timeout(-1)
            first = popup.getch()
            if first in (curses.KEY_BACKSPACE, 8, 127):
                return "reset"
            if first in (10, 13):
                return None
            if first == 27:
                # tmux/foot send Alt as ESC followed by the key. A bare Esc
                # has no second byte; the short timeout keeps Esc usable as
                # "cancel" without swallowing an Alt combination.
                popup.timeout(150)
                second = popup.getch()
                popup.timeout(-1)
                if second == -1:
                    return None
                choice = shortcut_from_char(second, alt_prefix=True)
                if choice:
                    return choice
                continue
            choice = shortcut_from_char(first)
            if choice:
                return choice
            # Ctrl+letter and function keys are deliberately not accepted.
    finally:
        close_modal(screen, popup)


def apply_shortcuts(screen) -> tuple[int, str]:
    try:
        return keys_module().apply_tmux()
    except (FileNotFoundError, OSError) as error:
        return 1, str(error)


def rebind_action(screen, item: dict) -> None:
    """Capture a new binding and apply it to the live tmux server."""
    action = item["key_action"]
    try:
        keys = keys_module()
    except FileNotFoundError as error:
        notify(screen, str(error), title="Shortcuts", error=True)
        return

    current = keys.effective_bindings().get(action["id"], {})
    previous = current.get("key", "")
    choice = None
    applied = True
    try:
        # Root-table bindings are consumed by tmux before they reach this pane,
        # so a bound Alt+key could never be captured for a swap. Remove CPZ
        # bindings for the duration of the dialog and rebuild them afterwards.
        keys.suspend_tmux()
        choice = capture_shortcut(screen, action)
        if choice is None:
            return
        if choice == "reset":
            try:
                keys.clear_override(action["id"])
            except OSError as error:
                notify(screen, str(error), title="Shortcuts", error=True)
                return
            message = tr(
                "{action} restored to {key}",
                action=tr(action["label"]),
                key=keys.display_key(action["default"]),
            )
        else:
            other = keys.conflict_for(action["id"], choice)
            if other:
                label = keys.ACTIONS_BY_ID[other]["label"]
                notify(
                    screen,
                    tr(
                        "{key} is already used by {label}.",
                        key=keys.display_key(choice),
                        label=tr(label),
                    ),
                    title="Shortcut",
                    error=True,
                )
                return
            if choice == previous:
                return
            try:
                if keys.set_override(action["id"], choice) != 0:
                    notify(
                        screen,
                        tr(
                            "Could not save {key}.",
                            key=keys.display_key(choice),
                        ),
                        title="Shortcuts",
                        error=True,
                    )
                    return
            except OSError as error:
                notify(screen, str(error), title="Shortcuts", error=True)
                return
            message = f"{action['label']}: {keys.display_key(choice)}"
    finally:
        rc, detail = apply_shortcuts(screen)
        applied = rc == 0
        if not applied:
            notify(
                screen,
                tr("Shortcuts were saved but the new binding could not be applied.")
                + (f"\n{detail}" if detail else ""),
                title="Shortcuts",
                error=True,
            )
    if choice is not None and applied:
        notify(screen, message, title="Shortcuts", wait=False)


def reset_shortcuts_action(screen, _data) -> str | None:
    if not confirm(
        screen,
        "Reset all shortcuts?",
        title="Reset Shortcuts",
        detail="Every action returns to its default Alt+key.",
        danger=True,
    ):
        return None
    try:
        keys = keys_module()
    except FileNotFoundError as error:
        return str(error)
    keys.clear_all_overrides()
    rc, detail = apply_shortcuts(screen)
    if rc != 0:
        return tr("Shortcuts reset, apply failed") + (
            f": {detail}" if detail else ""
        )
    return "Shortcuts reset"


def filter_rows(rows, query: str) -> list:
    """Keep rows whose label or code contains the typed query."""
    needle = query.casefold()
    return [
        row
        for row in rows
        if needle in row[1].casefold() or needle in row[0].casefold()
    ]


def filter_item_indices(items: list, values: list, query: str) -> list[int]:
    """Indices of the rows whose label or current value matches the query."""
    needle = query.casefold()
    if not needle:
        return list(range(len(items)))
    return [
        index
        for index, (item, value) in enumerate(zip(items, values))
        if needle in str(item.get("label", "")).casefold()
        or needle in str(value).casefold()
    ]


def draw_layouts(
    screen, data: dict, shown: list, selected: int, query: str, searching: bool
) -> None:
    screen.erase()
    height, width = screen.getmaxyx()
    left = SCREEN_PAD
    cw = content_width(width)
    put(screen, 0, left, tr("Layouts"), curses.A_BOLD)
    if searching or query:
        put(screen, 1, left, f"/{query}" + ("_" if searching else ""))

    enabled = set(layout_codes(data))
    active = active_layout(data)
    top = 2
    visible = max(1, height - 3)
    first = 0
    if selected >= visible:
        first = selected - visible + 1
    first = max(0, min(first, max(0, len(shown) - visible)))

    for offset, (code, label) in enumerate(shown[first : first + visible]):
        row = first + offset
        mark = "[x]" if code in enabled else "[ ]"
        suffix = "  " + tr("Active") if code == active else ""
        label = text_truncate(label, 26)
        text = f"{'>' if row == selected else ' '} {mark} {text_pad(label, 26)}{suffix}"
        attr = curses.A_REVERSE if row == selected else 0
        put(screen, top + offset, left, text_pad(text, cw), attr)
    if not shown:
        put(screen, top, left + 1, tr("No matches"))

    if first > 0:
        put(screen, 1, left + cw - 1, "^")
    if first + visible < len(shown):
        put(screen, 1, left + cw - 1, "v" if first == 0 else "*")

    if searching:
        footer = tr("Type to filter  Enter keep  Esc clear")
    else:
        footer = tr("F/X move  Space toggle  / filter  q back")
    put(screen, height - 1, left, footer, hint_attr())
    screen.refresh()


def layouts_screen(screen, data: dict) -> None:
    active = active_layout(data)
    selected = next(
        (index for index, (code, _label) in enumerate(layouts()) if code == active),
        0,
    )
    query = ""
    searching = False
    changed = False

    while True:
        shown = filter_rows(layouts(), query)
        selected = max(0, min(selected, len(shown) - 1))
        draw_layouts(screen, data, shown, selected, query, searching)
        key = screen.getch()
        if key == curses.KEY_MOUSE:
            wheel = read_wheel_key()
            if wheel is None:
                continue
            key = wheel

        if searching:
            if key == 27:
                if query:
                    query = ""
                    selected = 0
                else:
                    searching = False
                continue
            if key in (10, 13):
                searching = False
                continue
            if key in (curses.KEY_BACKSPACE, 8, 127):
                query = query[:-1]
                selected = 0
                continue
            if key in NAV_UP and shown:
                selected = (selected - 1) % len(shown)
                continue
            if key in NAV_DOWN and shown:
                selected = (selected + 1) % len(shown)
                continue
            if 32 <= key < 127:
                query += chr(key)
                selected = 0
                continue
            continue

        if key in (ord("q"), ord("Q"), 27):
            if key == 27 and query:
                query = ""
                selected = 0
                continue
            if changed:
                reload_keyboard_layout(screen)
            return
        if key == ord("/"):
            searching = True
            continue
        if key in NAV_UP and shown:
            selected = (selected - 1) % len(shown)
            continue
        if key in NAV_DOWN and shown:
            selected = (selected + 1) % len(shown)
            continue
        page = max(1, screen.getmaxyx()[0] - 3)
        if key == curses.KEY_PPAGE:
            selected = max(0, selected - page)
            continue
        if key == curses.KEY_NPAGE:
            selected = min(len(shown) - 1, selected + page)
            continue
        if key in (curses.KEY_HOME, ord("g")):
            selected = 0
            continue
        if key in (curses.KEY_END, ord("G")):
            selected = max(0, len(shown) - 1)
            continue
        if key not in (ord(" "), 10, 13) or not shown:
            continue

        code, _label = shown[selected]
        enabled = layout_codes(data)
        if code in enabled:
            if len(enabled) == 1:
                notify(
                    screen,
                    "Keep at least one layout enabled",
                    title="Layouts",
                    error=False,
                )
                continue
            enabled.remove(code)
        else:
            enabled.append(code)
        data["keyboard_layouts"] = ",".join(normalize_layouts(",".join(enabled)))
        data["keyboard_layout_active"] = active_layout(data)
        save_settings(data)
        changed = True


def layouts_action(screen, data) -> None:
    layouts_screen(screen, data)


