    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config"
    )
    return os.path.join(base, "cpz", "settings.conf")


def request_path() -> str:
    """Where cpz-settings-open asks the running Settings tab to navigate.

    Both processes run as the same user, so a runtime directory (or /tmp when
    XDG_RUNTIME_DIR is not set) is enough. The override keeps the tests off the
    real queue.
    """
    override = os.environ.get("CPZ_SETTINGS_REQUEST", "").strip()
    if override:
        return override
    base = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    return os.path.join(base, "cpz", "settings-request")


def take_request() -> tuple[str, str] | None:
    """Claim a pending navigation request, if any.

    rename(2) makes the claim atomic, so a second cpz-settings instance (for
    example one started by hand) cannot handle the same request twice.
    """
    path = request_path()
    claimed = f"{path}.{os.getpid()}"
    try:
        os.replace(path, claimed)
    except OSError:
        return None
    try:
        with open(claimed, "r", encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except OSError:
        return None
    finally:
        try:
            os.unlink(claimed)
        except OSError:
            pass
    if len(lines) < 2:
        return None
    kind = lines[0].strip()
    value = lines[1].strip()
    if kind not in ("page", "tool") or not value:
        return None
    return kind, value


def available_themes() -> list[str]:
    names = set()
    for path in glob.glob(os.path.join(THEME_DIR, "*.conf")):
        name = os.path.splitext(os.path.basename(path))[0]
        # Keep the same character set the renderers accept. A file called
        # "my.theme.conf" would otherwise be listed in Settings and then
        # silently fall back to Campbell when it is applied.
        if re.fullmatch(r"[A-Za-z0-9_-]+", name):
            names.add(name)
    ordered = [name for name in THEME_ORDER if name in names]
    ordered.extend(sorted(names - set(THEME_ORDER)))
    return ordered or [DEFAULTS["theme"]]


def theme_label(name: str) -> str:
    path = os.path.join(THEME_DIR, name + ".conf")
    try:
        with open(path, "r", encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("# name:"):
                    label = line.split(":", 1)[1].strip()
                    if label:
                        return label
    except OSError:
        pass
    return THEME_LABELS.get(name, name)


def theme_labels() -> dict:
    return {name: theme_label(name) for name in available_themes()}


def normalize_layouts(value) -> list:
    """Return enabled layout codes in the canonical LAYOUTS order."""
    seen = set()
    for code in re.split(r"[,\s]+", str(value or "")):
        code = code.strip()
        if code in layout_labels():
            seen.add(code)
    ordered = [code for code, _label in layouts() if code in seen]
    return ordered or ["us"]


def layout_codes(data: dict) -> list:
    return normalize_layouts(data.get("keyboard_layouts", DEFAULTS["keyboard_layouts"]))


def layout_label(code: str) -> str:
    return layout_labels().get(code, str(code).upper())


def layouts_text(data: dict) -> str:
    return ", ".join(layout_label(code) for code in layout_codes(data))


def active_layout(data: dict) -> str:
    codes = layout_codes(data)
    current = data.get("keyboard_layout_active", DEFAULTS["keyboard_layout_active"])
    return current if current in codes else codes[0]


def parse_file(path: str, data: dict) -> None:
    try:
        with open(path, "r", encoding="utf-8") as handle:
            for raw in handle:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip().strip('"')
                if key in (
                    "font_size",
                    "font_size_panel",
                    "font_size_hdmi",
                    "font_panel",
                    "font_hdmi",
                ):
                    # Handled by parse_font_file so the user file can override
                    # the system file and a legacy single size only fills the
                    # outputs that have no explicit value.
                    continue
                if key not in data:
                    continue
                if key in (
                    "theme",
                    "language",
                    "date_format",
                    "display",
                    "font_family",
                    "mode_keys",
                    "keyboard_layout",
                    "keyboard_layouts",
                    "keyboard_layout_active",
                ):
                    data[key] = value
                else:
                    try:
                        data[key] = int(value)
                    except ValueError:
                        pass
    except OSError:
        pass


def parse_font_file(path: str) -> tuple[int | None, int | None, int | None]:
    """Return (panel, hdmi, legacy) font sizes from one settings file."""
    panel: int | None = None
    hdmi: int | None = None
    legacy: int | None = None
    try:
        with open(path, "r", encoding="utf-8") as handle:
            for raw in handle:
                line = raw.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                value = value.strip().strip('"')
                if key == "font_panel":
                    panel = LEGACY_FONT_PANEL.get(value)
                elif key == "font_hdmi":
                    hdmi = LEGACY_FONT_PANEL.get(value)
                elif key == "font_size_panel":
                    try:
                        panel = int(value)
                    except ValueError:
                        pass
                elif key == "font_size_hdmi":
                    try:
                        hdmi = int(value)
                    except ValueError:
                        pass
                elif key == "font_size":
                    try:
                        legacy = int(value)
                    except ValueError:
                        pass
    except OSError:
        pass
    return panel, hdmi, legacy


def load_settings() -> dict:
    data = dict(DEFAULTS)
    parse_file(SYSTEM_SETTINGS, data)
    parse_file(user_settings_path(), data)
    themes = available_themes()
    if data["theme"] not in themes:
        data["theme"] = DEFAULTS["theme"] if DEFAULTS["theme"] in themes else themes[0]
    if data["history_limit"] not in HISTORY_CHOICES:
        data["history_limit"] = DEFAULTS["history_limit"]
    if data["language"] not in language_codes():
        data["language"] = DEFAULTS["language"]
    set_language(data["language"])
    if data["date_format"] not in DATE_FORMATS:
        data["date_format"] = DEFAULTS["date_format"]
    if data["display"] not in DISPLAY_MODES:
        data["display"] = DEFAULTS["display"]
    if data["font_family"] not in FONT_FAMILIES:
        data["font_family"] = DEFAULTS["font_family"]
    # Per-output text size: a value in the user's file wins over the system
    # default; an explicit font_size_panel/font_size_hdmi wins over the legacy
    # single font_size in the same or a lower-priority file.
    system_panel, system_hdmi, system_legacy = parse_font_file(SYSTEM_SETTINGS)
    user_panel, user_hdmi, user_legacy = parse_font_file(user_settings_path())

    def pick(user, system, legacy):
        # The user's file always wins over the shipped defaults, including a
        # legacy single font_size from an image that predates the per-output
        # keys. Inside one file an explicit per-output key wins over legacy.
        if user is not None:
            return user
        if user_legacy is not None:
            return user_legacy
        if system is not None:
            return system
        if system_legacy is not None:
            return system_legacy
        return legacy

    for font, value in (
        ("font_size_panel", pick(user_panel, system_panel, DEFAULTS["font_size_panel"])),
        ("font_size_hdmi", pick(user_hdmi, system_hdmi, DEFAULTS["font_size_hdmi"])),
    ):
        data[font] = nearest_font_size(value)
    if data["mode_keys"] not in MODE_KEYS:
        data["mode_keys"] = DEFAULTS["mode_keys"]
    if data["keyboard_layout"] not in ("auto", "cpz", "standard"):
        data["keyboard_layout"] = DEFAULTS["keyboard_layout"]
    data["keyboard_layouts"] = ",".join(layout_codes(data))
    data["keyboard_layout_active"] = active_layout(data)
    if data["status_interval"] not in STATUS_INTERVALS:
        data["status_interval"] = DEFAULTS["status_interval"]
    if data["screen_timeout"] not in SCREEN_TIMEOUTS:
        data["screen_timeout"] = DEFAULTS["screen_timeout"]
    try:
        brightness = int(data["brightness"])
    except (TypeError, ValueError):
        brightness = DEFAULTS["brightness"]
    data["brightness"] = max(10, min(100, brightness))
    try:
        mouse_speed = int(data["mouse_speed"])
    except (TypeError, ValueError):
        mouse_speed = DEFAULTS["mouse_speed"]
    data["mouse_speed"] = max(MOUSE_SPEEDS[0], min(MOUSE_SPEEDS[-1], mouse_speed))
    for key in (
        "show_clock",
        "clock_24h",
        "show_date",
        "show_battery",
        "show_volume",
        "show_brightness",
        "show_conn",
        "show_layout",
        "mouse",
        "set_clipboard",
        "automatic_rename",
    ):
        data[key] = 1 if data[key] else 0
    return data


def save_settings(data: dict) -> None:
    path = user_settings_path()
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    temp = path + ".tmp"
    with open(temp, "w", encoding="utf-8") as handle:
        handle.write("# CPZ user settings. Written by cpz-settings.\n")
        for key in (
            "keyboard_layout",
            "keyboard_layouts",
            "keyboard_layout_active",
            "theme",
            "language",
            "show_clock",
            "clock_24h",
            "show_date",
            "date_format",
            "show_battery",
            "show_volume",
            "show_brightness",
            "show_conn",
            "show_layout",
            "display",
            "font_family",
            "font_size_panel",
            "font_size_hdmi",
            "brightness",
            "screen_timeout",
            "mouse",
            "mouse_speed",
            "history_limit",
            "mode_keys",
            "status_interval",
            "set_clipboard",
            "automatic_rename",
        ):
            handle.write(f"{key}={data[key]}\n")
    os.replace(temp, path)


def tmux(*args: str) -> None:
    if not os.environ.get("TMUX"):
        return
    try:
        subprocess.run(
            ("tmux",) + args,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        pass


def refresh_clients(status_only: bool = False) -> None:
    """Repaint every attached tmux client after a style change.

    ``tmux refresh-client`` without ``-t`` relies on a current client, which
    does not exist when this runs from a pane process. The theme then only
    became visible after the user switched tabs and tmux redrew on its own.
    """
    if not os.environ.get("TMUX"):
        return
    try:
        result = subprocess.run(
            ("tmux", "list-clients", "-F", "#{client_name}"),
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError:
        return
    clients = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    if not clients:
        tmux("refresh-client", *(["-S"] if status_only else []))
        return
    for client in clients:
        tmux("refresh-client", *(["-S"] if status_only else []), "-t", client)


def status_right_length(data: dict) -> int:
    # Reserve three columns for the layout code (e.g. "UA "), three for the
    # volume token (e.g. "V4 ") and four for the brightness token (e.g. "B10 ").
    # With a single enabled layout cpz-status hides the layout token.
    extra = 3 if data.get("show_layout") and len(layout_codes(data)) > 1 else 0
    if data.get("show_volume"):
        extra += 3
    if data.get("show_brightness"):
        extra += 4
    if not data.get("show_date"):
        return 30 + extra
    return (34 if data.get("date_format") == "short" else 40) + extra


def reload_foot() -> None:
    """Replace only the visible terminal after a font or theme change."""
    helper = "/usr/local/bin/cpz-foot-reload"
    if not os.path.exists(helper):
        return
    try:
        subprocess.run(
            (helper,),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def request_output_apply() -> None:
    """Ask systemd to run cpz-cage-output after a display-mode change."""
    path = "/run/cpz-cage/output.request"
    try:
        os.utime(path, None)
        return
    except OSError:
        pass
    try:
        with open(path, "a", encoding="utf-8"):
            pass
    except OSError:
        pass


def request_pointer_apply() -> None:
    """Ask systemd to reopen pointer devices after a mouse-setting change."""
    path = "/run/cpz-pointer/request"
    try:
        os.utime(path, None)
        return
    except OSError:
        pass
    try:
        with open(path, "a", encoding="utf-8"):
            pass
    except OSError:
        pass


def locale_conf_value(name: str) -> str:
    """Read one assignment from /etc/locale.conf, without shelling out."""
    try:
        with open(SYSTEM_LOCALE_FILE, encoding="utf-8") as handle:
            for line in handle:
                key, separator, value = line.strip().partition("=")
                if separator and key == name:
                    return value
    except OSError:
        pass
    return ""


def apply_system_locale(code: str) -> bool:
    """Write the system locale through the sudo allowlist.

    The CPZ catalogs and the current session are updated by apply_language();
    this only makes the choice survive the next login. A failure here must not
    block the interface switch, so the caller keeps the new CPZ language.
    """
    target = LANGUAGE_LOCALES.get(code, "en_US.UTF-8")
    if all(
        locale_conf_value(name) == target
        for name in ("LANG", "LC_MESSAGES", "LC_TIME")
    ):
        return True
    helper = os.environ.get("CPZ_LOCALE_HELPER", LOCALE_HELPER)
    if not os.path.isfile(helper):
        return True
    try:
        result = subprocess.run(
            ["sudo", "-n", helper, code],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0


def rename_settings_tab() -> None:
    """Keep the Settings tab title in the selected language."""
    try:
        result = subprocess.run(
            ["tmux", "list-windows", "-F", "#{window_id} #{?@cpz_settings,1,0}"],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return
    if result.returncode != 0:
        return
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "1":
            tmux("rename-window", "-t", parts[0], tr("settings"))
            return


def apply_language(code: str) -> bool:
    """Switch the CPZ UI, the session and the system locale to a language."""
    set_language(code)
    rename_settings_tab()
    locale = LANGUAGE_LOCALES.get(_LANGUAGE, "en_US.UTF-8")
    os.environ["LANG"] = locale
    os.environ["LC_MESSAGES"] = locale
    os.environ["LC_TIME"] = locale
    tmux("set-environment", "-g", "LANG", locale)
    tmux("set-environment", "-g", "LC_MESSAGES", locale)
    tmux("set-environment", "-g", "LC_TIME", locale)
    # Regenerate the tmux bindings so embedded prompts (Rename tab, Close
    # pane) and the help popup title follow the new language too.
    try:
        keys = keys_module()
        keys.refresh_language()
        keys.apply_tmux()
    except (AttributeError, FileNotFoundError, OSError):
        pass
    return apply_system_locale(_LANGUAGE)


def apply_live(data: dict, key: str) -> None:
    if key == "theme":
        apply_theme(data["theme"])
    elif key == "language":
        if not apply_language(data["language"]):
            print(
                "cpz-settings: system language not applied",
                file=sys.stderr,
            )
        refresh_clients()
    elif key in (
        "show_date",
        "date_format",
        "show_layout",
        "show_volume",
        "show_brightness",
    ):
        tmux("set", "-g", "status-right-length", str(status_right_length(data)))
    elif key == "brightness":
        set_backlight_percent(data["brightness"])
    elif key == "screen_timeout":
        # The value is persisted. The cage session has no compositor-side
        # DPMS timer; an idle helper can consume this setting later without
        # changing the storage format.
        apply_screen_timeout(data["screen_timeout"])
    elif key == "display":
        # The path unit runs cpz-cage-output immediately; the five-second
        # timer stays as a fallback for edits made outside Settings.
        request_output_apply()
    elif key in ("font_family", "font_size_panel", "font_size_hdmi"):
        # foot reads foot.ini only at startup. The session supervisor replaces
        # just the visible terminal, so there is no compositor restart. Each
        # output keeps its own size; only the active one is rendered.
        pass
    elif key == "mode_keys":
        tmux("set", "-g", "mode-keys", data["mode_keys"])
    elif key == "status_interval":
        tmux("set", "-g", "status-interval", str(data["status_interval"]))
    elif key == "set_clipboard":
        tmux("set", "-g", "set-clipboard", "on" if data["set_clipboard"] else "off")
    elif key == "automatic_rename":
        tmux(
            "set",
            "-g",
            "automatic-rename",
            "on" if data["automatic_rename"] else "off",
        )
    elif key == "mouse":
        tmux("set", "-g", "mouse", "on" if data["mouse"] else "off")
        global _POINTER_STATUS
        _POINTER_STATUS = None
        request_pointer_apply()
    elif key == "mouse_speed":
        # cpz-pointer reads settings.conf, publishes the speed to the shim and
        # reopens the pointer devices; cage itself is not restarted.
        request_pointer_apply()
    elif key == "history_limit":
        tmux("set", "-g", "history-limit", str(data["history_limit"]))
    # Clock/battery/volume/date are read by cpz-status on the next status
    # refresh.
    refresh_clients(status_only=True)
    if key in ("theme", "font_family", "font_size_panel", "font_size_hdmi"):
        reload_foot()


def apply_theme(theme: str) -> None:
    """Apply a theme to every tmux window and pane."""
    helper = "/usr/local/bin/cpz-apply-settings"
    if os.path.exists(helper):
        try:
            result = subprocess.run(
                (helper, "--theme"),
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            if result.returncode == 0:
                # Keep the repaint here as well, so switching still updates
                # immediately if the installed helper is an older build.
                refresh_clients()
                return
        except OSError:
            pass

    # Fallback for a host/dev run where the installed helper is unavailable.
    path = os.path.join(THEME_DIR, theme + ".conf")
    if os.path.exists(path):
        tmux("source-file", path)
    refresh_clients()


def output_is_hdmi() -> bool:
    """True when cpz-cage-output currently drives HDMI with the panel off."""
    try:
        with open("/run/cpz-cage/output.state", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("target="):
                    return line.strip() == "target=hdmi"
    except OSError:
        pass
    return False


def set_backlight_percent(percent: int) -> bool:
    percent = max(1, min(100, percent))
    # The panel is dark while HDMI is active; the value is stored in the
    # settings and restored by cpz-cage-output on the next switch.
    if output_is_hdmi():
        return True
    for path in glob.glob("/sys/class/backlight/*"):
        try:
            with open(os.path.join(path, "max_brightness"), "r", encoding="utf-8") as fh:
                maximum = int(fh.read().strip())
            if maximum <= 0:
                continue
            value = max(1, percent * maximum // 100)
            with open(os.path.join(path, "brightness"), "w", encoding="utf-8") as fh:
                fh.write(str(value))
            return True
        except (OSError, ValueError):
            continue
    return False


def apply_screen_timeout(minutes: int) -> None:
    """Persist the requested screen timeout.

    The value is stored in settings.conf. The cage session does not expose a
    compositor DPMS timer, so an idle helper can consume the same key later
    without changing the settings format or the Settings page.
    """


def wpctl_status(kind: str):
    """Return (percent, muted) for the default sink/source."""
    target = f"@DEFAULT_AUDIO_{kind.upper()}@"
    rc, out, _ = nm_run(["wpctl", "get-volume", target], timeout=5)
    if rc != 0:
        return None, False
    match = re.search(r"Volume:\s*([0-9.]+)", out)
    if not match:
        return None, False
    percent = max(0, min(100, round(float(match.group(1)) * 100)))
    return percent, "[MUTED]" in out


def wpctl_set_volume(kind: str, percent: int) -> None:
    target = f"@DEFAULT_AUDIO_{kind.upper()}@"
    nm_run(
        ["wpctl", "set-volume", target, f"{max(0, min(100, percent)) / 100:.2f}"],
        timeout=5,
    )


def wpctl_toggle_mute(kind: str) -> None:
    target = f"@DEFAULT_AUDIO_{kind.upper()}@"
    nm_run(["wpctl", "set-mute", target, "toggle"], timeout=5)


def wpctl_nodes(kind: str):
    """Return [(id, name, is_default)] for Sinks or Sources."""
    rc, out, _ = nm_run(["wpctl", "status"], timeout=10)
    if rc != 0:
        return []
    nodes = []
    active = False
    for line in out.splitlines():
        stripped = line.strip()
        header = f"{kind}s:"
        if stripped.endswith(header) or stripped == header:
            active = True
            continue
        if not active:
            continue
        if stripped.startswith("├─") or stripped.startswith("└─"):
            break
        if not stripped or not stripped.startswith("│"):
            continue
        content = stripped.lstrip("│").strip()
        match = re.search(r"^(\*)?\s*(\d+)\.\s+(.+?)(?:\s+\[vol:.*)?$", content)
        if not match:
            continue
        default = bool(match.group(1))
        node_id = match.group(2)
        name = match.group(3).strip()
        name = name.split("[vol:")[0].strip()
        nodes.append((node_id, name, default))
    return nodes


def wpctl_set_default(kind: str, node_id: str) -> None:
    nm_run(["wpctl", "set-default", node_id], timeout=5)


def split_terse(line: str) -> list:
    """Split nmcli terse output, honouring backslash-escaped ':' and '\\'."""
    fields = []
    current = []
    escaped = False
    for char in line:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            fields.append("".join(current))
            current = []
        else:
            current.append(char)
    if escaped:
        current.append("\\")
    fields.append("".join(current))
    return fields


def nm_devices():
    rc, out, _ = nm_run(
        ["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status"],
        timeout=10,
    )
    if rc != 0:
        return []
    devices = []
    for line in out.splitlines():
        parts = split_terse(line)
        if len(parts) < 3:
            continue
        devices.append(
            {
                "device": parts[0],
                "type": parts[1],
                "state": parts[2],
                "connection": parts[3] if len(parts) > 3 else "",
            }
        )
    return devices


def nm_ip(device: str) -> str:
    rc, out, _ = nm_run(
        ["nmcli", "-g", "IP4.ADDRESS,IP6.ADDRESS", "device", "show", device],
        timeout=10,
    )
    if rc != 0:
        return ""
    addresses = []
    for line in out.splitlines():
        parts = split_terse(line)
        if len(parts) < 2:
            continue
        value = ":".join(parts[1:]).strip()
        if value:
            addresses.append(value)
    return " ".join(addresses)


def wifi_ip() -> str:
    for device in nm_devices():
        if device["type"] == "wifi" and device["state"] == "connected":
            return nm_ip(device["device"])
    return ""


def ethernet_info() -> str:
    for device in nm_devices():
        if device["type"] == "ethernet":
            ip = nm_ip(device["device"])
            return f"{device['device']} {tr(device['state'])}" + (
                f" - {ip}" if ip else ""
            )
    return "none"


def wifi_info() -> str:
    summary = tr(wifi_summary())
    ip = wifi_ip()
    return f"{summary}" + (f" - {ip}" if ip else "")


def vpn_profiles():
    rc, out, _ = nm_run(
        ["nmcli", "-t", "-f", "NAME,TYPE,ACTIVE", "connection", "show"], timeout=10
    )
    if rc != 0:
        return []
    profiles = []
    for line in out.splitlines():
        parts = split_terse(line)
        if len(parts) < 3:
            continue
        name, kind, active = parts[0], parts[1], parts[2]
        if kind not in ("vpn", "wireguard"):
            continue
        profiles.append({"name": name, "type": kind, "active": active == "yes"})
    return profiles


def network_details_lines():
    lines = ["Connections", ""]
    for device in nm_devices():
        lines.append(
            f"{device['device']}: {device['type']} {tr(device['state'])}"
            + (f" ({device['connection']})" if device["connection"] else "")
        )
        ip = nm_ip(device["device"])
        if ip:
            lines.append("  " + tr("IP: {address}", address=ip))
    lines.extend(["", "Addresses"])
    rc, out, _ = nm_run(["ip", "-brief", "addr", "show"], timeout=10)
    if rc == 0:
        lines.extend("  " + line for line in out.splitlines())
    return lines


def timedatectl_value(field: str) -> str:
    rc, out, _ = nm_run(["timedatectl", "show", "-p", field, "--value"], timeout=10)
    return out.strip() if rc == 0 else "unknown"


DATETIME_FIELDS = ("Year", "Month", "Day", "Hour", "Min", "Sec")


def datetime_parts(now=None) -> list:
    now = now or datetime.now()
    return [now.year, now.month, now.day, now.hour, now.minute, now.second]


def datetime_text(parts) -> str:
    return (
        f"{parts[0]:04d}-{parts[1]:02d}-{parts[2]:02d} "
        f"{parts[3]:02d}:{parts[4]:02d}:{parts[5]:02d}"
    )


def adjust_datetime_part(parts: list, index: int, step: int) -> None:
    if index == 0:
        parts[0] = max(1970, min(2099, parts[0] + step))
    elif index == 1:
        parts[1] = ((parts[1] - 1 + step) % 12) + 1
    elif index == 2:
        last_day = calendar.monthrange(parts[0], parts[1])[1]
        parts[2] = ((parts[2] - 1 + step) % last_day) + 1
    elif index == 3:
        parts[3] = (parts[3] + step) % 24
    elif index == 4:
        parts[4] = (parts[4] + step) % 60
    else:
        parts[5] = (parts[5] + step) % 60
    # Keep the selected day valid when the year or month moved.
    if index in (0, 1):
        parts[2] = min(parts[2], calendar.monthrange(parts[0], parts[1])[1])


def set_datetime_part_text(parts: list, index: int, text: str) -> None:
    """Apply a typed field value, clamped to a valid date/time range."""
    if not text:
        return
    value = int(text)
    if index == 0:
        # Require a full year so a partial entry cannot jump the clock to 1970.
        if len(text) < 4:
            return
        value = max(1970, min(2099, value))
    elif index == 1:
        value = max(1, min(12, value))
    elif index == 2:
        value = max(1, min(calendar.monthrange(parts[0], parts[1])[1], value))
    elif index == 3:
        value = max(0, min(23, value))
    elif index == 4:
        value = max(0, min(59, value))
    else:
        value = max(0, min(59, value))
    parts[index] = value
    if index in (0, 1):
        parts[2] = min(parts[2], calendar.monthrange(parts[0], parts[1])[1])


def draw_datetime_editor(
    screen, parts: list, selected: int, notice: str, ntp: bool, typed: str = ""
) -> None:
    screen.erase()
    height, width = screen.getmaxyx()
    left = SCREEN_PAD
    put(screen, 0, left, tr("Set Date & Time"), curses.A_BOLD)

    columns = (left + 2, left + 14, left + 26)
    for index in range(len(parts)):
        row = 2 + (index // 3) * 2
        column = columns[index % 3]
        if index == selected and typed:
            value = typed
        else:
            value = f"{parts[index]:04d}" if index == 0 else f"{parts[index]:02d}"
        put(
            screen,
            row,
            column,
            tr(DATETIME_FIELDS[index]),
            curses.A_BOLD if index == selected else 0,
        )
        put(
            screen,
            row + 1,
            column,
            value,
            curses.A_REVERSE if index == selected else 0,
        )

    put(screen, 7, left + 2, datetime_text(parts))
    put(
        screen,
        9,
        left + 2,
        "NTP: " + tr("On (will be disabled)" if ntp else "Off"),
    )
    if notice:
        put(screen, height - 1, left, tr(notice))
    else:
        put(
            screen,
            height - 1,
            left,
            tr("Type or F/X edit Z/C field Enter apply q cancel"),
            hint_attr(),
        )
    screen.refresh()


def datetime_edit_screen(screen):
    """Edit the local system date/time. Returns parts or None on cancel."""
    parts = datetime_parts()
    selected = 0
    ntp = timedatectl_value("NTP").lower() == "yes"
    typed = ""
    notice = ""
    while True:
        draw_datetime_editor(screen, parts, selected, notice, ntp, typed)
        key = screen.getch()
        notice = ""
        if ord("0") <= key <= ord("9"):
            typed += chr(key)
            max_length = 4 if selected == 0 else 2
            if len(typed) >= max_length:
                set_datetime_part_text(parts, selected, typed)
                typed = ""
            continue
        if key in (curses.KEY_BACKSPACE, 8, 127):
            typed = typed[:-1]
            continue
        if typed:
            set_datetime_part_text(parts, selected, typed)
            typed = ""
        if key in (ord("q"), ord("Q"), 27):
            return None
        if key in NAV_LEFT:
            selected = (selected - 1) % len(parts)
            continue
        if key in NAV_RIGHT:
            selected = (selected + 1) % len(parts)
            continue
        if key in NAV_UP:
            adjust_datetime_part(parts, selected, 1)
            continue
        if key in NAV_DOWN:
            adjust_datetime_part(parts, selected, -1)
            continue
        if key in (10, 13, ord(" ")):
            return parts


def set_datetime_action(screen, _data) -> str | None:
    parts = datetime_edit_screen(screen)
    if parts is None:
        return None
    value = datetime_text(parts)
    if timedatectl_value("NTP").lower() == "yes":
        rc = run_privileged(screen, ["timedatectl", "set-ntp", "false"])
        if rc != 0:
            return "Could not disable NTP"
    rc = run_privileged(screen, ["timedatectl", "set-time", value])
    if rc != 0:
        return "Date/time change failed"
    return tr("Set: {value}", value=value)


def cpz_version() -> str:
    try:
        with open("/etc/cpz-version", "r", encoding="utf-8") as handle:
            return handle.read().strip() or "unknown"
    except OSError:
        return "unknown"


def battery_info() -> str:
    for supply in glob.glob("/sys/class/power_supply/*"):
        try:
            with open(os.path.join(supply, "capacity"), "r", encoding="utf-8") as fh:
                capacity = fh.read().strip()
            status = ""
            try:
                with open(os.path.join(supply, "status"), "r", encoding="utf-8") as fh:
                    status = fh.read().strip()
            except OSError:
                pass
            return f"{capacity}%" + (f" {tr(status)}" if status else "")
        except (OSError, ValueError):
            continue
    return "no battery"


def ssh_status() -> str:
    active = "unknown"
    enabled = "unknown"
    rc, out, _ = nm_run(["systemctl", "is-active", "ssh"], timeout=5)
    if rc == 0:
        active = out.strip() or "active"
    else:
        active = "inactive"
    rc, out, _ = nm_run(["systemctl", "is-enabled", "ssh"], timeout=5)
    if rc == 0:
        enabled = out.strip() or "enabled"
    else:
        enabled = "disabled"
    return f"{tr(active)}, {tr(enabled)}"


def ssh_switch_text() -> str:
    return "On" if ssh_status().split(",", 1)[0].strip() == "active" else "Off"


def factory_password_active() -> bool:
    """True until the factory password is changed.

    cpz-settings cannot read /etc/shadow, but its mtime is public metadata and
    every passwd/usermod/chage run updates it. The build records the original
    mtime in SECURITY_STAMP, so a match means the account still has the
    password baked into the image.
    """
    try:
        with open(SECURITY_STAMP, "r", encoding="utf-8") as handle:
            stamp = int(handle.read().strip())
        return int(os.stat("/etc/shadow").st_mtime) == stamp
    except (OSError, ValueError):
        return False


def security_issues() -> list[str]:
    """Warnings shown above the Settings menu.

    Keep this cheap and root-free: it runs when the main page is loaded.
    """
    issues = []
    if factory_password_active():
        issues.append("factory password in use")
    if ssh_status().split(",", 1)[0].strip() == "active":
        issues.append("SSH is on")
    return issues


def ntp_status() -> str:
    value = timedatectl_value("NTP").lower()
    return "On" if value in ("yes", "on", "true") else "Off"


def run_interactive(screen, command) -> int:
    curses.def_prog_mode()
    curses.endwin()
    try:
        return subprocess.call(command)
    except OSError:
        return 1
    finally:
        curses.reset_prog_mode()
        try:
            curses.curs_set(0)
        except curses.error:
            pass


def run_privileged(screen, command) -> int:
    return run_interactive(screen, ["sudo"] + command)


def message_is_error(message: str) -> bool:
    """True for result text that should stay up until the user dismisses it."""
    lowered = str(message).casefold()
    return any(marker in lowered for marker in ERROR_MARKERS)


def modal_text(message: str, width: int) -> list[str]:
    """Wrap a dialog body, keeping explicit line breaks."""
    lines: list[str] = []
    for paragraph in str(message).split("\n"):
        if not paragraph.strip():
            lines.append("")
            continue
        lines.extend(wrap_display(paragraph, max(8, width)))
    return lines or [""]


def draw_modal_frame(popup, title: str, hint: str = "", error: bool = False) -> None:
    """Draw the one CPZ dialog frame used by every modal surface.

    The title sits in the top border with one space on each side, body text
    starts one column inside the border, and the hint is muted on the last row
    inside the frame. ``error`` reverses the title for destructive actions;
    the rest of the frame does not change.
    """
    popup.erase()
    popup.attrset(0)
    popup.box()
    title = tr(title)
    hint = tr(hint)
    title_attr = MODAL_TITLE_ATTR | (curses.A_REVERSE if error else 0)
    put(popup, 0, MODAL_TEXT_COLUMN, f" {title} ", title_attr)
    if hint:
        height, width = popup.getmaxyx()
        put(
            popup,
            height - 2,
            MODAL_TEXT_COLUMN,
            text_truncate(hint, max(0, width - 2 * MODAL_TEXT_COLUMN)),
            hint_attr(),
        )


def modal_window(
    screen,
    title: str,
    message: str,
    hint: str = "",
    error: bool = False,
):
    """Draw a centred modal frame over the current screen and return it."""
    title = tr(title)
    message = tr(message)
    hint = tr(hint)
    screen_height, screen_width = screen.getmaxyx()
    available = max(10, screen_width - 4)
    body_width = min(MODAL_MAX_WIDTH, max(8, available - 4))
    hint_width = text_width(hint) + 2 * MODAL_TEXT_COLUMN if hint else 0
    body = modal_text(message, body_width)
    longest = max((text_width(line) for line in body), default=0)
    box_width = min(
        available,
        max(text_width(title) + 6, longest + 4, hint_width, 24),
    )
    body_width = max(8, box_width - 4)
    body = modal_text(message, body_width)

    hint_rows = 1 if hint else 0
    max_body_rows = max(1, screen_height - 2 - 4 - hint_rows)
    if len(body) > max_body_rows:
        body = body[:max_body_rows]
        body[-1] = text_truncate(body[-1], max(0, body_width - 3)) + "..."
    box_height = min(screen_height - 2, len(body) + hint_rows + 4)
    top = max(0, (screen_height - box_height) // 2)
    left = max(0, (screen_width - box_width) // 2)

    popup = curses.newwin(box_height, box_width, top, left)
    draw_modal_frame(popup, title, hint, error)
    for offset, line in enumerate(body):
        put(popup, 2 + offset, MODAL_TEXT_COLUMN, line)
    popup.keypad(True)
    popup.refresh()
    return popup


def close_modal(screen, popup) -> None:
    """Delete a dialog and repaint the screen content underneath it."""
    del popup
    try:
        screen.touchwin()
        screen.refresh()
    except curses.error:
        pass


def show_message(
    screen,
    message: str | None,
    title: str = "Done",
    error: bool = False,
    wait: bool = True,
) -> None:
    """Show a result message in a modal. Toasts dismiss on a timer or a key."""
    if not message:
        return
    message = tr(message)
    popup = modal_window(
        screen,
        title,
        message,
        "Enter/Esc close" if wait else "",
        error=error,
    )
    try:
        popup.timeout(-1 if wait else MODAL_TOAST_MS)
        popup.getch()
    finally:
        close_modal(screen, popup)


def notify(
    screen,
    message: str | None,
    title: str | None = None,
    error: bool | None = None,
    wait: bool | None = None,
) -> None:
    """Show an action result as a modal.

    Successes are toasts so repeated toggles keep their rhythm; errors and
    anything the caller marks as important wait for Enter/Esc.
    """
    if not message:
        return
    if error is None:
        error = message_is_error(message)
    if wait is None:
        wait = error
    if title is None:
        title = "Error" if error else "Done"
    show_message(screen, message, title, error=error, wait=wait)


def confirm(
    screen,
    question: str,
    title: str = "Confirm",
    detail: str = "",
    danger: bool = False,
) -> bool:
    message = question if not detail else f"{question}\n\n{detail}"
    message = tr(message)
    popup = modal_window(
        screen,
        title,
        message,
        "Enter/y yes  n/Esc cancel",
        error=danger,
    )
    try:
        while True:
            key = popup.getch()
            if key in (curses.KEY_ENTER, 10, 13, ord("y"), ord("Y"), *NAV_RIGHT):
                return True
            if key in (27, ord("n"), ord("N"), ord("q"), ord("Q"), *NAV_LEFT):
                return False
    finally:
        close_modal(screen, popup)


def text_input(
    screen,
    title: str,
    message: str,
    secret: bool = False,
    hint: str = "Enter accept  Esc cancel",
) -> str | None:
    """Ask for one line of text in the standard CPZ modal frame.

    ``secret`` masks the value for Wi-Fi passphrases and Bluetooth PINs; the
    value itself is never echoed by a command. Returns None when cancelled.
    """
    popup = modal_window(screen, title, message, hint)
    value = ""
    try:
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        while True:
            height, width = popup.getmaxyx()
            column = MODAL_TEXT_COLUMN
            room = max(1, width - 2 * column)
            shown = "*" * len(value) if secret else value
            row = max(2, height - 3)
            put(popup, row, column, text_pad(text_truncate(shown, room), room))
            try:
                popup.move(row, min(width - 2, column + text_width(shown)))
            except curses.error:
                pass
            popup.refresh()
            key = popup.getch()
            if key in (curses.KEY_ENTER, 10, 13):
                return value
            if key == 27:
                return None
            if key in (curses.KEY_BACKSPACE, 8, 127):
                value = value[:-1]
                continue
            if 32 <= key < 127:
                value += chr(key)
    finally:
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        close_modal(screen, popup)


def text_page(screen, title: str, lines) -> None:
    offset = 0
    while True:
        screen.erase()
        height, width = screen.getmaxyx()
        left = SCREEN_PAD
        put(screen, 0, left, tr(title), curses.A_BOLD)
        visible = max(1, height - 3)
        for index in range(visible):
            line = lines[offset + index] if offset + index < len(lines) else ""
            put(screen, 2 + index, left, tr(line))
        put(screen, height - 1, left, tr("F/X scroll PgUp/PgDn q back"), hint_attr())
        screen.refresh()
        key = screen.getch()
        if key == curses.KEY_MOUSE:
            event = read_mouse()
            if event is None:
                continue
            delta = mouse_wheel_delta(event[2])
            if delta:
                offset = max(
                    0,
                    min(max(0, len(lines) - visible), offset + delta),
                )
            continue
        if key in (ord("q"), ord("Q"), 27):
            return
        if key in NAV_UP:
            offset = max(0, offset - 1)
        elif key in NAV_DOWN:
            offset = min(max(0, len(lines) - visible), offset + 1)
        elif key == curses.KEY_PPAGE:
            offset = max(0, offset - visible)
        elif key == curses.KEY_NPAGE:
            offset = min(max(0, len(lines) - visible), offset + visible)


def value_text(
    data: dict, key: str, wifi_value: str = "", bluetooth_value: str = ""
) -> str:
    if key == "wifi":
        return wifi_value
    if key == "bluetooth":
        return bluetooth_value
    if key == "theme":
        return theme_label(data["theme"])
    if key == "clock_24h":
        return "24-hour" if data["clock_24h"] else "12-hour"
    if key == "date_format":
        return DATE_FORMAT_LABELS.get(data["date_format"], data["date_format"])
    if key == "display":
        return DISPLAY_LABELS.get(data["display"], data["display"])
    if key == "screen_timeout":
        return SCREEN_TIMEOUT_LABELS.get(data["screen_timeout"], str(data["screen_timeout"]))
    if key == "brightness":
        return f"{data['brightness']}%"
    if key in ("font_size_panel", "font_size_hdmi"):
        return f"{data[key]}px"
    if key == "status_interval":
        return f"{data['status_interval']}s"
    if key == "mode_keys":
        return data["mode_keys"]
    if key == "keyboard_layout":
        return {
            "auto": "Automatic",
            "cpz": "Built-in keyboard",
            "standard": "Standard",
        }.get(data["keyboard_layout"], data["keyboard_layout"])
    if key == "keyboard_layouts":
        return layouts_text(data)
    if key == "keyboard_layout_active":
        return layout_label(active_layout(data))
    if key == "history_limit":
        return f"{data['history_limit']:,} lines"
    return "On" if data[key] else "Off"


def nm_env() -> dict:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    return env


def nm_run(args, timeout: int = 30):
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=nm_env(),
            check=False,
        )
        return result.returncode, result.stdout.strip(), result.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, "", str(error)


def wifi_summary() -> str:
    if not shutil.which("nmcli"):
        return "no nmcli"
    rc, out, _ = nm_run(["nmcli", "-t", "-f", "WIFI", "general"])
    if rc == 0 and out.startswith("WIFI:"):
        if out.split(":", 1)[1] != "enabled":
            return "Off"
    for device in nm_devices():
        if device["type"] == "wifi":
            if device["state"] == "connected":
                return device["connection"] or "connected"
            return device["state"] or "Off"
    return "no adapter"


def refresh_connection_tokens() -> None:
    """Refresh /run/cpz-conn after a radio or connection change.

    cpz-conn-status can spend a few seconds in nmcli/bluetoothctl, so it runs
    detached; the status bar picks the new tokens up on its next tick.
    """
    executable = shutil.which("cpz-conn-status") or "/usr/local/bin/cpz-conn-status"
    if not os.access(executable, os.X_OK):
        return
    try:
        subprocess.Popen(
            [executable],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def parse_wifi_networks(text: str) -> list[dict]:
    """Turn `nmcli -t device wifi list` output into one row per SSID."""
    networks: dict[str, dict] = {}
    for line in text.splitlines():
        if not line.strip():
            continue
        fields = split_terse(line)
        if len(fields) < 4:
            continue
        in_use, signal_text, security, ssid = (
            fields[0].strip(),
            fields[1].strip(),
            fields[2].strip(),
            fields[3].strip(),
        )
        if not ssid:
            continue
        try:
            signal = max(0, min(100, int(signal_text)))
        except ValueError:
            signal = 0
        entry = {
            "ssid": ssid,
            "signal": signal,
            "security": security,
            "active": in_use == "*",
        }
        previous = networks.get(ssid)
        if previous is None or (
            entry["active"],
            entry["signal"],
        ) > (
            previous["active"],
            previous["signal"],
        ):
            networks[ssid] = entry
    return sorted(
        networks.values(),
        key=lambda item: (
            not item["active"],
            -item["signal"],
            item["ssid"].lower(),
        ),
    )


def wifi_networks(scan: bool = False) -> tuple[list[dict], str]:
    command = [
        "nmcli",
        "-t",
        "-f",
        "IN-USE,SIGNAL,SECURITY,SSID",
        "device",
        "wifi",
        "list",
    ]
    if scan:
        command.extend(["--rescan", "yes"])
    rc, out, err = nm_run(command, timeout=30)
    if rc != 0:
        return [], error_line(err or out) or "Cannot list Wi-Fi networks"
    return parse_wifi_networks(out), ""


def wifi_saved_networks() -> set[str]:
    rc, out, _ = nm_run(
        ["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], timeout=10
    )
    if rc != 0:
        return set()
    saved = set()
    for line in out.splitlines():
        fields = split_terse(line)
        if len(fields) >= 2 and fields[1] in ("802-11-wireless", "wifi"):
            saved.add(fields[0])
    return saved


def wifi_interface() -> str:
    for device in nm_devices():
        if device["type"] == "wifi":
            return device["device"]
    return ""


def wifi_radio_enabled() -> bool:
    rc, out, _ = nm_run(["nmcli", "-t", "-f", "WIFI", "general"], timeout=6)
    return rc == 0 and out.split(":", 1)[-1].strip() == "enabled"


def wifi_prepare(screen) -> str:
    """Clear rfkill and switch the NetworkManager radio on before the list."""
    if wifi_radio_enabled():
        return ""
    rc = run_privileged(screen, ["/usr/local/bin/cpz-wifi", "--prepare"])
    if rc != 0 or not wifi_radio_enabled():
        return "Cannot enable Wi-Fi"
    refresh_connection_tokens()
    return ""


def wifi_set_radio(screen, enabled: bool) -> str:
    if enabled:
        return wifi_prepare(screen)
    rc, out, err = nm_run(["nmcli", "radio", "wifi", "off"], timeout=10)
    refresh_connection_tokens()
    return "" if rc == 0 else (error_line(err or out) or "Cannot disable Wi-Fi")


def wifi_connect(screen, network: dict) -> str | None:
    """Connect or disconnect one network. None means the user cancelled."""
    ssid = network["ssid"]
    if network["active"]:
        interface = wifi_interface()
        if not interface:
            return "No Wi-Fi interface"
        rc, out, err = nm_run(
            ["nmcli", "device", "disconnect", interface], timeout=20
        )
        return "" if rc == 0 else (error_line(err or out) or "Cannot disconnect")

    saved = wifi_saved_networks()
    if ssid in saved:
        command = ["nmcli", "connection", "up", "id", ssid]
    elif network["security"] in ("", "--"):
        command = ["nmcli", "device", "wifi", "connect", ssid]
    else:
        password = text_input(
            screen,
            "Wi-Fi password",
            tr("Network: {name}", name=ssid),
            secret=True,
            hint="Enter connect  Esc cancel",
        )
        if password is None:
            return None
        if not password:
            return "Password is required"
        command = [
            "nmcli",
            "device",
            "wifi",
            "connect",
            ssid,
            "password",
            password,
        ]
    rc, out, err = nm_run(command, timeout=45)
    refresh_connection_tokens()
    return "" if rc == 0 else (error_line(err or out) or "Cannot connect")


def wifi_forget(screen, ssid: str) -> str | None:
    if ssid not in wifi_saved_networks():
        return tr("Network is not saved")
    if not confirm(
        screen,
        tr("Forget {name}?", name=ssid),
        title="Wi-Fi",
        danger=True,
    ):
        return None
    rc, out, err = nm_run(
        ["nmcli", "connection", "delete", "id", ssid], timeout=20
    )
    return "" if rc == 0 else (error_line(err or out) or "Cannot forget network")


def wifi_action(screen, _data) -> None:
    """Open the shared radio manager on its Wi-Fi list."""
    radio_manager_screen(screen, "wifi")


ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def clean_output(text: str) -> str:
    return ANSI_RE.sub("", text or "").strip()


def first_line(text: str) -> str:
    for line in clean_output(text).splitlines():
        line = line.strip()
        if line:
            return line
    return ""


def error_line(text: str) -> str:
    lines = [line.strip() for line in clean_output(text).splitlines() if line.strip()]
    for line in lines:
        low = line.lower()
        if any(
            word in low
            for word in ("fail", "error", "not available", "not authorized", "denied")
        ):
            return line
    return lines[-1] if lines else ""


def bt_env() -> dict:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    env["NO_COLOR"] = "1"
    return env


def bt_run(args, timeout: int = 20):
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=bt_env(),
            check=False,
        )
        return (
            result.returncode,
            clean_output(result.stdout),
            clean_output(result.stderr),
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return 1, "", clean_output(str(error))


def bt_adapter() -> dict:
    if not shutil.which("bluetoothctl"):
        return {"name": "", "mac": "", "powered": False, "error": "no bluetoothctl"}
    rc, out, err = bt_run(["bluetoothctl", "show"], timeout=6)
    mac = ""
    name = ""
    powered = False
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("Controller "):
            parts = line.split()
            if len(parts) > 1:
                mac = parts[1]
        elif line.startswith("Name:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("Alias:") and not name:
            name = line.split(":", 1)[1].strip()
        elif line.startswith("Powered:"):
            powered = line.split(":", 1)[1].strip().lower() == "yes"
    if not mac:
        return {
            "name": "",
            "mac": "",
            "powered": False,
            "error": first_line(err or out) or "no adapter",
        }
    return {"name": name or mac, "mac": mac, "powered": powered, "error": ""}


def bt_device_lines(command: str) -> list[tuple[str, str]]:
    """Return (mac, name) from `bluetoothctl devices [command]`."""
    rc, out, _ = bt_run(["bluetoothctl", "devices"] + command.split(), timeout=6)
    if rc != 0:
        return []
    devices = []
    for line in out.splitlines():
        if not line.startswith("Device "):
            continue
        rest = line[len("Device ") :].strip()
        mac, _, name = rest.partition(" ")
        mac = mac.strip()
        if mac:
            devices.append((mac, name.strip()))
    return devices


def bt_devices() -> list[dict]:
    if not shutil.which("bluetoothctl"):
        return []
    # `devices`, `devices Connected`, `devices Paired` and `devices Trusted`
    # are four cheap calls. The previous implementation ran `bluetoothctl
    # info` once per device, so the Settings page could block for seconds on a
    # busy adapter.
    named = dict(bt_device_lines(""))
    if not named:
        return []
    connected = {mac for mac, _name in bt_device_lines("Connected")}
    paired = {mac for mac, _name in bt_device_lines("Paired")}
    trusted = {mac for mac, _name in bt_device_lines("Trusted")}
    devices = [
        {
            "mac": mac,
            "name": name or mac,
            "paired": mac in paired,
            "connected": mac in connected,
            "trusted": mac in trusted,
        }
        for mac, name in named.items()
    ]
    devices.sort(
        key=lambda device: (
            not device["connected"],
            not device["paired"],
            str(device["name"]).lower(),
        )
    )
    return devices


def bluetooth_summary() -> str:
    if not shutil.which("bluetoothctl"):
        return "no bluetoothctl"
    adapter = bt_adapter()
    if adapter["error"]:
        return "no adapter" if "no adapter" in adapter["error"].lower() else "unavailable"
    if not adapter["powered"]:
        return "Off"
    devices = bt_devices()
    connected = [device["name"] for device in devices if device["connected"]]
    if connected:
        return connected[0]
    paired = sum(1 for device in devices if device["paired"])
    if paired:
        return tr("{count} paired", count=paired)
    return "On"


def bluetooth_info() -> str:
    """One-line Bluetooth status for the Connections page.

    Mirrors wifi_info(): current device or radio state, then one short detail.
    """
    if not shutil.which("bluetoothctl"):
        return tr("no bluetoothctl")
    adapter = bt_adapter()
    if adapter["error"]:
        return tr("no adapter") if "no adapter" in adapter["error"].lower() else tr("unavailable")
    if not adapter["powered"]:
        return tr("Off")
    devices = bt_devices()
    connected = [device for device in devices if device["connected"]]
    if connected:
        return f"{connected[0]['name']} - {tr('connected')}"
    paired = sum(1 for device in devices if device["paired"])
    if paired:
        return f"{tr('{count} paired', count=paired)} - {adapter['name']}"
    return f"{tr('On')} - {adapter['name']}"


def bt_set_radio(screen, enabled: bool) -> str:
    """Unblock/ power the adapter through the narrow sudo helper."""
    rc = run_privileged(
        screen,
        [
            "/usr/local/bin/cpz-bt-unblock",
            "on" if enabled else "off",
        ],
    )
    if rc == 0:
        refresh_connection_tokens()
        return ""
    return "Cannot enable Bluetooth" if enabled else "Cannot disable Bluetooth"


def bt_start_scan():
    """Start an eight-second BlueZ discovery, or None when unavailable."""
    if not shutil.which("bluetoothctl"):
        return None
    try:
        return subprocess.Popen(
            ["bluetoothctl", "--timeout", "8", "scan", "on"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        return None


def bt_command(arguments: list[str], timeout: int = 30) -> str:
    rc, out, err = bt_run(["bluetoothctl", *arguments], timeout=timeout)
    refresh_connection_tokens()
    return "" if rc == 0 else (error_line(err or out) or "Bluetooth operation failed")


def bt_pair_command(mac: str) -> str:
    """Pair through the non-interactive agent used by the headless image.

    Just Works and numeric-comparison devices need no terminal UI. A device
    that demands a typed PIN is not handled by this one-screen flow; pair it
    from a terminal with bluetoothctl or bluetuith.
    """
    rc, out, err = bt_run(
        ["bluetoothctl", "-a", "NoInputNoOutput", "pair", mac],
        timeout=40,
    )
    refresh_connection_tokens()
    return "" if rc == 0 else (error_line(err or out) or "Cannot pair device")


def radio_manager_screen(screen, mode: str) -> None:
    """One borderless list for Wi-Fi and Bluetooth.

    Both radios share the same layout: one header, a control line with the
    current connect/power actions, a scrolling list and a single footer that
    carries the remaining key hints on the left and the scan or operation
    status on the right.
    """
    wifi = mode == "wifi"
    title = tr("Wi-Fi") if wifi else tr("Bluetooth")
    networks: list[dict] = []
    devices: list[dict] = []
    saved: set[str] = set()
    selected = 0
    offset = 0
    status = ""
    summary = ""
    adapter = ""
    radio_on = False
    scan_process = None
    scan_until = 0.0

    if wifi:
        status = wifi_prepare(screen)
        networks, error = wifi_networks()
        if error:
            status = error
        saved = wifi_saved_networks()
        adapter = wifi_interface()
        summary = tr(wifi_summary())
        radio_on = wifi_radio_enabled()
    else:
        status = bt_set_radio(screen, True)
        devices = bt_devices()
        info = bt_adapter()
        adapter = "" if info["error"] else info["name"]
        radio_on = bool(info["powered"])
        summary = tr(bluetooth_summary())

    def refresh() -> None:
        nonlocal networks, devices, saved, summary, adapter, radio_on
        if wifi:
            networks, _error = wifi_networks()
            saved = wifi_saved_networks()
            adapter = wifi_interface()
            summary = tr(wifi_summary())
            radio_on = wifi_radio_enabled()
        else:
            devices = bt_devices()
            info = bt_adapter()
            adapter = "" if info["error"] else info["name"]
            radio_on = bool(info["powered"])
            summary = tr(bluetooth_summary())

    def draw() -> None:
        nonlocal selected, offset
        rows = networks if wifi else devices
        screen.erase()
        height, width = screen.getmaxyx()
        left = SCREEN_PAD
        cw = content_width(width)
        header = title + (f"  {adapter}" if adapter else "")
        put(screen, 0, left, text_truncate(header, cw), curses.A_BOLD)

        controls = []
        if rows:
            if wifi:
                action = "Disconnect" if rows[selected]["active"] else "Connect"
            elif rows[selected]["connected"]:
                action = "Disconnect"
            elif rows[selected]["paired"]:
                action = "Connect"
            else:
                action = "Pair"
            controls.append(f"[Enter] {tr(action)}")
        controls.append(f"[o] {tr('Turn off' if radio_on else 'Turn on')}")
        put(
            screen,
            1,
            left,
            text_pad(text_truncate("   ".join(controls), cw), cw),
            hint_attr(),
        )

        visible = max(1, height - 3)
        selected = max(0, min(selected, len(rows) - 1))
        if selected < offset:
            offset = selected
        elif selected >= offset + visible:
            offset = selected - visible + 1
        offset = max(0, min(offset, max(0, len(rows) - visible)))

        for row in range(visible):
            index = offset + row
            if index >= len(rows):
                break
            item = rows[index]
            if wifi:
                name = item["ssid"]
                parts = []
                if cw >= 44 and item["security"] not in ("", "--"):
                    parts.append(item["security"])
                if cw >= 34 and item["signal"]:
                    parts.append(f"{item['signal']}%")
                if item["active"]:
                    parts.append(tr("connected"))
                elif item["ssid"] in saved:
                    parts.append(tr("saved"))
                detail = "  ".join(parts)
            else:
                name = item["name"]
                if item["connected"]:
                    detail = tr("connected")
                elif item["paired"]:
                    detail = tr("paired")
                else:
                    detail = tr("new")
                if cw >= 46 and item["trusted"] and not item["connected"]:
                    detail += "  " + tr("trusted")

            room = max(2, cw - 2)
            if cw < 32:
                detail = ""
            detail = text_truncate(detail, max(0, room // 2))
            name_room = max(1, room - text_width(detail) - 1)
            line = f"{'>' if index == selected else ' '} " + text_pad(
                text_truncate(name, name_room), name_room
            )
            if detail:
                line += detail
            put(
                screen,
                2 + row,
                left,
                text_pad(line, cw),
                curses.A_REVERSE if index == selected else 0,
            )

        if not rows:
            message = (
                "No networks. Press s to scan."
                if wifi
                else "No devices. Press s to scan."
            )
            put(screen, 2, left, tr(message))

        if wifi:
            parts = [tr("s scan")]
            if rows and rows[selected]["ssid"] in saved:
                parts.append(tr("d forget"))
            parts.append(tr("q back"))
        else:
            parts = [tr("s stop" if scan_process is not None else "s scan")]
            if rows:
                parts.append(tr("d remove"))
            parts.append(tr("q back"))

        right = text_truncate(
            tr(status or summary), max(6, min(18, cw // 3))
        )
        room = max(0, cw - text_width(right) - 2) if right else cw
        chosen: list[str] = []
        for part in parts:
            candidate = " ".join(chosen + [part])
            if text_width(candidate) <= room:
                chosen.append(part)
            else:
                break
        footer = " ".join(chosen)
        if not footer and parts:
            footer = text_truncate(parts[0], room)
        if right:
            put(
                screen,
                height - 1,
                left + max(0, cw - text_width(right)),
                right,
                hint_attr(),
            )
        put(screen, height - 1, left, footer, hint_attr())
        screen.refresh()

    while True:
        if not wifi and scan_process is not None:
            if (
                time.monotonic() >= scan_until
                or scan_process.poll() is not None
            ):
                scan_process = None
                status = tr("Scan complete")
                refresh()
            else:
                status = tr("Scanning...")
                devices = bt_devices()
        rows = networks if wifi else devices
        draw()
        screen.timeout(1000 if scan_process is not None else -1)
        key = screen.getch()
        if key == -1:
            continue
        if key == curses.KEY_MOUSE:
            event = read_mouse()
            if event is None:
                continue
            delta = mouse_wheel_delta(event[2])
            if delta:
                selected = max(0, min(len(rows) - 1, selected + delta))
            continue
        if key in (ord("q"), ord("Q"), 27):
            break
        if key in NAV_UP:
            selected = max(0, selected - 1)
            continue
        if key in NAV_DOWN:
            selected = min(max(0, len(rows) - 1), selected + 1)
            continue
        if key == curses.KEY_PPAGE:
            selected = max(0, selected - max(1, screen.getmaxyx()[0] - 3))
            continue
        if key == curses.KEY_NPAGE:
            selected = min(
                max(0, len(rows) - 1),
                selected + max(1, screen.getmaxyx()[0] - 3),
            )
            continue
        if key == curses.KEY_HOME:
            selected = 0
            continue
        if key == curses.KEY_END:
            selected = max(0, len(rows) - 1)
            continue
        if key == ord("s"):
            if wifi:
                status = tr("Scanning...")
                draw()
                networks, error = wifi_networks(scan=True)
                saved = wifi_saved_networks()
                summary = tr(wifi_summary())
                status = error or tr("Scan complete")
                selected = offset = 0
            elif scan_process is not None:
                scan_process.terminate()
                scan_process = None
                status = tr("Scan stopped")
            else:
                scan_process = bt_start_scan()
                if scan_process is None:
                    status = tr("Cannot start scan")
                else:
                    scan_until = time.monotonic() + 8
                    status = tr("Scanning...")
            continue
        if key == ord("r"):
            refresh()
            status = ""
            selected = offset = 0
            continue
        if key == ord("o"):
            if wifi:
                enabled = not wifi_radio_enabled()
                status = wifi_set_radio(screen, enabled) or tr(
                    "Wi-Fi on" if enabled else "Wi-Fi off"
                )
            else:
                info = bt_adapter()
                enabled = not info["powered"]
                status = bt_set_radio(screen, enabled) or tr(
                    "Bluetooth on" if enabled else "Bluetooth off"
                )
            refresh()
            selected = offset = 0
            continue
        if not rows:
            continue
        device = rows[selected]
        if wifi:
            if key in (curses.KEY_ENTER, 10, 13):
                status = tr("Connecting...") if not device["active"] else ""
                draw()
                result = wifi_connect(screen, device)
                if result is not None:
                    if result:
                        notify(screen, result, title="Wi-Fi")
                    status = result or tr("Connected")
                    refresh()
                else:
                    status = ""
            elif key == ord("d"):
                result = wifi_forget(screen, device["ssid"])
                if result is not None:
                    if result:
                        notify(screen, result, title="Wi-Fi")
                    status = result or tr("Network forgotten")
                    refresh()
            continue

        mac = device["mac"]
        if key in (curses.KEY_ENTER, 10, 13):
            if device["connected"]:
                status = tr("Disconnecting...")
                draw()
                status = bt_command(["disconnect", mac], 20) or tr("Disconnected")
            elif device["paired"]:
                status = tr("Connecting...")
                draw()
                status = bt_command(["connect", mac], 30) or tr("Connected")
            else:
                status = tr("Pairing...")
                draw()
                status = bt_pair_command(mac)
                if not status:
                    status = bt_command(["connect", mac], 30) or tr("Paired")
            refresh()
            continue
        if key == ord("p"):
            status = tr("Pairing...")
            draw()
            status = bt_pair_command(mac) or tr("Paired")
            refresh()
            continue
        if key == ord("t"):
            if device["trusted"]:
                status = bt_command(["untrust", mac], 20) or tr("Untrusted")
            else:
                status = bt_command(["trust", mac], 20) or tr("Trusted")
            refresh()
            continue
        if key == ord("d"):
            if confirm(
                screen,
                tr("Remove {name}?", name=device["name"]),
                title="Bluetooth",
                danger=True,
            ):
                status = bt_command(["remove", mac], 20) or tr("Removed")
                refresh()

    if scan_process is not None:
        scan_process.terminate()
        scan_process = None
    screen.timeout(-1)


def bt_action(screen, _data) -> None:
    """Open the shared radio manager on its Bluetooth list."""
    radio_manager_screen(screen, "bluetooth")


def content_width(width: int) -> int:
    """Columns available to a full-screen page after the side padding."""
    return max(1, width - 2 * SCREEN_PAD)


def char_width(char: str) -> int:
    """Terminal cell width of one character, matching curses/foot."""
    if not char:
        return 0
    if unicodedata.combining(char):
        return 0
    return 2 if unicodedata.east_asian_width(char) in ("W", "F") else 1


def text_width(text: object) -> int:
    return sum(char_width(char) for char in str(text))


def text_truncate(text: object, width: int) -> str:
    """Cut text to a terminal-cell width, never splitting a wide glyph."""
    value = str(text)
    if text_width(value) <= width:
        return value
    used = 0
    out = []
    for char in value:
        cells = char_width(char)
        if used + cells > width:
            break
        out.append(char)
        used += cells
    return "".join(out)


def text_pad(text: object, width: int) -> str:
    value = text_truncate(text, width)
    return value + " " * max(0, width - text_width(value))


def wrap_display(text: object, width: int) -> list[str]:
    """Wrap text to terminal cells, preferring spaces but allowing CJK breaks."""
    width = max(1, width)
    lines: list[str] = []
    current: list[str] = []
    cells = 0
    last_space = -1
    for char in str(text):
        cells_here = char_width(char)
        if cells + cells_here > width and current:
            if last_space >= 0:
                lines.append("".join(current[:last_space]).rstrip())
                rest = "".join(current[last_space + 1 :]).lstrip()
                current = list(rest)
                cells = text_width(rest)
                last_space = -1
            else:
                lines.append("".join(current).rstrip())
                current = []
                cells = 0
        current.append(char)
        cells += cells_here
        if char == " ":
            last_space = len(current) - 1
    lines.append("".join(current).rstrip())
    return lines or [""]


def put(screen, y: int, x: int, text: str, attr: int = 0) -> None:
    height, width = screen.getmaxyx()
    if y < 0 or y >= height or x < 0 or x >= width:
        return
    try:
        screen.addstr(y, x, text_truncate(text, max(0, width - x - 1)), attr)
    except curses.error:
        pass


_HINT_ATTR: int | None = None
_HINT_PAIR = 1


def hint_attr() -> int:
    """Muted colour for key hints, matching Search's footer.

    Search draws its footer with palette slot 8 (``preview-fg:8``), the theme's
    muted colour. Full-page footers and dialog hints use the same slot so the
    help line has one treatment across the UI. Consoles without enough colours
    keep the older dim attribute as a fallback.
    """
    global _HINT_ATTR
    if _HINT_ATTR is not None:
        return _HINT_ATTR
    _HINT_ATTR = curses.A_DIM
    try:
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            if curses.COLORS > 8:
                curses.init_pair(_HINT_PAIR, 8, -1)
                _HINT_ATTR = curses.color_pair(_HINT_PAIR)
    except curses.error:
        pass
    return _HINT_ATTR


def enable_mouse() -> None:
    """Ask the terminal for click and wheel events.

    tmux forwards them to the pane only when the pane application enables the
    xterm mouse protocol. Settings enables it for its whole run, so nested
    pickers and the Applications/Bluetooth lists share the same stream.
    """
    try:
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        curses.mouseinterval(200)
    except curses.error:
        pass


def read_mouse() -> tuple[int, int, int] | None:
    try:
        _id, x, y, _z, bstate = curses.getmouse()
    except curses.error:
        return None
    return x, y, bstate


def mouse_wheel_delta(bstate: int) -> int:
    if bstate & (MOUSE_BUTTON4_PRESSED | MOUSE_BUTTON4_CLICKED):
        return -3
    if bstate & (MOUSE_BUTTON5_PRESSED | MOUSE_BUTTON5_CLICKED):
        return 3
    return 0


def read_wheel_key() -> int | None:
    """Translate a wheel event into the list navigation key it represents."""
    event = read_mouse()
    if event is None:
        return None
    delta = mouse_wheel_delta(event[2])
    if delta < 0:
        return curses.KEY_UP
    if delta > 0:
        return curses.KEY_DOWN
    return None


def page_geometry(selected: int, count: int, height: int) -> tuple[int, int, int]:
    """Return (top row, visible rows, first item) for a Settings page."""
    top = 2
    visible = max(1, height - 1 - top)
    first = 0
    if selected >= visible:
        first = selected - visible + 1
    first = max(0, min(first, max(0, count - visible)))
    return top, visible, first


def page_row_at(
    y: int, top: int, first: int, visible: int, count: int
) -> int | None:
    if y < top or y >= top + visible:
        return None
    row = first + (y - top)
    if 0 <= row < count:
        return row
    return None


def item_choices(item: dict) -> tuple:
    values = item.get("values")
    if callable(values):
        values = values()
    return tuple(values or ())


def item_choice_labels(item: dict) -> dict:
    labels = item.get("labels")
    if callable(labels):
        labels = labels()
    return labels or {}


def item_current_choice(item: dict, data: dict):
    current = item.get("current")
    if callable(current):
        return current(data)
    key = item.get("key")
    return data.get(key) if key else None


def item_value(item: dict, data: dict) -> str:
    getter = item.get("get")
    if getter:
        try:
            return str(getter(data))
        except Exception:
            return "?"
    key = item.get("key")
    if not key:
        return ""
    kind = item.get("kind")
    if kind in ("picker", "scale"):
        current = item_current_choice(item, data)
        return item_choice_labels(item).get(current, str(current))
    return value_text(data, key)


def item_change(item: dict, data: dict, step: int, screen) -> None:
    if item.get("change"):
        item["change"](data, step, screen)
        return
    key = item.get("key")
    if item.get("kind") == "scale" and item.get("set"):
        values = item_choices(item)
        current = item_current_choice(item, data)
        index = values.index(current) if current in values else 0
        apply_choice(item, data, values[(index + step) % len(values)], screen)
        return
    if not key:
        return
    if item.get("kind") == "toggle":
        data[key] = 0 if data[key] else 1
    elif item.get("kind") == "scale":
        values = item_choices(item)
        current = data.get(key)
        index = values.index(current) if current in values else 0
        data[key] = values[(index + step) % len(values)]
    else:
        return
    save_settings(data)
    apply_live(data, key)
    if key in ("keyboard_layout", "keyboard_layout_active"):
        reload_keyboard_layout(screen)


def sound_volume_text(kind: str) -> str:
    percent, _muted = wpctl_status(kind)
    if percent is None:
        return "Not available"
    return f"{percent}%"


def sound_volume_current(kind: str) -> int | None:
    percent, _muted = wpctl_status(kind)
    return percent


def sound_volume_set(kind: str):
    def set_volume(_data: dict, value, _screen) -> None:
        wpctl_set_volume(kind, int(value))

    return set_volume


def sound_mute_text(kind: str) -> str:
    percent, muted = wpctl_status(kind)
    if percent is None:
        return "Not available"
    return "Muted" if muted else "Not muted"


def sound_device_text(kind: str) -> str:
    nodes = wpctl_nodes(kind.capitalize())
    if not nodes:
        return "Not available"
    for _node_id, name, default in nodes:
        if default:
            return name
    return nodes[0][1]


def sound_device_choices(kind: str) -> tuple[str, ...]:
    nodes = wpctl_nodes(kind.capitalize())
    return tuple(str(node_id) for node_id, _name, _default in nodes)


def sound_device_labels(kind: str) -> dict[str, str]:
    nodes = wpctl_nodes(kind.capitalize())
    return {str(node_id): name for node_id, name, _default in nodes}


def sound_device_current(kind: str) -> str | None:
    nodes = wpctl_nodes(kind.capitalize())
    for node_id, _name, default in nodes:
        if default:
            return str(node_id)
    return str(nodes[0][0]) if nodes else None


def sound_device_set(kind: str):
    def set_default(_data: dict, value, _screen) -> None:
        wpctl_set_default(kind.capitalize(), value)

    return set_default


def hdmi_status_text() -> str:
    for path in glob.glob("/sys/class/drm/card*-HDMI-A-*/status"):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                return handle.read().strip()
        except OSError:
            continue
    return "no HDMI"


def hdmi_edid_size() -> int:
    size = 0
    for path in glob.glob("/sys/class/drm/card*-HDMI-A-*/edid"):
        try:
            size = max(size, os.path.getsize(path))
        except OSError:
            continue
    return size


def hdmi_pinned() -> bool:
    """True when cmdline.txt pins a real HDMI mode (video=HDMI-A-N:WxH@R)."""
    try:
        with open("/proc/cmdline", encoding="utf-8") as fh:
            tokens = fh.read().split()
    except OSError:
        return False
    for token in tokens:
        if not token.startswith("video=HDMI-A-"):
            continue
        _, _, mode = token.partition(":")
        if "x" in mode:
            return True
    return False


def hdmi_ready() -> bool:
    return hdmi_status_text() == "connected" and (
        hdmi_edid_size() >= 128 or hdmi_pinned()
    )


def active_output_text(data: dict) -> str:
    # Mirrors the policy in cpz-cage-output.
    connected = hdmi_status_text() == "connected"
    mode = data.get("display", "auto")
    if mode == "panel":
        return "CPZ panel (HDMI off)"
    if mode == "hdmi":
        return "HDMI" if connected else "CPZ panel (no HDMI)"
    if hdmi_ready():
        return "HDMI (panel off)"
    if connected:
        return "CPZ panel (HDMI has no EDID)"
    return "CPZ panel"


def autologin_status() -> str:
    path = "/etc/systemd/system/getty.target.wants/getty@tty1.service"
    return "enabled (cage)" if os.path.exists(path) else "disabled"


def disk_info(path: str) -> str:
    try:
        usage = shutil.disk_usage(path)
    except OSError:
        return "n/a"
    total = usage.total // (1024**3)
    free = usage.free // (1024**3)
    return tr("{free}G free / {total}G", free=free, total=total)


def event_sysfs(event: str) -> str:
    return f"/sys/class/input/{os.path.basename(event)}"


def typing_keyboard(event: str) -> bool:
    """True when the event node has udev's full-keyboard key mask."""
    try:
        with open(
            f"{event_sysfs(event)}/device/capabilities/key",
            "r",
            encoding="utf-8",
        ) as handle:
            words = handle.read().split()
    except OSError:
        return False
    # udev's input_id marks ID_INPUT_KEYBOARD when keycodes 1..31 (ESC, the
    # number row and Q to D) are present; that is 0xfffffffe in the low word.
    return bool(words) and words[-1].lower().endswith("fffffffe")


def usb_keyboard_present_fallback() -> bool:
    """Host fallback when cpz-keyboard-layout is not installed."""
    internal_link = "/dev/input/cardputer-zero-internal"
    internal_target = (
        os.path.realpath(internal_link) if os.path.islink(internal_link) else ""
    )
    for event in glob.glob("/dev/input/event*"):
        if internal_target and os.path.realpath(event) == internal_target:
            continue
        try:
            with open(
                f"{event_sysfs(event)}/device/id/bustype",
                "r",
                encoding="utf-8",
            ) as handle:
                bustype = handle.read().strip().lower()
        except OSError:
            continue
        # BUS_I2C: the Cardputer's TCA8418 keyboard.
        if bustype == "0018" or "/3f804000.i2c" in os.path.realpath(
            f"{event_sysfs(event)}/device"
        ):
            continue
        name = ""
        try:
            with open(
                f"{event_sysfs(event)}/device/name",
                "r",
                encoding="utf-8",
            ) as handle:
                name = handle.read().strip().lower()
        except OSError:
            pass
        if any(
            word in name
            for word in ("tca8418", "m5stack", "cardputerzero", "cardputer zero")
        ):
            continue
        if not typing_keyboard(event):
            continue
        # BUS_USB, BUS_BLUETOOTH, BUS_I8042.
        if bustype in ("0003", "0005", "0011"):
            return True
    return False


def usb_keyboard_present() -> bool:
    helper = "/usr/local/bin/cpz-keyboard-layout"
    if os.path.exists(helper):
        rc, out, _ = nm_run([helper, "--detect"], timeout=5)
        if rc == 0:
            return out.splitlines()[:1] == ["external"]
    return usb_keyboard_present_fallback()


def cpu_temperature() -> str:
    for path in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
        try:
            with open(path, "r", encoding="utf-8") as handle:
                value = int(handle.read().strip()) / 1000
            return tr("{value} C", value=f"{value:.1f}")
        except (OSError, ValueError):
            continue
    return "n/a"


def memory_info() -> str:
    try:
        values = {}
        with open("/proc/meminfo", "r", encoding="utf-8") as handle:
            for line in handle:
                key, raw = line.split(":", 1)
                values[key] = int(raw.split()[0])
        total = values["MemTotal"] // 1024
        available = values["MemAvailable"] // 1024
        return tr(
            "{used}M used / {total}M",
            used=total - available,
            total=total,
        )
    except (OSError, KeyError, ValueError):
        return "n/a"


def uptime_info() -> str:
    try:
        with open("/proc/uptime", "r", encoding="utf-8") as handle:
            seconds = int(float(handle.read().split()[0]))
    except (OSError, ValueError):
        return "n/a"
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes = seconds // 60
    if days:
        return tr(
            "{days}d {hours}h {minutes}m",
            days=days,
            hours=hours,
            minutes=minutes,
        )
    return tr("{hours}h {minutes}m", hours=hours, minutes=minutes)


def load_info() -> str:
    try:
        with open("/proc/loadavg", "r", encoding="utf-8") as handle:
            return " ".join(handle.read().split()[:3])
    except OSError:
        return "n/a"


