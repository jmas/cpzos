def power_action(action: str, question: str, title: str):
    def run(screen, _data) -> None:
        danger = action in ("poweroff", "reboot")
        if not confirm(screen, question, title=title, danger=danger):
            return
        # logind allows the active local seat to reboot/power off/suspend
        # without a password. Fall back to sudo only if polkit denies it.
        if run_interactive(screen, ["systemctl", action]) != 0:
            run_privileged(screen, ["systemctl", action])

    return run


