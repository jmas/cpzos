def reload_keyboard_layout(screen) -> int:
    # The helper is allowlisted in /etc/sudoers.d/50-cpz-layout, so this is
    # normally passwordless; without the rule sudo prompts like other actions.
    return run_privileged(screen, ["/usr/local/bin/cpz-layout-apply"])


def keyboard_layout_change(data: dict, step: int, screen) -> None:
    values = ("auto", "cpz", "standard")
    current = data.get("keyboard_layout", "auto")
    index = values.index(current) if current in values else 0
    data["keyboard_layout"] = values[(index + step) % len(values)]
    save_settings(data)
    reload_keyboard_layout(screen)


def draw_layouts(screen, data: dict, selected: int, notice: str) -> None:
    screen.erase()
    height, width = screen.getmaxyx()
    put(screen, 0, 0, " Layouts", curses.A_BOLD)
    put(screen, 1, 0, "-" * max(0, width - 1))

    enabled = set(layout_codes(data))
    active = active_layout(data)
    top = 2
    visible = max(1, height - 5)
    first = 0
    if selected >= visible:
        first = selected - visible + 1
    first = max(0, min(first, max(0, len(LAYOUTS) - visible)))

    for offset, (code, label) in enumerate(LAYOUTS[first : first + visible]):
        row = first + offset
        mark = "[x]" if code in enabled else "[ ]"
        suffix = "  Active" if code == active else ""
        text = f"{'>' if row == selected else ' '} {mark} {label[:26]:<26}{suffix}"
        attr = curses.A_REVERSE if row == selected else 0
        put(screen, top + offset, 0, text.ljust(max(0, width - 1)), attr)

    if first > 0:
        put(screen, 1, width - 2, "^")
    if first + visible < len(LAYOUTS):
        put(screen, 1, width - 2, "v" if first == 0 else "*")

    put(screen, height - 3, 0, " Up/Down move  PgUp/PgDn  Space toggle")
    put(screen, height - 2, 0, " Alt+Space switches  q back")
    if notice:
        put(screen, height - 1, 0, f" {notice}")
    screen.refresh()


def layouts_screen(screen, data: dict) -> None:
    active = active_layout(data)
    selected = next(
        (index for index, (code, _label) in enumerate(LAYOUTS) if code == active),
        0,
    )
    notice = ""
    changed = False

    while True:
        draw_layouts(screen, data, selected, notice)
        key = screen.getch()
        notice = ""

        if key in (ord("q"), ord("Q"), 27):
            if changed:
                reload_keyboard_layout(screen)
            return
        if key in NAV_UP:
            selected = (selected - 1) % len(LAYOUTS)
            continue
        if key in NAV_DOWN:
            selected = (selected + 1) % len(LAYOUTS)
            continue
        page = max(1, screen.getmaxyx()[0] - 5)
        if key in (curses.KEY_PPAGE,):
            selected = max(0, selected - page)
            continue
        if key in (curses.KEY_NPAGE,):
            selected = min(len(LAYOUTS) - 1, selected + page)
            continue
        if key in (curses.KEY_HOME, ord("g")):
            selected = 0
            continue
        if key in (curses.KEY_END, ord("G")):
            selected = len(LAYOUTS) - 1
            continue
        if key not in (ord(" "), 10, 13):
            continue

        code, label = LAYOUTS[selected]
        enabled = layout_codes(data)
        if code in enabled:
            if len(enabled) == 1:
                notice = "keep at least one layout"
                continue
            enabled.remove(code)
        else:
            enabled.append(code)
        data["keyboard_layouts"] = ",".join(normalize_layouts(",".join(enabled)))
        data["keyboard_layout_active"] = active_layout(data)
        save_settings(data)
        changed = True
        notice = f"{label}: {'On' if code in enabled else 'Off'}"


