def ssh_toggle(screen, _data) -> str | None:
    status = ssh_status()
    active = status.split(",", 1)[0].strip() == "active"
    if active:
        run_privileged(screen, ["systemctl", "disable", "--now", "ssh.socket"])
        rc = run_privileged(screen, ["systemctl", "disable", "--now", "ssh"])
        return None if rc == 0 else "SSH change failed"

    # Host keys are generated at build time only when SSH starts enabled. A
    # fresh image starts with ssh off, so create them on the first enable.
    rc = run_privileged(screen, ["ssh-keygen", "-A"])
    if rc != 0:
        return "SSH key generation failed"
    run_privileged(screen, ["systemctl", "disable", "--now", "ssh.socket"])
    rc = run_privileged(screen, ["systemctl", "enable", "--now", "ssh"])
    return None if rc == 0 else "SSH change failed"


def ntp_toggle(screen, _data) -> str | None:
    current = timedatectl_value("NTP").lower()
    target = "false" if current == "yes" else "true"
    rc = run_privileged(screen, ["timedatectl", "set-ntp", target])
    return None if rc == 0 else "Time sync change failed"


def ssh_toggle_change(_data, _step, screen) -> None:
    result = ssh_toggle(screen, _data)
    if result:
        notify(screen, result)


def ntp_toggle_change(_data, _step, screen) -> None:
    result = ntp_toggle(screen, _data)
    if result:
