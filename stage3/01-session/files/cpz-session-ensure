#!/bin/sh
# Enforce the CPZ session invariant: if any terminal tab exists, the shell tab
# is window 1; Settings always exists and is last. Called at login and from
# tmux hooks after a window disappears.
#
# The last terminal tab is allowed to close. In that case only Settings
# remains, and this helper must not recreate a shell behind the user's back.
# A later window-linked hook adopts the next terminal tab as the shell.
set -eu

session=${1:-main}
[ "$session" = "main" ] || exit 0
tmux has-session -t "=$session" 2>/dev/null || exit 0

# cpz-tmux-start restores the saved layout with the hooks suppressed.
if [ "$(tmux show-options -gv @cpz_restoring 2>/dev/null || true)" = "1" ]; then
	exit 0
fi

# Serialise concurrent hook invocations. flock is part of util-linux.
lock="${TMPDIR:-/tmp}/cpz-session-ensure.${session}.lock"
if command -v flock >/dev/null 2>&1; then
	exec 9>"$lock"
	flock -w 2 9 || exit 0
fi

list_windows() {
	tmux list-windows -t "=$session" -F \
		'#{window_index} #{window_id} #{?@cpz_main,1,0} #{?@cpz_settings,1,0} #{window_name}'
}

has_client() {
	[ -n "$(tmux list-clients -F '#{client_name}' 2>/dev/null | head -n 1)" ]
}

windows=$(list_windows)

# Find the shell tab. Sessions created before @cpz_main existed fall back to
# window 1, unless window 1 is the Settings tab (which must never be promoted
# to the shell slot). When the user has closed the last terminal tab there is
# intentionally no shell to find, and no replacement is created here.
main_id=$(printf '%s\n' "$windows" | awk '$3 == 1 { print $2; exit }')
if [ -z "$main_id" ]; then
	main_id=$(printf '%s\n' "$windows" |
		awk '$1 == 1 && $4 != 1 && $5 != "settings" { print $2; exit }')
	if [ -n "$main_id" ]; then
		tmux set-option -w -t "$main_id" @cpz_main 1
	fi
fi

# The shell tab must be window 1. Swap instead of move so indexes stay
# contiguous for the "1 / N" counter.
if [ -n "$main_id" ]; then
	windows=$(list_windows)
	first_id=$(printf '%s\n' "$windows" | sort -n -k1,1 | head -n 1 | awk '{ print $2 }')
	if [ "$main_id" != "$first_id" ]; then
		tmux swap-window -s "$main_id" -t "$first_id"
	fi
fi

# The Settings tab must exist and be last.
windows=$(list_windows)
settings_id=$(printf '%s\n' "$windows" |
	awk '$4 == 1 || $5 == "settings" { print $2; exit }')

if [ -z "$settings_id" ]; then
	# Do not start the Python Settings TUI before a terminal client attaches.
	# Boot should get cage/foot/tmux on screen first; client-attached runs this
	# helper again and creates the tab.
	has_client || exit 0
	next=$(printf '%s\n' "$windows" | awk '{ if ($1 + 0 > max) max = $1 + 0 } END { print max + 1 }')
	settings_id=$(tmux new-window -d -P -F '#{window_id}' \
		-t "=$session:$next" -n settings -c "${HOME:-/}" \
		'/usr/local/bin/cpz-settings-shell')
	tmux set-option -w -t "$settings_id" @cpz_settings 1
	tmux set-option -w -t "$settings_id" automatic-rename off
else
	tmux set-option -w -t "$settings_id" @cpz_settings 1
	tmux set-option -w -t "$settings_id" automatic-rename off
	last_id=$(printf '%s\n' "$windows" | tail -n 1 | awk '{ print $2 }')
	if [ "$settings_id" != "$last_id" ]; then
		tmux swap-window -s "$settings_id" -t "$last_id"
	fi
fi
