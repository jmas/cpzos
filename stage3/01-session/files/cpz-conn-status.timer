[Unit]
Description=Periodically update CPZ connection indicators

[Timer]
# Do not compete with the cage/foot/tmux first frame: nmcli and bluetoothctl in
# the service can block for up to 15 s while NetworkManager/BlueZ start.
OnBootSec=10s
OnUnitActiveSec=30s
Unit=cpz-conn-status.service

[Install]
WantedBy=timers.target
