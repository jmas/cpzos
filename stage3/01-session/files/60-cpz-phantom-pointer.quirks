# CPZ: devices that must never make cage draw a cursor.
#
# cage shows its cursor whenever libinput reports a pointer-capable device.
# libinput derives that capability from evdev bits, so the udev ID_INPUT_*
# tags alone cannot remove it. Several devices expose REL_X/REL_Y without a
# mouse behind them:
#
#   - the internal TCA8418 keyboard (stray axes),
#   - the vc4 HDMI CEC node,
#   - the gpio_ir_recv IR receiver (the IR decoder reports axes).
#
# AttrEventCode removes the axes at the libevdev level and keeps every key
# event, so an IR remote or CEC remote still works while no cursor appears.
# The values are event-code names (REL_X, ABS_X), not event types: writing
# "-EV_REL" is a parse error, and a parse error disables the whole file.
#
# This file is installed as /etc/libinput/local-overrides.quirks.

[CPZ internal keyboard is not a pointer]
MatchName=cardputer-zero-internal
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;

[CPZ TCA8418 is not a pointer]
MatchName=*TCA8418*
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;

[CPZ tca8418 is not a pointer]
MatchName=*tca8418*
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;

[CPZ M5Stack is not a pointer]
MatchName=*M5Stack*
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;

[CPZ m5stack is not a pointer]
MatchName=*m5stack*
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;

[CPZ Cardputer is not a pointer]
MatchName=*Cardputer*
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;

[CPZ cardputer is not a pointer]
MatchName=*cardputer*
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;

[CPZ vc4 HDMI CEC is not a pointer]
MatchName=vc4-hdmi*
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;

[CPZ IR receiver is not a pointer]
MatchName=gpio_ir_recv
AttrEventCode=-REL_X;-REL_Y;-ABS_X;-ABS_Y;
