[Unit]
Description=CPZ Bluetooth pairing agent
After=bluetooth.service
Requires=bluetooth.service
ConditionPathExists=/usr/bin/bt-agent

[Service]
Type=simple
# The radio stays soft-blocked and powered off at boot (AutoEnable=false).
# Settings clears both only when the Bluetooth manager is opened, so the
# agent must not unblock the adapter here.
# Auto-accept Just Works / numeric-comparison pairing so devices can be paired
# from cpz-settings without a separate confirmation UI.
ExecStart=/usr/bin/bt-agent -c NoInputNoOutput
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
