#!/bin/sh
# Show the one-line key hint on the attached client's status line.
#
# A display-message run from a client-attached hook has no client context, so
# the message is dropped or printed into the pane where the top status bar
# covers it. Target the client explicitly; fall back to the first client when
# the hook does not provide the name.
set -eu

# Show the hint once per login session, not on every detach/attach.
marker=${XDG_RUNTIME_DIR:-/tmp}/cpz-hint-$(id -u)
[ -e "$marker" ] && exit 0
mkdir -p "$(dirname "$marker")" 2>/dev/null || true
: >"$marker" 2>/dev/null || true

client=${1:-}
if [ -z "$client" ]; then
	client=$(tmux list-clients -F '#{client_name}' 2>/dev/null | head -n 1)
fi
[ -n "$client" ] || exit 0

hint=
if [ -x /usr/local/bin/cpz-keys ]; then
	hint=$(/usr/local/bin/cpz-keys hint 2>/dev/null || true)
fi
[ -n "$hint" ] || hint='Alt+H keys   Alt+O search   Alt+S settings'

tmux display-message -c "$client" -d 5000 "$hint" 2>/dev/null || true
