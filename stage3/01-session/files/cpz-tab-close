#!/bin/sh
# Close the current tab. Bound to Alt+W and Ctrl-b & in tmux.conf; both ask for
# confirmation there.
#
# Any terminal tab may be closed, including the first one: renumber-windows
# promotes the next tab into slot 1. The Settings window stays open, and the
# last terminal tab is kept because closing it would leave no shell.
set -eu

session=${1:-main}
tmux has-session -t "=$session" 2>/dev/null || exit 0

# tmux 3.5 replaces literal tabs in -F output with "_", so use spaces. The
# fixed fields come first and the window name is last; read() with the default
# IFS then captures the rest of the line as the name.
windows=$(tmux list-windows -t "=$session" -F \
	"#{window_id} #{window_index} #{window_active} #{?@cpz_settings,1,0} #{window_name}")

current=$(printf '%s\n' "$windows" | awk '$3 == 1 { print; exit }')
[ -n "$current" ] || exit 0

read -r window_id _index _active is_settings name <<EOF
$current
EOF

# Settings is not a terminal tab, so it never counts towards the last tab.
terminals=$(printf '%s\n' "$windows" |
	awk '$4 != 1 && $5 != "settings" { count++ } END { print count + 0 }')

if [ "$is_settings" = 1 ] || [ "$name" = settings ]; then
	notice="Settings stays open"
elif [ "$terminals" -le 1 ]; then
	notice="Last tab stays open"
else
	# tmux selects the neighbouring tab and renumber-windows closes the gap;
	# the kill hooks save the new layout and keep Settings last.
	if tmux kill-window -t "$window_id" 2>/dev/null; then
		/usr/local/bin/cpz-tab-info "$session" 2>/dev/null || true
		exit 0
	fi
	notice="Could not close the tab"
fi

# run-shell has no client context, so print on the attached client explicitly.
client=$(tmux list-clients -t "=$session" -F '#{client_name}' | head -n 1)
if [ -n "$client" ]; then
	tmux display-message -c "$client" -d 3000 "$notice"
fi
