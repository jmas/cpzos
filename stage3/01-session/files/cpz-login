#!/bin/sh
# Autologin for the CPZ kmscon session.
#
# kmscon runs this as root on the pseudo-terminal it allocates for the session.
# Resolve uid 1000 at service start instead of baking in a username: Raspberry
# Pi Imager/rpi-preseed may rename the first user on first boot. login(1)
# creates the real PAM/logind session, which gives systemd --user, PipeWire and
# XDG_RUNTIME_DIR the expected environment.
#
# The pty name is recorded per VT so /etc/profile.d/cpz-session.sh can tell the
# tty1 CPZ session apart from the tty2 recovery login, SSH and a debug boot:
# kmscon runs its child on a pty, so `tty` is /dev/pts/N there, not /dev/tty1.
set -eu

vt=${1:-tty1}
case "$vt" in
	tty[0-9]*) ;;
	[0-9]*) vt="tty$vt" ;;
	*) vt=tty1 ;;
esac

user=$(getent passwd 1000 | cut -d: -f1 || true)
case "$user" in
	[a-z]*) ;;
	*) exit 1 ;;
esac
printf '%s\n' "$user" | grep -Eq '^[a-z][-a-z0-9_]*$' || exit 1

tty_name=$(tty 2>/dev/null || true)
case "$tty_name" in
	/dev/*)
		mkdir -p /run/cpz-kmscon 2>/dev/null || true
		printf '%s\n' "$tty_name" \
			>"/run/cpz-kmscon/session.$vt.tty" 2>/dev/null || true
		;;
esac

# A flat pack cannot survive the load of starting the session: the voltage
# collapses and the board resets. Show the warning on this pty and power off
# before login(1) starts anything.
if [ -x /usr/local/bin/cpz-battery ] &&
	! /usr/local/bin/cpz-battery boot; then
	# kmsconvt@.service uses Restart=always. Keep this child alive while
	# systemd powers off instead of relaunching the check every second.
	while :; do
		sleep 60
	done
fi

exec /bin/login -f "$user"
