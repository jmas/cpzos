#!/bin/sh
# Open a folder in the cmus TUI and start with the selected track.
#
# cmus has no file argument and its command lexer is awkward with spaces, so
# the wrapper describes the folder in a temporary cmus playlist (.pl). The
# playlist is added to the play queue (playback order) and to the library (so
# the whole folder stays visible in the Library view instead of vanishing as
# the queue drains). Order is the folder order rotated to the opened track:
# 04, 05, ... 13, 01, 02, 03. The remote helper runs in the background while
# cmus owns the terminal; q returns to mc/lf.
set -eu

[ "$#" -ge 1 ] || exit 1
case "$1" in
	-*) exit 1 ;;
esac
[ -f "$1" ] || exit 1

dir=$(cd -- "$(dirname -- "$1")" 2>/dev/null && pwd) || exit 1
file=$(cd -- "$dir" && pwd)/$(basename -- "$1")
[ -f "$file" ] || exit 1

# A TUI needs the controlling terminal even when the caller (mc's
# ${MC_XDG_OPEN}) redirects stdout and stderr to /dev/null.
if [ ! -t 0 ] || [ ! -t 1 ]; then
	if { exec 3<>/dev/tty; } 2>/dev/null; then
		exec <&3 >&3 2>&3
		exec 3>&-
	fi
fi

# cmus recognises a playlist by its .pl extension, not its content.
queue=${TMPDIR:-/tmp}/cpz-music-$$.pl
list=${TMPDIR:-/tmp}/cpz-music-$$.list
trap 'rm -f -- "$queue" "$list"' EXIT HUP INT TERM

# Every audio file of the folder (recursively), in name order. Hidden entries
# are metadata, not music: macOS writes an AppleDouble "._track.mp3" next to
# every file and those sort first.
find "$dir" -type f ! -name '*.cue' -print | LC_ALL=C sort |
	while IFS= read -r f; do
		case "$f" in
			*/.*) continue ;;
		esac
		case "${f##*.}" in
			[0-9A-Za-z]*) ;;
			*) continue ;;
		esac
		ext=$(printf '%s' "${f##*.}" | tr 'A-Z' 'a-z')
		case "$ext" in
			mp3 | mp2 | aac | ogg | oga | opus | flac | wav | wv | mpc | mpp | \
				mod | s3m | xm | it | mtm | 669 | stm | ult | far | \
				ape | spx | m4a) ;;
			*) continue ;;
		esac
		printf '%s\n' "$f"
	done >"$list"

# Rotate the list at the opened track so the album keeps its order.
: >"$queue"
found=
while IFS= read -r f; do
	[ "$f" = "$file" ] && found=1
	[ -n "$found" ] && printf '%s\n' "$f"
done <"$list" >"$queue"
while IFS= read -r f; do
	[ "$f" = "$file" ] && break
	printf '%s\n' "$f"
done <"$list" >>"$queue"

(
	tries=0
	while [ "$tries" -lt 50 ]; do
		cmus-remote -C "status" >/dev/null 2>&1 && break
		sleep 0.1
		tries=$((tries + 1))
	done
	cmus-remote -C "clear -q" >/dev/null 2>&1 || true
	cmus-remote -C "add -l $queue" >/dev/null 2>&1 || true
	cmus-remote -C "add -q $queue" >/dev/null 2>&1 || true
	# A large folder is still being scanned when add returns; player-play would
	# run against an empty queue and the player would stay stopped. Retry until
	# the status flips (up to ten seconds).
	tries=0
	while [ "$tries" -lt 40 ]; do
		cmus-remote -C "player-play" >/dev/null 2>&1 || true
		case "$(cmus-remote -Q 2>/dev/null || true)" in
			*"status playing"*) break ;;
		esac
		sleep 0.25
		tries=$((tries + 1))
	done
	rm -f -- "$queue" "$list"
) &

exec cmus
