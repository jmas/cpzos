#!/bin/sh
# Open a folder in the cmus TUI and start with the selected track.
#
# cmus has no file argument and its command lexer is awkward with spaces, so
# the wrapper describes the folder in a temporary cmus playlist (.pl) and plays
# from the playlist view. The playlist keeps every track visible (the play
# queue drops tracks as they start) and makes player-prev/player-next work.
# Order is the folder order rotated to the opened track: 04, 05, ... 13, 01,
# 02, 03. The remote helper runs in the background while cmus owns the
# terminal; q returns to mc/lf.
set -eu

[ "$#" -ge 1 ] || exit 1
case "$1" in
	-*) exit 1 ;;
esac
[ -f "$1" ] || exit 1

dir=$(cd -- "$(dirname -- "$1")" 2>/dev/null && pwd) || exit 1
file=$(cd -- "$dir" && pwd)/$(basename -- "$1")
[ -f "$file" ] || exit 1

# A TUI needs the controlling terminal even when the caller (mc's
# ${MC_XDG_OPEN}) redirects stdout and stderr to /dev/null.
if [ ! -t 0 ] || [ ! -t 1 ]; then
	# exec is a special builtin: in dash a failed redirection exits the whole
	# script, so probe /dev/tty in a subshell first. CI and an SSH session
	# without a terminal have no controlling terminal at all.
	if (exec 3<>/dev/tty) 2>/dev/null; then
		exec 3<>/dev/tty
		exec <&3 >&3 2>&3
		exec 3>&-
	fi
fi

# cmus recognises a playlist by its .pl extension, not its content.
queue=${TMPDIR:-/tmp}/cpz-music-$$.pl
list=${TMPDIR:-/tmp}/cpz-music-$$.list
trap 'rm -f -- "$queue" "$list"' EXIT HUP INT TERM

# Every audio file of the folder (recursively), in name order. Hidden entries
# are metadata, not music: macOS writes an AppleDouble "._track.mp3" next to
# every file and those sort first. One awk process filters the whole list;
# tr(1) per file made a large folder pay a fork for every track.
find "$dir" -type f ! -name '*.cue' -print | LC_ALL=C sort |
	awk '
		BEGIN {
			exts = "mp3 mp2 aac ogg oga opus flac wav wv mpc mpp mod s3m xm it mtm 669 stm ult far ape spx m4a"
			n = split(exts, list, " ")
			for (i = 1; i <= n; i++)
				ok[list[i]] = 1
		}
		$0 ~ /\/\./ { next }
		{
			ext = $0
			sub(/^.*\./, "", ext)
			if (tolower(ext) in ok)
				print
		}
	' >"$list"

# Rotate the list at the opened track so the album keeps its order.
: >"$queue"
found=
while IFS= read -r f; do
	[ "$f" = "$file" ] && found=1
	[ -n "$found" ] && printf '%s\n' "$f"
done <"$list" >"$queue"
while IFS= read -r f; do
	[ "$f" = "$file" ] && break
	printf '%s\n' "$f"
done <"$list" >>"$queue"

(
	tries=0
	while [ "$tries" -lt 50 ]; do
		cmus-remote -C "status" >/dev/null 2>&1 && break
		sleep 0.1
		tries=$((tries + 1))
	done
	# The play queue takes precedence over the playlist; clear it so the
	# playlist is the playback source and prev/next stay inside the folder.
	cmus-remote -C "clear -q" >/dev/null 2>&1 || true
	cmus-remote -C "clear -p" >/dev/null 2>&1 || true
	cmus-remote -C "add -p $queue" >/dev/null 2>&1 || true
	# A large folder is still being scanned when add returns; activating an
	# empty playlist does nothing, so retry until playback actually starts.
	tries=0
	while [ "$tries" -lt 40 ]; do
		cmus-remote -C "view 3" >/dev/null 2>&1 || true
		cmus-remote -C "win-top" >/dev/null 2>&1 || true
		cmus-remote -C "win-activate" >/dev/null 2>&1 || true
		case "$(cmus-remote -Q 2>/dev/null || true)" in
			*"status playing"*) break ;;
		esac
		sleep 0.25
		tries=$((tries + 1))
	done
	rm -f -- "$queue" "$list"
) &

exec cmus
