#!/usr/bin/python3
"""CPZ keyboard shortcut registry and tmux applier.

The CardputerZero keyboard is small: punctuation lives on the Sym layer and the
arrow keys are Fn combinations. CPZ shortcuts are therefore deliberately
limited to one modifier plus one plain key. The defaults use Alt+letter and
Alt+digit, which are two physical keys on the internal keyboard and on an
external USB/Bluetooth keyboard.

This module is the single source of truth for the shortcuts:

* ``ACTIONS`` defines every user-facing action, its default key, its group and
  the tmux command it runs.
* tmux.conf sources the generated file instead of hard-coding ``bind`` lines.
* cpz-help, cpz-search, cpz-hint and cpz-settings read the same registry, so a
  rebind is visible everywhere.

Overrides live in ``~/.config/cpz/keys.conf`` (one ``action=M-key`` per line).
Settings -> Keyboard -> Shortcuts writes that file and calls ``cpz-keys apply``.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from typing import Any

