#!/usr/bin/env python3
"""Scale a PSF2 console font to a larger cell size.

fbcon draws the console with the glyphs in the loaded console font, so the
only way to make the HDMI UI larger than the biggest packaged Terminus cell
(16x32) is to scale the font itself.  This duplicates pixels with
nearest-neighbour sampling, which keeps bitmap edges crisp at integer scale
factors, and copies the Unicode table unchanged.  cpz-hdmi-console generates
a font in /run for the real framebuffer size and removes it on the next boot.

PSF2 only; the old PSF1 format is not used by the HDMI font selection.

Usage: cpz-font-scale SRC.psf[.gz] WIDTHxHEIGHT DEST.psf[.gz]
"""

from __future__ import annotations

import gzip
import os
import re
import struct
import sys
import tempfile

PSF2_MAGIC = 0x864AB572
MAX_DIMENSION = 256


def read_font(path: str) -> tuple[bytes, tuple, bytes, bytes]:
    raw = open(path, "rb").read()
    if raw[:2] == b"\x1f\x8b":
        raw = gzip.decompress(raw)
    if len(raw) < 32:
        raise ValueError("not a PSF2 font")
    fields = struct.unpack_from("<IIIIIIII", raw, 0)
    magic, _version, header_size, _flags, length, charsize, height, width = fields
    if magic != PSF2_MAGIC:
        raise ValueError("not a PSF2 font (PSF1 is not supported)")
    if header_size < 32 or height == 0 or width == 0:
        raise ValueError("invalid PSF2 geometry")
    if charsize < height * ((width + 7) // 8):
        raise ValueError("invalid PSF2 glyph size")
    glyph_end = header_size + length * charsize
    if glyph_end > len(raw):
        raise ValueError("truncated glyph data")
    return raw, fields, raw[header_size:glyph_end], raw[glyph_end:]


def scale_glyphs(glyphs: bytes, length: int, charsize: int,
                 src_w: int, src_h: int, dst_w: int, dst_h: int) -> bytes:
    src_stride = (src_w + 7) // 8
    dst_stride = (dst_w + 7) // 8
    dst_charsize = dst_stride * dst_h
    out = bytearray(length * dst_charsize)
    for glyph in range(length):
        src_offset = glyph * charsize
        dst_offset = glyph * dst_charsize
        for y in range(dst_h):
            source_y = y * src_h // dst_h
            source_row = src_offset + source_y * src_stride
            target_row = dst_offset + y * dst_stride
            for x in range(dst_w):
                source_x = x * src_w // dst_w
                if glyphs[source_row + source_x // 8] & (0x80 >> (source_x % 8)):
                    out[target_row + x // 8] |= 0x80 >> (x % 8)
    return bytes(out)


def parse_size(text: str) -> tuple[int, int]:
    match = re.fullmatch(r"([0-9]+)x([0-9]+)", text)
    if match is None:
        raise ValueError("expected WIDTHxHEIGHT (for example 20x40)")
    width, height = int(match.group(1)), int(match.group(2))
    if width < 1 or height < 1 or width > MAX_DIMENSION or height > MAX_DIMENSION:
        raise ValueError(f"cell size must be between 1 and {MAX_DIMENSION}")
    return width, height


def scale_font(source: str, size: str, destination: str) -> int:
    try:
        raw, fields, glyphs, tail = read_font(source)
        dst_w, dst_h = parse_size(size)
    except (OSError, ValueError, struct.error) as error:
        print(f"{source}: {error}", file=sys.stderr)
        return 1

    magic, version, header_size, flags, length, charsize, height, width = fields
    try:
        scaled = scale_glyphs(glyphs, length, charsize, width, height, dst_w, dst_h)
    except (IndexError, ValueError) as error:
        print(f"{source}: {error}", file=sys.stderr)
        return 1

    dst_charsize = ((dst_w + 7) // 8) * dst_h
    header = struct.pack("<IIIIIIII", magic, version, header_size, flags,
                         length, dst_charsize, dst_h, dst_w)
    header += raw[32:header_size]
    output = header + scaled + tail

    directory = os.path.dirname(os.path.abspath(destination)) or "."
    os.makedirs(directory, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=".cpz-font-", dir=directory)
    try:
        with os.fdopen(fd, "wb") as temp:
            if destination.endswith(".gz"):
                temp.write(gzip.compress(output, compresslevel=9, mtime=0))
            else:
                temp.write(output)
        os.chmod(temp_path, 0o644)
        os.replace(temp_path, destination)
    except BaseException:
        os.unlink(temp_path)
        raise
    return 0


def main(argv: list[str]) -> int:
    if len(argv) != 4:
        print(f"usage: {argv[0]} SRC.psf[.gz] WIDTHxHEIGHT DEST.psf[.gz]",
              file=sys.stderr)
        return 2
    if not os.path.exists(argv[1]):
        print(f"{argv[1]}: not found", file=sys.stderr)
        return 1
    return scale_font(argv[1], argv[2], argv[3])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
