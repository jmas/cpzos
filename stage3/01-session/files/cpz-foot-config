#!/bin/sh
# Render the foot configuration for the CPZ session.
#
# foot reads its configuration only at startup, so cpz-foot-reload renders this
# file and asks the session supervisor to replace only the visible foot when a
# font or theme changes. The compositor and tmux stay up.
#
# The rendering is deliberately the same policy as the old kmscon config: the
# theme's tmux window colours become foot's background and foreground, and the
# 16 ANSI colours come from the theme palette.
#
# Prints "changed" or "same" unless --quiet is given.
set -eu

run_dir=/run/cpz-cage
out=$run_dir/foot.ini
theme_dir=/etc/cpz/themes
quiet=0
case "${1:-}" in
	'') ;;
	--quiet) quiet=1 ;;
	*)
		printf 'usage: %s [--quiet]\n' "${0##*/}" >&2
		exit 2
		;;
esac

first_home=$(getent passwd 1000 2>/dev/null | cut -d: -f6 || true)
[ -n "$first_home" ] || first_home=/root

get_setting() {
	for file in "$first_home/.config/cpz/settings.conf" /etc/cpz/settings.conf; do
		[ -r "$file" ] || continue
		value=$(sed -n "s/^$1=//p" "$file" | tail -n 1)
		[ -n "$value" ] && { printf '%s' "$value"; return 0; }
	done
	return 0
}

# Font families offered by Settings > Display > Font. Each slug maps to the
# fontconfig family installed for it, so a saved value always resolves to a
# real font instead of silently falling back. Keep the list in sync with
# cpz-settings FONT_FAMILIES and with stage3/01-session/00-packages.
font_family=$(get_setting font_family)
case "$font_family" in
	terminus) font_name=Terminus ;;
	dejavu) font_name="DejaVu Sans Mono" ;;
	liberation) font_name="Liberation Mono" ;;
	noto) font_name="Noto Sans Mono" ;;
	hack) font_name=Hack ;;
	fira) font_name="Fira Code" ;;
	jetbrains) font_name="JetBrains Mono" ;;
	*) font_name=Terminus ;;
esac

# Terminus OTB is a bitmap font with fixed strikes. Sizes outside this list
# make foot fall back to a font without Cyrillic, so Ukrainian labels render
# as dashes. Persisted values are normalised to the nearest real strike.
font_sizes="12 14 16 18 20 22 24 28 32"
normalize_font_size() {
	value=$1
	best=12
	best_diff=999
	for size in $font_sizes; do
		diff=$((value - size))
		[ "$diff" -lt 0 ] && diff=$((0 - diff))
		if [ "$diff" -lt "$best_diff" ] ||
			{ [ "$diff" -eq "$best_diff" ] && [ "$size" -lt "$best" ]; }; then
			best=$size
			best_diff=$diff
		fi
	done
	printf '%s' "$best"
}

valid_hex() {
	case "$1" in
		??????) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*[!0-9a-fA-F]*) return 1 ;;
	esac
	return 0
}

hex_or() {
	value=$1
	fallback=$2
	if valid_hex "$value"; then
		printf '%s' "$value"
	else
		printf '%s' "$fallback"
	fi
}

theme=$(get_setting theme)
case "$theme" in
	'' | *[!a-zA-Z0-9_-]*) theme=cpz-campbell ;;
esac
theme_conf=$theme_dir/$theme.conf
[ -r "$theme_conf" ] || theme_conf=$theme_dir/cpz-campbell.conf

# The tmux window style carries the theme's body colours; the palette entries
# are the fallback when a theme is missing a style.
bg=""
fg=""
if [ -r "$theme_conf" ]; then
	style=$(sed -n 's/^set -g window-style "\(.*\)"$/\1/p' "$theme_conf" |
		head -n 1)
	bg=$(printf '%s' "$style" | sed -n 's/.*bg=#\([0-9a-fA-F]\{6\}\).*/\1/p')
	fg=$(printf '%s' "$style" | sed -n 's/.*fg=#\([0-9a-fA-F]\{6\}\).*/\1/p')
fi
bg=$(hex_or "$bg" "$(sed -n 's/^# palette 0=//p' "$theme_conf" 2>/dev/null |
	tail -n 1)")
fg=$(hex_or "$fg" "$(sed -n 's/^# palette 7=//p' "$theme_conf" 2>/dev/null |
	tail -n 1)")
bg=$(hex_or "$bg" 101418)
fg=$(hex_or "$fg" e6edf3)

# The panel and HDMI remember their own Terminus pixel height. foot uses
# fontconfig pixelsize, so it keeps the same cell size as kmscon did instead of
# switching to points. cpz-cage-output publishes the target before it restarts
# the session, so this renders the size of the output that is starting.
output_target() {
	target=$(sed -n 's/^target=//p' "$run_dir/output.state" 2>/dev/null |
		tail -n 1)
	case "$target" in
		hdmi) printf hdmi ;;
		*) printf panel ;;
	esac
}
case "$(output_target)" in
	hdmi)
		font_key=font_size_hdmi
		font_default=16
		;;
	*)
		font_key=font_size_panel
		font_default=12
		;;
esac
font_size=$(get_setting "$font_key")
# Legacy files only have font_size (and the older 6x12/8x16 presets).
case "$font_size" in
	'' | *[!0-9]*)
		font_size=$(get_setting font_size)
		case "$font_size" in
			'' | *[!0-9]*)
				case "$(get_setting font_panel)" in
					8x16) font_size=16 ;;
					*) font_size=$font_default ;;
				esac
				;;
		esac
		;;
esac
font_size=$(normalize_font_size "$font_size")

# foot replaces the whole font list when the option appears twice; the family
# and the Cyrillic fallback therefore have to be one comma-separated value.
if [ "$font_name" = "DejaVu Sans Mono" ]; then
	font_list="$font_name:pixelsize=$font_size"
else
	font_list="$font_name:pixelsize=$font_size, DejaVu Sans Mono:pixelsize=$font_size"
fi

render() {
	cat <<EOF
# Generated by cpz-foot-config from the CPZ settings. Do not edit.
font=$font_list
# Bitmap Terminus has no Cyrillic strike at every requested size; DejaVu Sans
# Mono is the fallback for glyphs the selected family lacks.
dpi-aware=no
pad=0x0
initial-window-mode=fullscreen
term=foot
# Shift+drag bypasses tmux and selects in foot itself. Copy that selection to
# the Wayland clipboard, not only to the primary selection.
selection-target=clipboard
# cage 0.3.1 can leave a stale text cursor after a pointer disappears. Hide the
# pointer while typing so the first keystroke clears a ghost even if the
# compositor still remembers the old pointer capability.
[mouse]
hide-when-typing=yes

[colors]
background=$bg
foreground=$fg
EOF
	palette=$(awk '
		BEGIN {
			for (i = 0; i <= 7; i++) names[i] = "regular" i
			for (i = 0; i <= 7; i++) names[i + 8] = "bright" i
		}
		/^# palette / {
			line = $0
			sub(/^# palette /, "", line)
			eq = index(line, "=")
			if (eq <= 1)
				next
			idx = substr(line, 1, eq - 1)
			hex = substr(line, eq + 1)
			if (idx !~ /^[0-9]+$/ || idx + 0 > 15)
				next
			if (length(hex) != 6 || hex ~ /[^0-9a-fA-F]/)
				next
			values[idx + 0] = hex
		}
		END {
			for (i = 0; i <= 15; i++)
				if (i in values)
					print names[i] "=" values[i]
		}
	' "$theme_conf" 2>/dev/null || true)
	[ -z "$palette" ] || printf '%s\n' "$palette"
}

mkdir -p "$run_dir" 2>/dev/null || true
tmp=$run_dir/.foot.ini.$$
trap 'rm -f "$tmp"' EXIT HUP INT TERM
render >"$tmp"
chmod 0644 "$tmp" 2>/dev/null || true
# The renderer can run as root (from cpz-cage-output) or as the console user
# (from cpz-cage). Keep the file readable by foot in both cases.
if [ "$(id -u)" = 0 ]; then
	chown 1000:1000 "$tmp" 2>/dev/null || true
fi

if [ -f "$out" ] && cmp -s "$tmp" "$out"; then
	rm -f "$tmp"
	trap - EXIT HUP INT TERM
	[ "$quiet" = 1 ] || printf 'same\n'
	exit 0
fi

mv "$tmp" "$out"
trap - EXIT HUP INT TERM
[ "$quiet" = 1 ] || printf 'changed\n'
