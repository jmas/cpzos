#!/bin/sh
# Toggle between automatic output selection and the internal panel.
#
# Bound to Alt+D by default in the cpz-keys registry so the panel can be
# recovered even when an HDMI monitor is powered off but keeps HPD asserted
# (the Pi cannot detect that).
# The choice is stored like any other setting; the output request touched below
# makes the path unit apply it immediately.
set -u

home=${HOME:-/root}
user_settings=${XDG_CONFIG_HOME:-$home/.config}/cpz/settings.conf
system_settings=/etc/cpz/settings.conf
translate() {
	key=$1
	shift
	message=$key
	if [ -x /usr/local/bin/cpz-i18n ]; then
		message=$(/usr/local/bin/cpz-i18n get "$key" "$key" "$@" 2>/dev/null ||
			printf '%s' "$key")
	fi
	while [ $# -gt 0 ]; do
		case $1 in
			--field) field=${2:-}; shift 2 ;;
			*) shift; continue ;;
		esac
		name=${field%%=*}
		value=${field#*=}
		[ -n "$name" ] &&
			message=$(printf '%s' "$message" | sed "s/{$name}/$value/g")
	done
	printf '%s' "$message"
}


get() {
	for file in "$user_settings" "$system_settings"; do
		[ -r "$file" ] || continue
		value=$(sed -n "s/^$1=//p" "$file" | tail -n 1)
		[ -n "$value" ] && { printf '%s' "$value"; return 0; }
	done
	return 0
}

say() {
	if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
		tmux display-message -d 2000 "$1" >/dev/null 2>&1 || true
	fi
}

current=$(get display)
case "$current" in
	panel) next=auto ;;
	*) next=panel ;;
esac

# Update only the display key, preserving every other setting.
mkdir -p "$(dirname "$user_settings")" 2>/dev/null || true
tmp="${user_settings}.tmp.$$"
if [ -r "$user_settings" ]; then
	awk -v value="$next" '
		BEGIN { done = 0 }
		/^display=/ {
			if (!done) { print "display=" value; done = 1 }
			next
		}
		{ print }
		END { if (!done) print "display=" value }
	' "$user_settings" >"$tmp" || { rm -f "$tmp"; exit 1; }
else
	printf '# CPZ user settings. Written by cpz-settings.\ndisplay=%s\n' \
		"$next" >"$tmp" || exit 1
fi
chmod 0644 "$tmp" 2>/dev/null || true
mv "$tmp" "$user_settings" 2>/dev/null || { rm -f "$tmp"; exit 1; }

# Apply the new target now instead of waiting for the five-second fallback
# timer. The path unit starts cpz-cage-output.service as root.
if [ -d /run/cpz-cage ]; then
	touch /run/cpz-cage/output.request 2>/dev/null || true
fi

case "$next" in
	panel) say "$(translate 'display: CPZ panel')" ;;
	*) say "$(translate 'display: auto')" ;;
esac
