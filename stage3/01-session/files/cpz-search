AUTOMOUNT_STATE = "/run/cpz-automount"


def self_path() -> str:
    """Return an absolute path for reload() even when argv[0] came from PATH."""
    argument = sys.argv[0]
    if os.sep in argument and os.path.isfile(argument):
        return os.path.abspath(argument)
    found = shutil.which(argument)
    if found:
        return os.path.abspath(found)
    source = globals().get("__file__")
    if isinstance(source, str) and source:
        return os.path.abspath(source)
    return os.path.abspath(argument)


def script_dir() -> str:
    """Directory that contains the helpers, also when imported by the tests."""
    source = globals().get("__file__")
    if isinstance(source, str) and source:
        return os.path.dirname(os.path.abspath(source))
    return os.path.dirname(self_path())


def helper(name: str) -> str:
    sibling = os.path.join(script_dir(), name)
    if os.access(sibling, os.X_OK):
        return sibling
    return shutil.which(name) or os.path.join("/usr/local/bin", name)


def settings_path() -> str | None:
    override = os.environ.get("CPZ_SETTINGS", "").strip()
    candidates = (
        override,
        os.path.join(script_dir(), "cpz-settings"),
        "/usr/local/bin/cpz-settings",
        shutil.which("cpz-settings") or "",
    )
    for candidate in candidates:
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


def clean_field(text: str) -> str:
    return "".join(" " if ord(char) < 32 or char == UNIT else char for char in text)


def usable_text(text: str) -> bool:
    return not any(
        ord(char) < 32 or char == UNIT or 0xD800 <= ord(char) <= 0xDFFF
        for char in text
    )


def make_item(
    kind: str,
    payload: str,
    display: str,
    extra: str = "",
    flags: str = "",
) -> str:
    return UNIT.join(
        (
            kind,
            clean_field(payload),
            clean_field(display),
            clean_field(extra),
            clean_field(flags),
        )
    )


def parse_item(line: str) -> tuple[str, str, str, str, str] | None:
    fields = line.split(UNIT, 4)
    if len(fields) == 3:
        fields.append("")
    if len(fields) == 4:
        fields.append("")
    if len(fields) != 5:
        return None
    return fields[0], fields[1], fields[2], fields[3], fields[4]


def item_flags(line: str) -> set[str]:
    parsed = parse_item(line)
    if parsed is None:
        return set()
    return {flag for flag in parsed[4].split(",") if flag}


def set_flags(*flags: str) -> str:
    return ",".join(dict.fromkeys(flag for flag in flags if flag))


def list_settings_pages(path: str | None = None) -> list[tuple[str, str]]:
    executable = path or settings_path()
    if not executable:
        return []
    try:
        result = subprocess.run(
            [executable, "--list-pages"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    if result.returncode != 0:
        return []
    pages = []
    for line in result.stdout.splitlines():
        page, separator, title = line.partition("\t")
        if separator and page and title:
            pages.append((page, title))
    return pages


_SCAN_CACHE: list[str] | None = None


def scan_apps() -> list[str]:
    """Return executable names from PATH, preserving the first occurrence."""
    global _SCAN_CACHE
    if _SCAN_CACHE is not None:
        return _SCAN_CACHE
    seen = set()
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            continue
        try:
            entries = os.scandir(directory)
        except OSError:
            continue
        with entries:
            for entry in entries:
                name = entry.name
                if name in seen or name == APP_NAME or not usable_text(name):
                    continue
                try:
                    if entry.is_file() and os.access(entry.path, os.X_OK):
                        seen.add(name)
                except OSError:
                    continue
    _SCAN_CACHE = sorted(seen)
    return _SCAN_CACHE


def trove_state_path() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state")
    return os.path.join(base, *TROVE_STATE)


def read_managed_apps(path: str | None = None) -> list[dict[str, str]]:
    """Read the Applications manager state without starting cpz-settings."""
    try:
        with open(path or trove_state_path(), "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return []
    raw_apps = data.get("apps") if isinstance(data, dict) else None
    if not isinstance(raw_apps, list):
        return []
    apps = []
    for raw in raw_apps:
        if not isinstance(raw, dict):
            continue
        slug = str(raw.get("slug", "")).strip()
        package = str(raw.get("package", "")).strip()
        if not slug or not package or not usable_text(slug):
            continue
        apps.append(
            {
                "slug": slug,
                "name": str(raw.get("name", "")).strip() or slug,
                "package": package,
                "version": str(raw.get("version", "")).strip(),
            }
        )
    return sorted(apps, key=lambda item: item["name"].lower())


def command_from_dpkg(package: str, preferred: tuple[str, ...] = ()) -> str:
    """Find an installed executable when the tool name differs from the package."""
    if not package or not shutil.which("dpkg"):
        return ""
    try:
        result = subprocess.run(
            ["dpkg", "-L", package],
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    if result.returncode != 0:
        return ""
    names = []
    for path in result.stdout.splitlines():
        path = path.strip()
        if not path or os.path.dirname(path) not in BIN_DIRS:
            continue
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            continue
        names.append(os.path.basename(path))
    names = sorted(set(names))
    for candidate in preferred:
        if candidate and candidate in names:
            return candidate
    for name in names:
        if any(
            candidate and (name.startswith(candidate) or candidate.startswith(name))
            for candidate in preferred
        ):
            return name
    return names[0] if names else ""


def managed_command(record: dict[str, str], available: set[str]) -> str:
    name = record.get("name", "").lower()
    candidates = (
        record.get("slug", ""),
        record.get("package", ""),
        name.replace(" ", "-"),
        name.replace(" ", ""),
    )
    for candidate in candidates:
        if candidate and candidate in available:
            return candidate
    return command_from_dpkg(record.get("package", ""), candidates)


def managed_app_items() -> list[str]:
    """Apps installed through Applications, ready to run in the first screen."""
    records = read_managed_apps()
    if not records:
        return []
    available = set(scan_apps())
    items = []
    for record in records:
        command = managed_command(record, available)
        name = record["name"]
        if command:
            display = f"{name}  {tr('[run app]')}"
            flags = set_flags("managed", "installed", "runnable")
        else:
            display = f"{name}  {tr('[installed]')}"
            flags = set_flags("managed", "installed")
        items.append(
            make_item("tool", record["slug"], display, command, flags)
        )
    return items


def action_items() -> list[str]:
    return [
        make_item("action", action_id, f"{label}  [{keys}]", "", "action")
        if keys
        else make_item("action", action_id, f"{label}  {tr('[action]')}", "", "action")
        for action_id, label, keys in ACTIONS
    ]


def action_rows(action_id: str) -> list[str]:
    """Return the Search row for one action id, if the registry has it."""
    for current_id, label, keys in ACTIONS:
        if current_id != action_id:
            continue
        if keys:
            return [
                make_item(
                    "action", current_id, f"{label}  [{keys}]", "", "action"
                )
            ]
        return [
            make_item(
                "action", current_id, f"{label}  {tr('[action]')}", "", "action"
            )
        ]
    return []


def power_items() -> list[str]:
    """Reboot and Shut Down, listed last so a stray Enter cannot reach them."""
    return [
        make_item("power", action, f"{tr(label)}  {tr('[power]')}", "", "power")
        for action, label, _question in POWER_ACTIONS
    ]


def settings_items() -> list[str]:
    """One row per Settings page, except the main menu.

    The ``Settings  [Alt+S]`` action already opens the main menu, so listing
    the main page as well would show two identical destinations. Every other
    page gets a row, and the display starts with the page title because that is
    the field fzf matches against.
    """
    return [
        make_item("settings", page, f"{title}  {tr('[settings]')}", "", "settings")
        for page, title in list_settings_pages()
        if page != "main"
    ]


def home_settings_items() -> list[str]:
    """First-level Settings destinations for the fast first screen.

    Unlike settings_items(), this does not start cpz-settings: the static list
    keeps the popup instant. The full page list is loaded once the user types.
    """
    return [
        make_item(
            "settings",
            page,
            f"{tr(title)}  {tr('[settings]')}",
            "",
            "settings",
        )
        for page, title in HOME_SETTINGS_PAGES
    ]


def path_app_items(exclude: set[str]) -> list[str]:
    return [
        make_item("app", name, f"{name}  [app]", "", "installed,runnable")
        for name in scan_apps()
        if name not in exclude
    ]


def dedupe(items: list[str]) -> list[str]:
    seen = set()
    result = []
    for line in items:
        parsed = parse_item(line)
        if parsed is None:
            result.append(line)
            continue
        key = (parsed[0], parsed[1].lower())
        if key in seen:
            continue
        seen.add(key)
        result.append(line)
    return result


def default_items() -> list[str]:
    managed = managed_app_items()
    catalog = trove_items()
    installed = [item for item in catalog if "installed" in item_flags(item)]
    remaining = [item for item in catalog if "installed" not in item_flags(item)]
    excluded = set()
    for line in managed + installed:
        parsed = parse_item(line)
        if parsed is not None and parsed[3]:
            excluded.add(parsed[3])
    return dedupe(
        media_items()
        + managed
        + installed
        + action_items()
        + settings_items()
        + power_items()
        + remaining
        + path_app_items(excluded)
    )


def home_items() -> list[str]:
    """The fast first screen: media, tab/sound actions, Settings, Help.

    Priority is fixed so the most useful rows survive a narrow panel and a
    stray Enter cannot reach an app or a power action: mounted media, New Tab,
    Close Tab, Mute, then the first-level Settings destinations and Help.
    Everything that needs the catalog, a PATH scan or a cpz-settings subprocess
    is deferred to default_items() and appears as soon as the user types.
    """
    quick_actions = [
        line
        for action_id in HOME_ACTION_IDS
        for line in action_rows(action_id)
    ]
    return dedupe(
        media_items()
        + quick_actions
        + home_settings_items()
        + action_rows("help")
    )


def search_roots() -> list[str]:
    override = os.environ.get("CPZ_SEARCH_ROOTS", "").strip()
    candidates = override.split(os.pathsep) if override else list(DEFAULT_ROOTS)
    roots = []
    for candidate in candidates:
        root = os.path.abspath(os.path.expanduser(candidate.strip()))
        if root and root not in roots and os.path.isdir(root):
            roots.append(root)
    return roots


def file_items() -> list[str]:
    roots = search_roots()
    if not roots:
        return []

    prune = []
    for index, name in enumerate(PRUNE_NAMES):
        if index:
            prune.append("-o")
        prune.extend(("-name", name))
    command = [
        "find",
        *roots,
        "(",
        *prune,
        ")",
        "-prune",
        "-o",
        "(",
        "-type",
        "f",
        "-o",
        "-type",
        "d",
        ")",
        "-print0",
    ]
    try:
        result = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=20,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return []

    root_set = set(roots)
    items = []
    for raw in result.stdout.split(b"\0"):
        if not raw:
            continue
        path = os.fsdecode(raw)
        if path in root_set or not usable_text(path):
            continue
        is_dir = os.path.isdir(path)
        tag = "dir" if is_dir else "file"
        suffix = "/" if is_dir else ""
        items.append(make_item("file", path, f"{path}{suffix}  [{tag}]"))
    return items


def tool_rank(line: str) -> int:
    """Installed manager apps first, then runnable, installable, the rest."""
    flags = item_flags(line)
    if "managed" in flags:
        return 0
    if "installed" in flags:
        return 1
    if "installable" in flags:
        return 2
    return 3


def display_sort_key(line: str) -> str:
    parsed = parse_item(line)
    return parsed[2].lower() if parsed else line.lower()


def parse_trove_payload(text: str) -> list[str]:
    """Turn `cpz-settings --list-tools` JSON into fzf items."""
    try:
        data = json.loads(text)
    except ValueError:
        return []
    tools = data.get("tools") if isinstance(data, dict) else data
    if not isinstance(tools, list):
        return []
    items = []
    for tool in tools:
        if not isinstance(tool, dict):
            continue
        slug = str(tool.get("slug", "")).strip()
        if not slug or not usable_text(slug):
            continue
        name = str(tool.get("name", "")).strip() or slug
        command = str(tool.get("command", "")).strip()
        if command and not usable_text(command):
            command = ""
        managed = bool(tool.get("managed"))
        installed = bool(tool.get("installed")) or managed or bool(command)
        apt = str(tool.get("apt", "")).strip()
        summary = str(tool.get("summary", "")).strip()
        categories = tool.get("categories")
        if not summary and isinstance(categories, list):
            summary = ", ".join(str(item) for item in categories if item)

        if command:
            state = tr("[run app]")
        elif installed:
            state = tr("[installed]")
        elif apt:
            state = tr("[install app]")
        else:
            state = "[info]"
        display = f"apps {name}  {state}"
        if summary:
            display = f"{display}  {summary}"

        flags = [
            "managed" if managed else "",
            "installed" if installed else "",
            "runnable" if command else "",
            "installable" if not installed and apt else "",
        ]
        items.append(make_item("tool", slug, display, command, set_flags(*flags)))
    items.sort(key=lambda line: (tool_rank(line), display_sort_key(line)))
    return items


def trove_items() -> list[str]:
    executable = settings_path()
    if not executable:
        return []
    try:
        result = subprocess.run(
            [executable, "--list-tools"],
            capture_output=True,
            text=True,
            timeout=15,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    if result.returncode != 0:
        return []
    return parse_trove_payload(result.stdout)


def automount_state_dir() -> str:
    override = os.environ.get("CPZ_AUTOMOUNT_STATE", "").strip()
    return override or AUTOMOUNT_STATE


def is_mounted(path: str) -> bool:
    try:
        return os.path.ismount(path)
    except OSError:
        return False


def mounted_media() -> list[tuple[str, str]]:
    """Return (device, mountpoint) pairs recorded by cpz-automount.

    The state file survives a crash, so a stale entry is only used while the
    path is still a mount point. Unplugging removes the file through ExecStop.
    """
    try:
        entries = os.scandir(automount_state_dir())
    except OSError:
        return []
    media = []
    with entries:
        for entry in entries:
            name = entry.name
            if not name.endswith(".mountpoint"):
                continue
            device_name = name[: -len(".mountpoint")]
            if (
                not device_name
                or "/" in device_name
                or device_name in (".", "..")
                or not usable_text(device_name)
            ):
                continue
            try:
                if not entry.is_file():
                    continue
                with open(entry.path, "r", encoding="utf-8", errors="replace") as handle:
                    mountpoint = handle.readline().strip()
            except OSError:
                continue
            if not mountpoint or not usable_text(mountpoint):
                continue
            if not os.path.isdir(mountpoint) or not is_mounted(mountpoint):
                continue
            media.append((f"/dev/{device_name}", mountpoint))
    return sorted(media, key=lambda pair: pair[1].lower())


def media_items() -> list[str]:
    """Tab and Unmount rows per filesystem mounted by cpz-automount.

    The tab row comes first: Enter on mounted media opens the disk at its
    mount point, and the destructive Unmount needs a deliberate second step.
    """
    items = []
    for device, mountpoint in mounted_media():
        label = os.path.basename(mountpoint.rstrip(os.sep)) or device
        items.append(
            make_item(
                "media-tab",
                mountpoint,
                f"{tr('Open {label}', label=label)}  {tr('[tab]')}  {mountpoint}",
                device,
                "media",
            )
        )
        items.append(
            make_item(
                "media",
                device,
                f"{tr('Unmount {label}', label=label)}  {tr('[media]')}  {mountpoint}",
                mountpoint,
                "media",
            )
        )
    return items


def buffer_items() -> list[str]:
    if not (os.environ.get("TMUX") and shutil.which("tmux")):
        return []
    try:
        result = subprocess.run(
            ["tmux", "list-buffers", "-F", "#{buffer_name}"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    if result.returncode != 0:
        return []
    items = []
    for name in result.stdout.splitlines():
        if not name or not usable_text(name):
            continue
        try:
            content = subprocess.run(
                ["tmux", "show-buffer", "-b", name],
                capture_output=True,
                text=True,
                errors="replace",
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.SubprocessError):
            continue
        preview = " ".join(content.stdout.split())[:80] or "(empty)"
        items.append(make_item("buffer", name, f"${name}  [buf]  {preview}"))
    return items


def _eval_node(node: ast.AST):
    if isinstance(node, ast.Constant):
        if isinstance(node.value, bool) or not isinstance(node.value, (int, float)):
            raise ValueError("unsupported constant")
        return node.value
    if isinstance(node, ast.UnaryOp):
        value = _eval_node(node.operand)
        if isinstance(node.op, ast.UAdd):
            return +value
        if isinstance(node.op, ast.USub):
            return -value
        raise ValueError("unsupported unary operator")
    if isinstance(node, ast.BinOp):
        left = _eval_node(node.left)
        right = _eval_node(node.right)
        if isinstance(node.op, ast.Add):
            return left + right
        if isinstance(node.op, ast.Sub):
            return left - right
        if isinstance(node.op, ast.Mult):
            return left * right
        if isinstance(node.op, ast.Div):
            return left / right
        if isinstance(node.op, ast.FloorDiv):
            return left // right
        if isinstance(node.op, ast.Mod):
            return left % right
        if isinstance(node.op, ast.Pow):
            if abs(right) > CALC_EXPONENT_LIMIT:
                raise ValueError("exponent too large")
            return left**right
        raise ValueError("unsupported operator")
    raise ValueError("unsupported expression")


def safe_eval(expression: str):
    if not expression or len(expression) > CALC_LIMIT:
        raise ValueError("expression too long")
    tree = ast.parse(expression, mode="eval")
    value = _eval_node(tree.body)
    if isinstance(value, complex):
        raise ValueError("complex result")
    return value


def format_number(value: int | float) -> str:
    if isinstance(value, int):
        return str(value)
    if value != value or value in (float("inf"), float("-inf")):
        raise ValueError("not a finite number")
    return f"{value:.10g}"


def calc_item(expression: str) -> str:
    raw = expression[1:].strip() if expression.startswith("=") else expression.strip()
    if not raw:
        return make_item("calc", "", "=  type an expression  [calc]")
    try:
        result = format_number(safe_eval(raw))
    except (ArithmeticError, SyntaxError, ValueError):
        return make_item("calc", "", f"{expression}  [calc] invalid")
    return make_item("calc", result, f"{expression} = {result}  [copy result]")


def pane_cwd() -> str:
    if os.environ.get("TMUX") and shutil.which("tmux"):
        try:
            result = subprocess.run(
                ["tmux", "display-message", "-p", "#{pane_current_path}"],
                capture_output=True,
                text=True,
                timeout=2,
                check=False,
            )
            path = result.stdout.strip()
            if path and os.path.isdir(path):
                return path
        except (OSError, subprocess.SubprocessError):
            pass
    current = os.getcwd()
    return current if os.path.isdir(current) else HOME


def notify(message: str) -> None:
    message = tr(message).replace("#", "##")
    if os.environ.get("TMUX") and shutil.which("tmux"):
        try:
            subprocess.run(
                ["tmux", "display-message", "-d", "2000", message],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=2,
                check=False,
            )
            return
        except (OSError, subprocess.SubprocessError):
            pass
    print(message, file=sys.stderr)


def run_hidden(command: list[str]) -> bool:
    try:
        result = subprocess.run(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return False
    return result.returncode == 0


def copy_payload(payload: str) -> None:
    if not payload:
        notify("cpz-search: nothing to copy")
        return
    if os.environ.get("TMUX") and shutil.which("tmux"):
        if run_hidden(["tmux", "set-buffer", "--", payload]):
            notify(f"Copied: {payload}")
        else:
            notify("cpz-search: cannot set the tmux buffer")
        return
    print(payload)


def unmount_media(device: str, mountpoint: str) -> None:
    """Unmount a drive through cpz-automount, asking sudo for root.

    The helper closes the disk tab before unmounting, and sudo prompts on the
    popup terminal first, so nothing runs while a password is missing.
    """
    label = os.path.basename(mountpoint.rstrip(os.sep)) or device
    executable = helper("cpz-automount")
    command = [executable, "umount", device]
    sudo = shutil.which("sudo")
    if sudo:
        command.insert(0, sudo)
    try:
        result = subprocess.run(command, check=False)
    except OSError as error:
        notify(f"cpz-search: cannot unmount {label}: {error}")
        return
    if result.returncode == 0:
        notify(f"Unmounted {label}")
    else:
        notify(f"cpz-search: cannot unmount {label}")


def open_media_tab(device: str, mountpoint: str) -> None:
    """Open a new tmux tab whose shell starts in the mounted filesystem.

    cpz-tab-new tags the window with CPZ_TAB_MOUNT, exactly like the hotplug
    tab, so cpz-automount closes it before the disk is unmounted instead of
    leaving a shell on a dead path.
    """
    if not (os.environ.get("TMUX") and shutil.which("tmux")):
        notify("cpz-search: not inside tmux")
        return
    executable = helper("cpz-tab-new")
    label = os.path.basename(mountpoint.rstrip(os.sep)) or device
    # Window names share the narrow status bar; cpz-tab-mount truncates the
    # disk label the same way.
    name = label[:16]
    environment = dict(os.environ)
    environment["CPZ_TAB_MOUNT"] = mountpoint
    try:
        result = subprocess.run(
            [executable, "main", mountpoint, name],
            env=environment,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError as error:
        notify(f"cpz-search: cannot open {label}: {error}")
        return
    if result.returncode != 0:
        notify(f"cpz-search: cannot open {label} in a new tab")


def run_power(action: str) -> None:
    """Confirm with tmux, then reboot or power off the device.

    A power action closes the popup and every tab, so the question is a tmux
    prompt, not another fzf list: the prompt stays on the client after
    cpz-search exits and only then runs the command. logind lets the active
    local seat do this without a password; sudo -n is only a fallback for
    images where that seat rule is unavailable.
    """
    entry = next((item for item in POWER_ACTIONS if item[0] == action), None)
    if entry is None:
        notify(f"cpz-search: unknown power action {action}")
        return
    _action, _label, question = entry
    if not (os.environ.get("TMUX") and shutil.which("tmux")):
        notify("cpz-search: power actions need tmux")
        return
    try:
        clients = subprocess.run(
            ["tmux", "list-clients", "-F", "#{client_name}"],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        clients = None
    client = ""
    if clients is not None and clients.returncode == 0:
        client = next(
            (line.strip() for line in clients.stdout.splitlines() if line.strip()),
            "",
        )
    if not client:
        notify("cpz-search: cannot ask the tmux client to confirm")
        return
    command = f"systemctl {action} || sudo -n systemctl {action}"
    if not run_hidden(
        [
            "tmux",
            "confirm-before",
            "-t",
            client,
            "-p",
            f"{tr(question)} (y/n)",
            f"run-shell -b {shlex.quote(command)}",
        ]
    ):
        notify("cpz-search: cannot open the confirmation prompt")


def launch(command: list[str], cwd: str | None = None) -> None:
    if not command:
        return
    runner = helper("cpz-run")
    directory = cwd or pane_cwd()
    if os.environ.get("TMUX") and shutil.which("tmux"):
        if not run_hidden(
            ["tmux", "new-window", "-c", directory, "--", runner, *command]
        ):
            notify(f"cpz-search: cannot launch {command[0]}")
        return
    try:
        os.chdir(directory)
        os.execvp(runner, [runner, *command])
    except OSError as error:
        notify(f"cpz-search: {error}")


def mime_type(path: str) -> str:
    try:
        result = subprocess.run(
            ["file", "--mime-type", "-b", "--", path],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip()


def open_file(path: str) -> None:
    if os.path.isdir(path):
        launch(["lf"], path)
        return
    mime = mime_type(path)
    is_text = (
        mime.startswith("text/")
        or mime in {"application/json", "application/xml", "application/x-empty"}
        or "script" in mime
    )
    directory = os.path.dirname(path) or HOME
    if is_text:
        launch(["vim", path], directory)
    else:
        launch(["less", path], directory)


def open_directory(path: str) -> None:
    directory = path if os.path.isdir(path) else os.path.dirname(path)
    launch(["lf"], directory or HOME)


def tmux_value(format_string: str) -> str:
    if not (os.environ.get("TMUX") and shutil.which("tmux")):
        return ""
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-p", format_string],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip()


def session_name() -> str:
    return tmux_value("#{session_name}") or "main"


def run_action(action: str, cwd: str) -> None:
    session = session_name()
    if action == "new-tab":
        run_hidden([helper("cpz-tab-new"), session])
    elif action == "close-tab":
        run_hidden([helper("cpz-tab-close-key"), session])
    elif action == "rename-tab":
        run_hidden(
            [
                "tmux",
                "command-prompt",
                "-p",
                "Rename tab:",
                "rename-window -- '%%'",
            ]
        )
    elif action == "list-tabs":
        run_hidden(["tmux", "choose-tree", "-Zw"])
    elif action in ("prev-tab", "next-tab"):
        run_hidden(
            [
                helper("cpz-tab-cycle"),
                session,
                "prev" if action == "prev-tab" else "next",
            ]
        )
    elif action.startswith("tab-") and action[4:].isdigit():
        run_hidden(["tmux", "select-window", "-t", f":{int(action[4:])}"])
    elif action == "split-right":
        run_hidden(["tmux", "split-window", "-h", "-c", cwd])
    elif action == "split-down":
        run_hidden(["tmux", "split-window", "-v", "-c", cwd])
    elif action == "next-pane":
        run_hidden(["tmux", "select-pane", "-t", ":.+"])
    elif action == "prev-pane":
        run_hidden(["tmux", "select-pane", "-t", ":.-"])
    elif action == "zoom-pane":
        run_hidden(["tmux", "resize-pane", "-Z"])
    elif action == "close-pane":
        run_hidden(
            ["tmux", "confirm-before", "-p", "Close pane? (y/n)", "kill-pane"]
        )
    elif action == "swap-pane-prev":
        run_hidden(["tmux", "swap-pane", "-U"])
    elif action == "swap-pane-next":
        run_hidden(["tmux", "swap-pane", "-D"])
    elif action == "copy-mode":
        run_hidden(["tmux", "copy-mode"])
    elif action == "paste-buffer":
        run_hidden(["tmux", "paste-buffer", "-p"])
    elif action in ("volume-up", "volume-down", "volume-mute"):
        run_hidden(
            [helper("cpz-volume"), action.removeprefix("volume-")]
        )
    elif action == "settings":
        run_hidden([helper("cpz-settings-open"), "main"])
    elif action == "help":
        launch([helper("cpz-help")], cwd)
    elif action == "font-up":
        run_hidden([helper("cpz-font"), "up"])
    elif action == "font-down":
        run_hidden([helper("cpz-font"), "down"])
    elif action == "layout-next":
        run_hidden([helper("cpz-layout-next")])
    elif action == "display-toggle":
        run_hidden([helper("cpz-display-toggle")])
    else:
        notify(f"cpz-search: unknown action {action}")


def exec_settings(*arguments: str) -> None:
    executable = settings_path()
    if not executable:
        notify("cpz-search: cpz-settings is not installed")
        return
    try:
        os.execv(executable, [executable, *arguments])
    except OSError as error:
        notify(f"cpz-search: {error}")


def open_settings(*arguments: str) -> None:
    """Show Settings in its own tab, never inside the CPZ Search popup.

    cpz-settings-open focuses the existing Settings tab and passes the page or
    tool target through a small request file, so the popup can close right away
    and the tab keeps living after q. Outside tmux (host runs, tests) the
    Settings TUI still runs in place.
    """
    helper_path = helper("cpz-settings-open")
    if (
        os.environ.get("TMUX")
        and shutil.which("tmux")
        and os.access(helper_path, os.X_OK)
    ):
        if not run_hidden([helper_path, *arguments, "main"]):
            notify("cpz-search: cannot open Settings in its tab")
        return
    exec_settings(*arguments)


def paste_buffer(name: str) -> None:
    if not (os.environ.get("TMUX") and shutil.which("tmux")):
        notify("cpz-search: not inside tmux")
        return
    if not run_hidden(["tmux", "paste-buffer", "-b", name, "-p"]):
        notify(f"cpz-search: cannot paste buffer {name}")


def dispatch(
    kind: str,
    payload: str,
    key: str,
    cwd: str,
    extra: str = "",
) -> None:
    if key == "ctrl-y":
        if kind == "tool" and extra:
            copy_payload(extra)
        else:
            copy_payload(payload)
        return
    if key == "ctrl-o":
        if kind == "file":
            open_directory(payload)
        elif kind == "app":
            open_directory(cwd)
        elif kind == "tool":
            open_settings("--tool", payload)
        return
    if kind == "app":
        launch([payload], cwd)
    elif kind == "file":
        open_file(payload)
    elif kind == "settings":
        open_settings("--page", payload)
    elif kind == "tool":
        if extra:
            launch([extra], cwd)
        else:
            # The app page holds the description and install instructions, and
            # `i` starts the install from there. Running apt in a new tab the
            # moment Enter was pressed made Search feel like it did two things
            # at once, so every non-runnable app lands on the same page.
            open_settings("--tool", payload)
    elif kind == "buffer":
        paste_buffer(payload)
    elif kind == "media-tab":
        open_media_tab(extra, payload)
    elif kind == "media":
        unmount_media(payload, extra)
    elif kind == "action":
        run_action(payload, cwd)
    elif kind == "power":
        run_power(payload)
    elif kind == "calc":
        copy_payload(payload)


def mode_bind(temp_directory: str) -> str:
    """Return the change:transform binding that switches providers.

    The state file keeps file search from re-running find(1) on every key.
    Calculator mode reloads on every key because the result changes with the
    expression. Other providers use reload(), not reload-sync(), so the popup
    stays interactive while the catalog and PATH scan run. $FZF_QUERY is used
    instead of {q} so quoting is not a concern.
    """
    executable = shlex.quote(self_path())
    state = shlex.quote(os.path.join(temp_directory, "mode"))
    query = shlex.quote(os.path.join(temp_directory, "query"))
    # Keep the snippet to if/elif: it stays a single POSIX line and avoids
    # case-statement syntax in a string parsed by both fzf and the login shell.
    code = (
        "q=$FZF_QUERY; "
        'first=$(printf %.1s "$q"); '
        'if [ "$first" = "/" ]; then m=files; '
        'elif [ "$first" = "=" ]; then m=calc; '
        "elif [ \"$first\" = '$' ]; then m=buffers; "
        'elif [ "$q" = apps ] || [ "${q#apps }" != "$q" ]; then m=apps; '
        'elif [ -z "$q" ]; then m=home; '
        "else m=default; fi; "
        'if [ "$m" = calc ]; then '
        f'printf %s "$m" > {state}; '
        f'printf %s "$q" > {query}; '
        f"printf 'reload-sync(%s --calc-file %s)\\n' {executable} {query}; "
        "exit 0; fi; "
        f'if [ "$(cat {state} 2>/dev/null)" = "$m" ]; then exit 0; fi; '
        f'printf %s "$m" > {state}; '
        'if [ "$m" = files ]; then '
        f"printf 'reload(%s --files)\\n' {executable}; "
        'elif [ "$m" = apps ]; then '
        f"printf 'reload(%s --apps)\\n' {executable}; "
        'elif [ "$m" = buffers ]; then '
        f"printf 'reload(%s --buffers)\\n' {executable}; "
        'elif [ "$m" = home ]; then '
        f"printf 'reload(%s --home)\\n' {executable}; "
        "else "
        f"printf 'reload(%s --default)\\n' {executable}; "
        "fi"
    )
    return f"change:transform:{code}"


def hint_for(kind: str, extra: str, flags: set[str]) -> str:
    if kind == "tool":
        if extra or "runnable" in flags:
            return tr("Enter run  Ctrl+Y copy  Ctrl+O info")
        return tr("Enter info  Ctrl+Y copy")
    if kind == "app":
        return tr("Enter run  Ctrl+Y copy  Ctrl+O folder")
    if kind == "action":
        return tr("Enter run action")
    if kind == "settings":
        return tr("Enter open Settings  Ctrl+Y copy")
    if kind == "file":
        return tr("Enter open  Ctrl+Y copy  Ctrl+O folder")
    if kind == "buffer":
        return tr("Enter paste  Ctrl+Y copy")
    if kind == "media-tab":
        return tr("Enter open in new tab  Ctrl+Y copy")
    if kind == "media":
        return tr("Enter unmount  Ctrl+Y copy")
    if kind == "power":
        return tr("Enter confirm  Ctrl+Y copy")
    if kind == "calc":
        return tr("Enter copy result")
    return tr("Enter open  Ctrl+Y copy")


def hint_line(text: str) -> str:
    """One-line footer for the highlighted item, shown by the fzf preview pane."""
    parsed = parse_item(text) if text else None
    if parsed is None:
        return tr("Type to search  / files  = calc  apps  $ buffers")
    kind, payload, _display, extra, flags = parsed
    if kind == "calc" and not payload:
        return tr("Type an expression")
    return hint_for(kind, extra, {flag for flag in flags.split(",") if flag})


def fzf_args(temp_directory: str) -> list[str]:
    executable = shlex.quote(self_path())
    return [
        "--layout=reverse",
        # Search uses the same single-line square frame as the Settings
        # dialogs: bold title in the top border, one blank row, content one
        # column inside, and a muted hint on the last row. The tmux popup
        # runs borderless (-B in cpz-keys) so this is the only frame.
        "--border=sharp",
        f"--border-label= {tr('Search')} ",
        "--border-label-pos=3",
        "--padding=1,1,0,0",
        "--no-separator",
        "--no-scrollbar",
        "--no-bold",
        # "bw" keeps the list monochrome; palette slot 8 is the theme's muted
        # colour, so the footer hint matches hint_attr() in cpz-settings.
        # label:bold keeps the modal title bold; --no-bold above applies to
        # the list text, not to the explicit label style.
        "--color=bw,label:bold,preview-fg:8",
        "--cycle",
        "--sync",
        "--info=inline-right",
        "--prompt=> ",
        "--pointer=>",
        "--marker=*",
        f"--delimiter={UNIT}",
        "--with-nth=3",
        "--expect=ctrl-y,ctrl-o",
        "--preview",
        f"{executable} --hint {{}}",
        "--preview-window=down,1,border-none,nowrap,noinfo",
        "--bind",
        "double-click:accept",
        "--bind",
        mode_bind(temp_directory),
    ]


def emit(items: list[str]) -> None:
    if items:
        sys.stdout.write("\n".join(items) + "\n")


def run_tui() -> int:
    fzf = shutil.which("fzf")
    if not fzf:
        notify("cpz-search: fzf is not installed")
        return 1

    cwd = pane_cwd()
    temp_directory = tempfile.mkdtemp(prefix="cpz-search-")
    try:
        with open(
            os.path.join(temp_directory, "mode"), "w", encoding="utf-8"
        ) as handle:
            handle.write("home")

        environment = os.environ.copy()
        environment.pop("FZF_DEFAULT_OPTS", None)
        environment.pop("FZF_DEFAULT_OPTS_FILE", None)
        environment["FZF_DEFAULT_OPTS_FILE"] = os.devnull

        result = subprocess.run(
            [fzf, *fzf_args(temp_directory)],
            input="\n".join(home_items()) + "\n",
            text=True,
            stdout=subprocess.PIPE,
            env=environment,
            check=False,
        )
        if result.returncode != 0 or not result.stdout:
            return 0

        lines = result.stdout.splitlines()
        key = lines[0] if lines else ""
        selected = lines[1] if len(lines) > 1 else ""
        parsed = parse_item(selected)
        if parsed is None:
            return 0
        kind, payload, _display, extra, _flags = parsed
        # dispatch() may exec the selected app or cpz-settings, which skips
        # the finally block; remove the provider state first.
        shutil.rmtree(temp_directory, ignore_errors=True)
        dispatch(kind, payload, key, cwd, extra)
        return 0
    finally:
        shutil.rmtree(temp_directory, ignore_errors=True)


def check() -> int:
    errors = []
    items = default_items()
    kinds = set()
    for line in items:
        parsed = parse_item(line)
        if parsed is None:
            errors.append("default item is malformed")
            continue
        kinds.add(parsed[0])
    for kind in ("action", "settings", "app"):
        if kind not in kinds:
            errors.append(f"missing {kind} items")

    home = home_items()
    home_kinds = set()
    home_payloads = []
    for line in home:
        parsed = parse_item(line)
        if parsed is None:
            errors.append("home item is malformed")
            continue
        home_kinds.add(parsed[0])
        home_payloads.append(parsed[1])
        if parsed[0] not in ("media", "media-tab", "action", "settings"):
            errors.append("home list must contain only media, actions or Settings")
            break
    for action_id in (*HOME_ACTION_IDS, "help"):
        if action_id not in home_payloads:
            errors.append(f"home list must contain {action_id}")
    for page, _title in HOME_SETTINGS_PAGES:
        if page not in home_payloads:
            errors.append(f"home list must contain Settings page {page}")
    if home_payloads and home_payloads[-1] != "help":
        errors.append("Help must be the last home item")
    if "settings" not in home_kinds:
        errors.append("home list must contain Settings pages")

    cases = (("=2+2", "4"), ("=10/4", "2.5"), ("=2**10", "1024"))
    for expression, expected in cases:
        parsed = parse_item(calc_item(expression))
        if parsed is None or parsed[1] != expected:
            errors.append(f"calc {expression}: expected {expected}")

    for expression in ("=__import__('os')", "=2**999"):
        parsed = parse_item(calc_item(expression))
        if parsed is None or parsed[1]:
            errors.append(f"calc {expression}: unsafe expression accepted")

    trove = parse_trove_payload(
        json.dumps(
            {
                "tools": [
                    {
                        "slug": "tmux",
                        "name": "tmux",
                        "summary": "terminal multiplexer",
                        "command": "tmux",
                        "installed": True,
                    }
                ]
            }
        )
    )
    parsed = parse_item(trove[0]) if trove else None
    if parsed != (
        "tool",
        "tmux",
        f"apps tmux  {tr('[run app]')}  terminal multiplexer",
        "tmux",
        "installed,runnable",
    ):
        errors.append("trove provider is malformed")

    if hint_line("") != tr("Type to search  / files  = calc  apps  $ buffers"):
        errors.append("empty hint is malformed")
    if hint_line(trove[0] if trove else "") != tr(
        "Enter run  Ctrl+Y copy  Ctrl+O info"
    ):
        errors.append("installed app hint is malformed")

    if errors:
        for message in errors:
            print(f"cpz-search: {message}", file=sys.stderr)
        return 1
    print(
        f"cpz-search: {len(home)} home items, {len(items)} search items, "
        "calculator and apps OK"
    )
    return 0


def main() -> int:
    arguments = sys.argv[1:]
    if "--check" in arguments:
        return check()
    if "--home" in arguments:
        emit(home_items())
        return 0
    if "--default" in arguments:
        emit(default_items())
        return 0
    if "--files" in arguments:
        emit(file_items())
        return 0
    if "--trove" in arguments or "--apps" in arguments:
        emit(trove_items())
        return 0
    if "--hint" in arguments:
        index = arguments.index("--hint")
        item = arguments[index + 1] if index + 1 < len(arguments) else ""
        print(hint_line(item))
        return 0
    if "--buffers" in arguments:
        emit(buffer_items())
        return 0
    if "--calc" in arguments:
        index = arguments.index("--calc")
        if index + 1 >= len(arguments):
            print("cpz-search: --calc needs an expression", file=sys.stderr)
            return 2
        emit([calc_item(arguments[index + 1])])
        return 0
    if "--calc-file" in arguments:
        index = arguments.index("--calc-file")
        if index + 1 >= len(arguments):
            print("cpz-search: --calc-file needs a path", file=sys.stderr)
            return 2
        try:
            with open(arguments[index + 1], "r", encoding="utf-8") as handle:
                expression = handle.read().strip()
        except OSError:
            return 0
        emit([calc_item(expression)])
        return 0

    if not sys.stdout.isatty():
        print("cpz-search: this is a TUI; run it from the terminal.", file=sys.stderr)
        return 1
    return run_tui()


if __name__ == "__main__":
    raise SystemExit(main())
