def load_keys_module() -> Any:
    """Load the shortcut registry next to this helper, or from /usr/local/bin."""
    candidates = [
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "cpz-keys"),
        "/usr/local/bin/cpz-keys",
    ]
    for path in candidates:
        if not os.path.isfile(path):
            continue
        try:
            loader = SourceFileLoader("cpz_keys", path)
            spec = spec_from_loader(loader.name, loader)
            if spec is None:
                continue
            module = module_from_spec(spec)
            loader.exec_module(module)
            return module
        except (ImportError, OSError):
            continue
    return None


_I18N_MODULE: Any = None


def i18n_module() -> Any:
    global _I18N_MODULE
    if _I18N_MODULE is not None:
        return _I18N_MODULE
    candidates = [
        os.environ.get("CPZ_I18N_SCRIPT", ""),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "cpz-i18n"),
        "/usr/local/bin/cpz-i18n",
    ]
    for path in candidates:
        if not path or not os.path.isfile(path):
            continue
        try:
            loader = SourceFileLoader("cpz_i18n", path)
            spec = spec_from_loader(loader.name, loader)
            if spec is None:
                continue
            module = module_from_spec(spec)
            loader.exec_module(module)
        except (ImportError, OSError):
            continue
        _I18N_MODULE = module
        return module
    raise FileNotFoundError("cpz-i18n is not installed")


_TR_LANGUAGE: str | None = None


def tr(text: object, **values: object) -> str:
    global _TR_LANGUAGE
    try:
        module = i18n_module()
        if _TR_LANGUAGE is None:
            _TR_LANGUAGE = module.current_language()
        return str(module.translate(str(text), _TR_LANGUAGE, **values))
    except (FileNotFoundError, AttributeError):
        return str(text)


def current_actions() -> tuple:
    module = load_keys_module()
    if module is None:
        return tuple(
            (action_id, tr(label), keys)
            for action_id, label, keys in FALLBACK_ACTIONS
        )
    bindings = module.effective_bindings()
    actions = []
    for action in module.ACTIONS:
        # Search is already open; listing itself would be a no-op.
        if action["id"] == "search":
            continue
        binding = bindings.get(action["id"], {})
        actions.append(
            (
                action["id"],
                tr(action["label"]),
                binding.get("display", "unbound") if binding.get("key") else "",
            )
        )
    return tuple(actions)


ACTIONS = current_actions()
CALC_LIMIT = 80
CALC_EXPONENT_LIMIT = 64
BIN_DIRS = (
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
    "/usr/local/sbin",
    "/usr/sbin",
    "/sbin",
)
