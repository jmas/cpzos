#!/bin/sh
# Key reference shown by Alt+H in a tmux popup.
#
# The list is taller than the 53x14 panel, so it is paged with less. -X keeps
# the popup contents on screen instead of switching the alternate screen and -F
# skips the pager when everything fits (for example on a large HDMI console).
keys() {
	cat <<'EOF'
CPZ keys
Every action below is a direct Alt+key binding: no tmux prefix is needed.
==== Tabs ====
 Alt+Left / Alt+Right  prev / next tab
 Alt+1 .. Alt+9        select tab
 Alt+T                 new tab
 Alt+W                 close tab (asks)
 Alt+R                 rename tab
 Alt+L                 list tabs
==== Panes ====
 Alt+V                 split left / right
 Alt+B                 split top / bottom
 Alt+N / Alt+P         next / previous pane
 Alt+Z                 zoom pane
 Alt+X                 close pane (asks)
 Alt+J / Alt+K         swap pane prev / next
==== Scroll and copy ====
 Alt+Up / Alt+Down     enter copy mode, scroll
 Alt+PageUp / PgDown   page history (full keyboard)
 Fn+L / Fn+M           page up / down
 Alt+C                 copy mode (vi keys)
 j / k or Up / Down    line down / up
 Space                 start / stop selection
 Enter                 copy selection
 q                     leave copy mode
 Alt+Y                 paste tmux buffer
==== Session and device ====
 Alt+Q                 detach
 Alt+S                 Settings
 Alt+H                 this help
 Alt+O                 search everything
 Alt+Plus / Alt+Minus  larger / smaller font (Sym+T / Sym+R)
 Ctrl+Plus / Ctrl+Minus  larger / smaller font
                       the size is saved in Settings
 Alt+I / Alt+Space     switch input layout
 Alt+D                 CPZ panel / auto display
 In Settings           Z/X/C/F move (Fn off)
==== Search (Alt+O) ====
 / files   = calc   @ tools   $ buffers
 Enter open/run   Ctrl+Y copy   Ctrl+O dir
EOF
}

if command -v less >/dev/null 2>&1; then
	keys | less -R -X -F -P 'q close'
	exit 0
fi

keys
printf '\nPress Enter to close.'
read -r _ || true
