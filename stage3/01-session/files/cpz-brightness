#!/bin/sh
# Apply the saved panel brightness. Runs as the logged-in user; the udev rule
# gives the video group write access to the backlight sysfs file.
set -eu

home=${HOME:-/root}
user_settings=${XDG_CONFIG_HOME:-$home/.config}/cpz/settings.conf
system_settings=/etc/cpz/settings.conf

get() {
	for file in "$user_settings" "$system_settings"; do
		[ -r "$file" ] || continue
		value=$(sed -n "s/^$1=//p" "$file" | tail -n 1)
		[ -n "$value" ] && { printf '%s' "$value"; return 0; }
	done
	return 0
}

percent=$(get brightness)
case "$percent" in
	'' | *[!0-9]*) percent=100 ;;
esac
[ "$percent" -ge 0 ] || percent=0
[ "$percent" -le 100 ] || percent=100

action=${1:-apply}
blank=0
case "$action" in
	up | down | wake)
		previous=$percent
		case "$action" in
			up) percent=$((percent + 10)) ;;
			down) percent=$((percent - 10)) ;;
			wake) [ "$percent" -ge 10 ] || percent=10 ;;
		esac
		[ "$percent" -ge 0 ] || percent=0
		[ "$percent" -le 100 ] || percent=100
		# Keep the stored level in step with the key, even when HDMI is the
		# active output and the panel is currently dark.
		if [ "$percent" != "$previous" ]; then
			mkdir -p "$(dirname "$user_settings")" 2>/dev/null || true
			tmp="${user_settings}.tmp.$$"
			if [ -r "$user_settings" ]; then
				awk -v level="$percent" '
					/^brightness=/ {
						if (!done) print "brightness=" level
						done = 1
						next
					}
					{ print }
					END { if (!done) print "brightness=" level }
				' "$user_settings" >"$tmp" || { rm -f "$tmp"; exit 1; }
			else
				printf '# CPZ user settings. Written by cpz-settings.\n' >"$tmp" || exit 1
				printf 'brightness=%s\n' "$percent" >>"$tmp" || exit 1
			fi
			chmod 0644 "$tmp" 2>/dev/null || true
			mv "$tmp" "$user_settings" 2>/dev/null || { rm -f "$tmp"; exit 1; }
		fi
		;;
	blank)
		# The screensaver lock blanks the panel without touching the saved
		# level; wake restores that level on the first key press.
		blank=1
		;;
	apply) ;;
	*)
		printf 'usage: %s [up|down|wake|blank]\n' "${0##*/}" >&2
		exit 2
		;;
esac

# While HDMI is the active output the panel is dark and its brightness is
# stored in the settings only; cpz-cage-output restores it when the session
# returns to the panel. Writing brightness here would wake the panel.
if [ -r /run/cpz-cage/output.state ] &&
	[ "$(sed -n 's/^target=//p' /run/cpz-cage/output.state | tail -n 1)" = hdmi ]; then
	exit 0
fi

if [ "$blank" = 1 ]; then
	if [ -x /usr/local/bin/cpz-panel-backlight ]; then
		if [ "$(id -u)" = 0 ]; then
			/usr/local/bin/cpz-panel-backlight off >/dev/null 2>&1 && exit 0
		else
			sudo -n /usr/local/bin/cpz-panel-backlight off \
				>/dev/null 2>&1 && exit 0
		fi
	fi
	for backlight in /sys/class/backlight/*; do
		[ -w "$backlight/brightness" ] || continue
		printf '0' >"$backlight/brightness" 2>/dev/null || true
	done
	exit 0
fi

# The PWM helper is the working control on this board (the backlight class is
# stuck in the kernel's blanked state); the class loop below stays as a
# fallback for other images.
if [ -x /usr/local/bin/cpz-panel-backlight ]; then
	if [ "$(id -u)" = 0 ]; then
		/usr/local/bin/cpz-panel-backlight on "$percent" >/dev/null 2>&1 &&
			exit 0
	else
		sudo -n /usr/local/bin/cpz-panel-backlight on "$percent" \
			>/dev/null 2>&1 && exit 0
	fi
fi

for backlight in /sys/class/backlight/*; do
	[ -r "$backlight/max_brightness" ] || continue
	max=$(cat "$backlight/max_brightness" 2>/dev/null || echo 0)
	[ "$max" -gt 0 ] 2>/dev/null || continue
	value=$((percent * max / 100))
	printf '%s' "$value" >"$backlight/brightness" 2>/dev/null || true
	break
done
