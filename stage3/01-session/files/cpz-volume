#!/bin/sh
# Change or mute the default audio output volume.
#
# Bound by the cpz-keys registry to Alt+U / Alt+I / Alt+0 by default (rebindable
# in Settings > Input > Shortcuts). PipeWire's wpctl is the same backend as
# Settings > Sound, so the status-bar volume token and the Settings page stay in
# sync. The step matches the 5% step used by the Sound page.
set -u

target=@DEFAULT_AUDIO_SINK@
step=5
action=${1:-}
translate() {
	key=$1
	shift
	message=$key
	if [ -x /usr/local/bin/cpz-i18n ]; then
		message=$(/usr/local/bin/cpz-i18n get "$key" "$key" "$@" 2>/dev/null ||
			printf '%s' "$key")
	fi
	while [ $# -gt 0 ]; do
		case $1 in
			--field) field=${2:-}; shift 2 ;;
			*) shift; continue ;;
		esac
		name=${field%%=*}
		value=${field#*=}
		[ -n "$name" ] &&
			message=$(printf '%s' "$message" | sed "s/{$name}/$value/g")
	done
	printf '%s' "$message"
}


case "$action" in
	up | down | mute) ;;
	*)
		printf 'usage: %s up|down|mute\n' "${0##*/}" >&2
		exit 2
		;;
esac

say() {
	if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
		tmux display-message -d 2000 "$1" >/dev/null 2>&1 || true
		tmux refresh-client -S >/dev/null 2>&1 || true
	fi
}

if ! command -v wpctl >/dev/null 2>&1; then
	say "volume: wpctl not available"
	exit 1
fi

status=$(wpctl get-volume "$target" 2>/dev/null) || status=
[ -n "$status" ] || {
	say "volume: no audio output"
	exit 1
}

# wpctl only accepts a dot as the decimal separator, so never let the user's
# locale turn "0.05" into "0,05" (a comma locale used to make every change
# fail silently, including the headphone volume buttons).
percent=$(printf '%s\n' "$status" | LC_ALL=C awk '{ printf "%d", ($2 * 100) + 0.5 }')
case "$percent" in
	'' | *[!0-9]*) percent=0 ;;
esac

case "$action" in
	mute)
		wpctl set-mute "$target" toggle >/dev/null 2>&1 || exit 1
		;;
	up)
		percent=$((percent + step))
		[ "$percent" -le 100 ] || percent=100
		volume=$(LC_ALL=C awk -v p="$percent" 'BEGIN { printf "%.2f", p / 100 }')
		wpctl set-volume "$target" "$volume" >/dev/null 2>&1 || exit 1
		;;
	down)
		percent=$((percent - step))
		[ "$percent" -ge 0 ] || percent=0
		volume=$(LC_ALL=C awk -v p="$percent" 'BEGIN { printf "%.2f", p / 100 }')
		wpctl set-volume "$target" "$volume" >/dev/null 2>&1 || exit 1
		;;
esac

status=$(wpctl get-volume "$target" 2>/dev/null) || status=
case "$status" in
	*MUTED*) say "volume: muted" ;;
	*)
		percent=$(printf '%s\n' "$status" |
			LC_ALL=C awk '{ printf "%d", ($2 * 100) + 0.5 }')
		say "$(translate 'volume: {percent}%' 'volume: {percent}%' \
			--field "percent=$percent")"
		;;
esac
