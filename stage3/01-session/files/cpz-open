#!/bin/sh
# Open an image, a video or a track with the CPZ media players.
#
# Midnight Commander calls this through MC_XDG_OPEN (set in the tmux
# environment) and lf through its `open` command. Images and videos open as a
# gallery/playlist of the whole directory the file lives in, starting with the
# file that was opened. Anything unknown exits 1 so the caller keeps its own
# text handling.
#
# The viewers must not use the GPU: cage renders with pixman and cannot import
# dmabuf, so an EGL/GL window stays black. mpv therefore gets the wlshm output
# (software rendering into wl_shm) and imv uses its native Wayland backend.
set -eu

[ "$#" -ge 1 ] || exit 1
case "$1" in
	-*) exit 1 ;;
esac

# A card written on macOS carries AppleDouble sidecars ("._track.mp3", 4 KiB,
# application/octet-stream) next to every real file, and they sort first in mc.
# Opening one should open the file it describes instead of doing nothing.
case "${1##*/}" in
	._*)
		dir=$(dirname -- "$1")
		real="$dir/$(printf '%s' "${1##*/}" | cut -c3-)"
		if [ -e "$real" ]; then
			shift
			set -- "$real" "$@"
		fi
		;;
esac

mime=$(file -b --mime-type -- "$1" 2>/dev/null || true)
case "$mime" in
	image/*) kind=image ;;
	video/*) kind=video ;;
	audio/*) kind=audio ;;
	*) exit 1 ;;
esac

file=$1
dir=$(dirname -- "$file")

# Images and video start with the opened file, then the rest of its directory
# in name order: imv treats its arguments as a gallery, mpv as a playlist.
# Hidden entries are metadata (macOS ._ sidecars, .Trashes, ...), not media.
#
# The extension filter is one awk process, not one tr(1) per file: a folder
# with a thousand photos otherwise needs a thousand forks before the viewer
# even starts.
if [ "$kind" != audio ]; then
	queue=$(mktemp "${TMPDIR:-/tmp}/cpz-open.XXXXXX") || exit 1
	trap 'rm -f -- "$queue"' EXIT HUP INT TERM
	{
		printf '%s\n' "$file"
		find "$dir" -maxdepth 1 -type f ! -name '.*' -print |
			LC_ALL=C sort |
			awk -v skip="$file" -v kind="$kind" '
				BEGIN {
					if (kind == "image")
						exts = "jpg jpeg jpe jfif png gif bmp ico tga tif tiff webp svg svgz heic heif avif jxl psd ppm pgm pbm pnm cr2 cr3 crw nef nrw arw sr2 srf dng orf raf rw2 raw pef srw x3f"
					else
						exts = "mp4 m4v mkv webm avi mov qt mpg mpeg m2v m2ts mts ts wmv flv f4v ogv ogm 3gp 3g2 vob divx asf rm rmvb"
					n = split(exts, list, " ")
					for (i = 1; i <= n; i++)
						ok[list[i]] = 1
				}
				$0 == skip { next }
				{
					ext = $0
					sub(/^.*\./, "", ext)
					if (tolower(ext) in ok)
						print
				}
			'
	} >"$queue"
	set --
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		set -- "$@" "$f"
	done <"$queue"
	rm -f -- "$queue"
	trap - EXIT HUP INT TERM
fi
[ "$#" -ge 1 ] || set -- "$file"

# mc runs the open command as ${MC_XDG_OPEN} ... || do_open_action, so a
# non-zero exit starts a second viewer (mpv --really-quiet, mplayer, ...).
# Ctrl+C lands in the whole foreground group: keep the shell alive so the
# viewer's status is swallowed and the caller gets success.
case "$kind" in
	image)
		if command -v imv-wayland >/dev/null 2>&1; then
			trap ':' INT TERM
			/usr/local/bin/cpz-run imv-wayland "$@" || true
			exit 0
		fi
		;;
	video)
		if command -v mpv >/dev/null 2>&1; then
			trap ':' INT TERM
			/usr/local/bin/cpz-run mpv --vo=wlshm --hwdec=no "$@" || true
			exit 0
		fi
		;;
	audio)
		# A TUI player runs in the current pane, not in a Wayland window; it
		# queues the whole directory so the folder keeps playing.
		if command -v cmus >/dev/null 2>&1; then
			trap ':' INT TERM
			/usr/local/bin/cpz-music "$file" || true
			exit 0
		fi
		;;
esac
exit 1
