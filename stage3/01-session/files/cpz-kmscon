#!/bin/sh
# Start kmscon with the generated CPZ configuration and autologin wrapper.
#
# The systemd template passes the VT name (tty1). Keeping the VT and the
# autologin resolution in a wrapper means rpi-preseed can rename uid 1000
# without editing a systemd unit.
#
# The config is rendered from /etc/cpz/settings.conf on every start. kmscon
# only reads it at startup, so cpz-kmscon-output restarts this unit when the
# rendered file changes (font size, theme, timeout, output). Keyboard layouts
# are pushed through systemd-localed and change in place.
#
# tty1 switches to its own VT on start: that vt_enter() is what puts the VT in
# KD_GRAPHICS and gives kmscon control of the DRM console. Other VTs must not
# use --switchvt, or they would fight over the foreground VT at boot.
set -eu

vt=${1:-tty1}
case "$vt" in
	tty[0-9]*) ;;
	[0-9]*) vt="tty$vt" ;;
	*) vt=tty1 ;;
esac

/usr/local/bin/cpz-kmscon-config >/dev/null 2>&1 || true

if [ "$vt" = tty1 ]; then
	exec /usr/bin/kmscon \
		--configdir /run/cpz-kmscon \
		--vt="$vt" \
		--switchvt \
		--login -- /usr/local/bin/cpz-login "$vt"
fi

exec /usr/bin/kmscon \
	--configdir /run/cpz-kmscon \
	--vt="$vt" \
	--no-switchvt \
	--login -- /usr/local/bin/cpz-login "$vt"
