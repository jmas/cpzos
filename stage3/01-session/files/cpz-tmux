#!/bin/sh
# Attach the CPZ tmux session to the foot terminal started by cage.
#
# The tmux server is started by cpz-tmux.service, so it survives a compositor
# restart. This helper only needs to create the server if it disappeared and
# then attach the terminal client.
set -eu

if ! tmux has-session -t '=main' 2>/dev/null; then
	/usr/local/bin/cpz-tmux-start || true
fi

# The tmux server was started before cage. Publish the values cage gave this
# foot process so Search, Settings and direct shell commands can reach the
# compositor. The global tmux environment covers new panes; cpz-run covers
# commands started from the older shell panes.
client_env=/run/cpz-cage/client.env
if [ -d "${client_env%/*}" ]; then
	tmp=$client_env.$$
	if {
		[ -n "${WAYLAND_DISPLAY:-}" ] &&
			printf "WAYLAND_DISPLAY='%s'\n" "$WAYLAND_DISPLAY"
		[ -n "${DISPLAY:-}" ] && printf "DISPLAY='%s'\n" "$DISPLAY"
		[ -n "${XAUTHORITY:-}" ] &&
			printf "XAUTHORITY='%s'\n" "$XAUTHORITY"
		[ -n "${XDG_RUNTIME_DIR:-}" ] &&
			printf "XDG_RUNTIME_DIR='%s'\n" "$XDG_RUNTIME_DIR"
	} >"$tmp" 2>/dev/null; then
		mv "$tmp" "$client_env" 2>/dev/null || rm -f "$tmp"
	else
		rm -f "$tmp"
	fi
fi
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
	tmux set-environment -g WAYLAND_DISPLAY "$WAYLAND_DISPLAY" 2>/dev/null || true
fi
if [ -n "${DISPLAY:-}" ]; then
	tmux set-environment -g DISPLAY "$DISPLAY" 2>/dev/null || true
fi
if [ -n "${XAUTHORITY:-}" ]; then
	tmux set-environment -g XAUTHORITY "$XAUTHORITY" 2>/dev/null || true
fi
# Only the cage fallback needs SDL forced onto the software path (pixman cannot
# import dmabuf). Keep the SDL software path.
tmux set-environment -g SDL_VIDEODRIVER wayland 2>/dev/null || true
tmux set-environment -g SDL_RENDER_DRIVER software 2>/dev/null || true

# mc's image/video helpers open files through MC_XDG_OPEN. Point them at the
# CPZ dispatcher so Enter launches imv/mpv instead of a missing desktop
# opener.
tmux set-environment -g MC_XDG_OPEN /usr/local/bin/cpz-open 2>/dev/null || true

# The factory-password reminder is a client-attached popup
# (cpz-first-login-popup). It must not run here: this process becomes
# `tmux attach`, and a prompt before the attach delays the first frame.
exec tmux attach-session -t '=main'
