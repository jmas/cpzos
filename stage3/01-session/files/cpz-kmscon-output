#!/bin/sh
# Keep the CPZ kmscon session on exactly one usable display.
#
# Policy:
#   HDMI connected and usable (EDID, or a pinned video= mode) -> HDMI, and the
#     internal panel backlight is switched off
#   otherwise -> the internal panel, with the backlight restored
#   display=panel|hdmi in settings overrides the automatic choice
#   --auto / --panel / --hdmi override settings for one run
#   --force re-renders the kmscon config and restarts the session
#   --recover re-applies the HDMI link and restarts the session
#   --status prints the decision without changing anything
#
# kmscon has no runtime API and does not re-probe connectors on hotplug, so
# both the display decision and the rendered configuration are applied by
# restarting kmsconvt@tty1. The tmux server is started detached, so a restart
# only replaces the terminal client: tabs, panes and running programs survive.
#
# The internal panel is not disabled at the DRM level. kmscon keeps drawing
# the same layout on it (multi-monitor=scaled); switching the backlight off is
# what makes it dark and what saves the power. On the panel side the backlight
# is restored before the restart, so a failed kmscon start never leaves the
# machine with no visible output.
set -eu

force=0
status_mode=0
recover=0
override=""
for arg in "$@"; do
	case "$arg" in
		--auto) override=auto ;;
		--panel) override=panel; force=1 ;;
		--hdmi) override=hdmi; force=1 ;;
		--force) force=1 ;;
		--recover) recover=1; force=1 ;;
		--status) status_mode=1 ;;
	esac
done

run_dir=/run/cpz-kmscon
state_file=$run_dir/output.state
pending_file=$run_dir/output.pending
unit=kmsconvt@tty1.service
# Samples needed before moving the session *to* HDMI. A monitor can pulse HPD
# while it powers up or renegotiates, and the panel is dark on the other side
# of the switch, so the HDMI direction is debounced. Returning to the panel is
# immediate.
hdmi_debounce=2

first_home=$(getent passwd 1000 2>/dev/null | cut -d: -f6 || true)
[ -n "$first_home" ] || first_home=/root

log() {
	command -v logger >/dev/null 2>&1 && logger -t cpz-kmscon-output "$*" ||
		true
}

get_setting() {
	for file in "$first_home/.config/cpz/settings.conf" /etc/cpz/settings.conf; do
		[ -r "$file" ] || continue
		value=$(sed -n "s/^$1=//p" "$file" | tail -n 1)
		[ -n "$value" ] && { printf '%s' "$value"; return 0; }
	done
	return 0
}

hdmi_probe() {
	# Sets: hdmi_connected (0/1), hdmi_edid (bytes), hdmi_pinned (0/1).
	hdmi_connected=0
	hdmi_edid=0
	connector=""
	for dir in /sys/class/drm/card*-HDMI-A-*; do
		[ -e "$dir/status" ] || continue
		[ -n "$connector" ] || connector=${dir##*/}
		if [ "$(cat "$dir/status" 2>/dev/null || true)" = connected ]; then
			hdmi_connected=1
		fi
		size=$(wc -c <"$dir/edid" 2>/dev/null || printf 0)
		size=$(printf '%s' "$size" | tr -dc '0-9')
		[ -n "$size" ] || size=0
		[ "$size" -gt "$hdmi_edid" ] && hdmi_edid=$size
	done
	hdmi_pinned=0
	# shellcheck disable=SC2013  # kernel cmdline tokens are whitespace-separated
	for token in $(cat /proc/cmdline 2>/dev/null || true); do
		case "$token" in
			video=HDMI-A-[0-9]*:[0-9]*x[0-9]*) hdmi_pinned=1 ;;
		esac
	done
}

panel_off() {
	# Zero the brightness *and* power the backlight down. The m5stack driver
	# honours bl_power, but zeroing brightness as well keeps the panel dark on
	# drivers that ignore it. panel_on restores the value from the settings.
	for light in /sys/class/backlight/*; do
		[ -e "$light" ] || continue
		if [ -w "$light/brightness" ] &&
			[ "$(cat "$light/brightness" 2>/dev/null || true)" != 0 ]; then
			printf '0' >"$light/brightness" 2>/dev/null || true
		fi
		if [ -w "$light/bl_power" ] &&
			[ "$(cat "$light/bl_power" 2>/dev/null || true)" != 4 ]; then
			printf '4' >"$light/bl_power" 2>/dev/null || true
		fi
	done
	return 0
}

panel_on() {
	percent=$(get_setting brightness)
	case "$percent" in
		'' | *[!0-9]*) percent=100 ;;
	esac
	[ "$percent" -ge 1 ] || percent=1
	[ "$percent" -le 100 ] || percent=100
	for light in /sys/class/backlight/*; do
		[ -e "$light" ] || continue
		if [ -w "$light/bl_power" ] &&
			[ "$(cat "$light/bl_power" 2>/dev/null || true)" != 0 ]; then
			printf '0' >"$light/bl_power" 2>/dev/null || true
		fi
		[ -w "$light/brightness" ] || continue
		max=$(cat "$light/max_brightness" 2>/dev/null || true)
		case "$max" in
			'' | *[!0-9]* | 0) continue ;;
		esac
		value=$((percent * max / 100))
		[ "$value" -ge 1 ] || value=1
		[ "$(cat "$light/brightness" 2>/dev/null || true)" = "$value" ] ||
			printf '%s' "$value" >"$light/brightness" 2>/dev/null || true
	done
}

hdmi_has_crtc() {
	# True when a connected HDMI connector has a CRTC attached. Returns true
	# when the kernel does not expose the state file, so an unknown sysfs
	# layout never hides a working panel.
	known=0
	for dir in /sys/class/drm/card*-HDMI-A-*; do
		[ -e "$dir/status" ] || continue
		[ -e "$dir/enabled" ] || continue
		known=1
		[ "$(cat "$dir/status" 2>/dev/null || true)" = connected ] || continue
		if [ "$(cat "$dir/enabled" 2>/dev/null || true)" = enabled ]; then
			return 0
		fi
	done
	if [ "$known" = 1 ]; then
		return 1
	fi
	return 0
}

hdmi_fallback() {
	# Leave the panel visible and block another HDMI attempt for a minute so
	# a monitor that is present but cannot be driven does not restart the
	# session on every timer tick.
	log "$1"
	panel_on
	printf 'target=panel\nmode=%s\nfail_until=%s\n' "$mode" \
		"$((now + 60))" >"$state_file"
	exit 0
}

restart_session() {
	if ! systemctl restart "$unit" >/dev/null 2>&1; then
		log "restart $unit failed"
		return 1
	fi
	tries=0
	while [ "$tries" -lt 50 ]; do
		systemctl is-active --quiet "$unit" && break
		sleep 0.2
		tries=$((tries + 1))
	done
	# kmscon sets the initial mode right after exec; give it a moment before
	# the panel is blanked so a failed start stays visible.
	sleep 0.7
	systemctl is-active --quiet "$unit"
}

hdmi_probe
mode=${override:-$(get_setting display)}
case "$mode" in
	panel | hdmi | auto) ;;
	*) mode=auto ;;
esac
if [ "$hdmi_connected" = 1 ] &&
	{ [ "$hdmi_edid" -ge 128 ] || [ "$hdmi_pinned" = 1 ]; }; then
	hdmi_usable=1
else
	hdmi_usable=0
fi

case "$mode" in
	panel) target=panel ;;
	hdmi)
		[ "$hdmi_connected" = 1 ] && target=hdmi || target=panel
		;;
	*)
		[ "$hdmi_usable" = 1 ] && target=hdmi || target=panel
		;;
esac

configured_target=$(sed -n 's/^target=//p' "$state_file" 2>/dev/null |
	tail -n 1)
fail_until=$(sed -n 's/^fail_until=//p' "$state_file" 2>/dev/null |
	tail -n 1)
now=$(date +%s 2>/dev/null || printf 0)
case "$now" in
	'' | *[!0-9]*) now=0 ;;
esac

# A failed HDMI start is retried with a backoff so a monitor that is present
# but cannot be driven does not restart the session every two seconds.
if [ "$target" = hdmi ] && [ "$force" = 0 ] && [ -n "$fail_until" ]; then
	case "$fail_until" in
		*[!0-9]*) ;;
		*) [ "$fail_until" -gt "$now" ] && target=panel ;;
	esac
fi

# The debug image masks kmsconvt@tty1 and runs a plain fbcon getty instead.
# Leave the console alone there; the udev rule still starts this unit.
if [ -L /etc/systemd/system/kmsconvt@tty1.service ]; then
	if [ "$status_mode" = 1 ]; then
		printf 'session : masked (fbcon debug image)\n'
	fi
	exit 0
fi

if [ "$status_mode" = 1 ]; then
	printf 'mode    : %s%s\n' "$mode" \
		"$([ -n "$override" ] && printf ' (command line)')"
	printf 'HDMI    : %s, EDID %s bytes, pinned %s\n' \
		"$([ "$hdmi_connected" = 1 ] && printf connected || printf disconnected)" \
		"$hdmi_edid" \
		"$([ "$hdmi_pinned" = 1 ] && printf yes || printf no)"
	printf 'target  : %s\n' "$target"
	printf 'current : %s\n' "${configured_target:-unknown}"
	for light in /sys/class/backlight/*; do
		[ -e "$light" ] || continue
		printf 'panel   : %s brightness=%s/%s bl_power=%s\n' \
			"${light##*/}" \
			"$(cat "$light/brightness" 2>/dev/null || true)" \
			"$(cat "$light/max_brightness" 2>/dev/null || true)" \
			"$(cat "$light/bl_power" 2>/dev/null || true)"
	done
	printf 'session : %s\n' \
		"$(systemctl is-active "$unit" 2>/dev/null || true)"
	exit 0
fi

config_state=$(/usr/local/bin/cpz-kmscon-config 2>/dev/null || printf 'error')
if [ "$config_state" = error ]; then
	# Keep the last good config instead of restarting kmscon every tick.
	log "kmscon config render failed"
fi

# A fresh boot has no state file. Without HDMI the panel is already correct,
# so adopt it instead of restarting the session. With HDMI the session is
# restarted once before the panel is darkened: if kmscon cannot take the HDMI
# card, the failure path keeps the panel visible.
if [ -z "$configured_target" ] && [ "$config_state" = same ] &&
	[ "$target" = panel ]; then
	configured_target=$target
fi

# Recover a stale HDMI link: cycle the connector DPMS before kmscon restarts.
if [ "$recover" = 1 ]; then
	for dpms in /sys/class/drm/card*-HDMI-A-*/dpms; do
		[ -w "$dpms" ] || continue
		printf 'Off' >"$dpms" 2>/dev/null || true
		sleep 0.3
		printf 'On' >"$dpms" 2>/dev/null || true
	done
fi

# Debounce the HDMI direction in auto mode. A forced panel/HDMI choice and a
# --force/--recover run are explicit and apply immediately.
if [ "$target" = hdmi ] && [ "$configured_target" != hdmi ] &&
	[ "$force" = 0 ] && [ "$mode" = auto ]; then
	count=$(cat "$pending_file" 2>/dev/null || printf 0)
	case "$count" in
		'' | *[!0-9]*) count=0 ;;
	esac
	count=$((count + 1))
	printf '%s\n' "$count" >"$pending_file"
	if [ "$count" -lt "$hdmi_debounce" ]; then
		log "pending HDMI switch ($count/$hdmi_debounce)"
		exit 0
	fi
fi
rm -f "$pending_file"

apply=0
[ "$force" = 1 ] && apply=1
[ "$target" != "$configured_target" ] && apply=1
[ "$config_state" = changed ] && apply=1

if [ "$target" = hdmi ]; then
	if [ "$apply" = 1 ]; then
		if ! restart_session; then
			hdmi_fallback "HDMI start failed; keeping the panel on"
		fi
		if ! hdmi_has_crtc; then
			hdmi_fallback "HDMI connector stayed disabled; keeping the panel on"
		fi
	fi
	panel_off
	if [ "$apply" = 1 ]; then
		log "output: HDMI (panel backlight off)"
	fi
else
	# Restore the panel first: if kmscon then fails to come up, the machine
	# still has a visible screen.
	panel_on
	if [ "$apply" = 1 ]; then
		restart_session || true
		log "output: CPZ panel"
	fi
fi

tmp=$state_file.tmp.$$
{
	printf 'target=%s\nmode=%s\n' "$target" "$mode"
	# Keep an active HDMI failure backoff across ticks; it is dropped once it
	# expires or a successful start rewrites the state without it.
	case "$fail_until" in
		'' | *[!0-9]*) ;;
		*)
			if [ "$fail_until" -gt "$now" ]; then
				printf 'fail_until=%s\n' "$fail_until"
			fi
			;;
	esac
} >"$tmp"
mv "$tmp" "$state_file"
