#!/bin/sh
# Keep the CPZ kmscon session on exactly one usable display.
#
# Policy:
#   display=auto (default): HDMI when a monitor with a readable EDID is
#     attached (or a video= mode is pinned); once the session is on HDMI it
#     stays there while the connector is connected, so a monitor that
#     momentarily drops its EDID cannot bounce the panel.
#   display=hdmi: HDMI while a monitor is connected, panel otherwise.
#   display=panel: the panel; kmscon is rendered in clone mode so the panel is
#     drawn even while HDMI is attached.
#   --auto / --panel / --hdmi: override the setting for one run.
#   --force: re-render the kmscon configuration and restart the session.
#   --recover: restart the session (HDMI link recovery).
#   --status: print the decision and the DRM connector state.
#
# kmscon itself handles display hotplug: displays are added and removed, and
# multi-monitor=largest makes it draw on the largest screen and stop drawing
# on the others. This helper therefore does NOT restart kmscon when a monitor
# is plugged or unplugged. A restart drops DRM master, which makes the monitor
# renegotiate the link (the "monitor turns off and on" symptom). Restarts are
# limited to configuration changes, an explicit --force/--recover, and a
# hotplug that kmscon missed.
#
# Only the backlight is switched here. The panel is darkened only when kmscon
# reports the HDMI connector as enabled, so a missed hotplug leaves a visible
# panel instead of a black machine.
set -eu

force=0
status_mode=0
recover=0
override=""
for arg in "$@"; do
	case "$arg" in
		--auto) override=auto ;;
		--panel) override=panel; force=1 ;;
		--hdmi) override=hdmi; force=1 ;;
		--force) force=1 ;;
		--recover) recover=1; force=1 ;;
		--status) status_mode=1 ;;
	esac
done

run_dir=/run/cpz-kmscon
mkdir -p "$run_dir" 2>/dev/null || true
state_file=$run_dir/output.state
pending_file=$run_dir/output.pending
miss_file=$run_dir/output.hdmi-miss
unit=kmsconvt@tty1.service
# Samples needed before moving the session *to* HDMI: a monitor can pulse HPD
# while it powers up. Returning to the panel is immediate.
hdmi_debounce=2
# Consecutive ticks with HDMI connected but no CRTC before kmscon is restarted
# (a hotplug it missed). Three ticks are about six seconds.
hdmi_miss_ticks=3
# After a restart that still did not enable HDMI, do not try again for a while.
hdmi_fail_backoff=60

first_home=$(getent passwd 1000 2>/dev/null | cut -d: -f6 || true)
[ -n "$first_home" ] || first_home=/root

log() {
	command -v logger >/dev/null 2>&1 && logger -t cpz-kmscon-output "$*" ||
		true
}

get_setting() {
	for file in "$first_home/.config/cpz/settings.conf" /etc/cpz/settings.conf; do
		[ -r "$file" ] || continue
		value=$(sed -n "s/^$1=//p" "$file" | tail -n 1)
		[ -n "$value" ] && { printf '%s' "$value"; return 0; }
	done
	return 0
}

hdmi_probe() {
	# Sets: hdmi_connected, hdmi_edid (bytes), hdmi_pinned, hdmi_enabled and
	# drm_state (one "name status enabled" line per DRM connector).
	hdmi_connected=0
	hdmi_edid=0
	hdmi_enabled=0
	drm_state=""
	for dir in /sys/class/drm/card*-*; do
		[ -e "$dir/status" ] || continue
		name=${dir##*/}
		status=$(cat "$dir/status" 2>/dev/null || true)
		enabled=$(cat "$dir/enabled" 2>/dev/null || true)
		drm_state="${drm_state}${drm_state:+, }$name ${status:-unknown}/${enabled:-unknown}"
		case "$name" in
			*HDMI-A-*)
				if [ "$status" = connected ]; then
					hdmi_connected=1
					[ "$enabled" = enabled ] && hdmi_enabled=1
					size=$(wc -c <"$dir/edid" 2>/dev/null || printf 0)
					size=$(printf '%s' "$size" | tr -dc '0-9')
					[ -n "$size" ] || size=0
					[ "$size" -gt "$hdmi_edid" ] && hdmi_edid=$size
				fi
				;;
		esac
	done
	hdmi_pinned=0
	# shellcheck disable=SC2013  # kernel cmdline tokens are whitespace-separated
	for token in $(cat /proc/cmdline 2>/dev/null || true); do
		case "$token" in
			video=HDMI-A-[0-9]*:[0-9]*x[0-9]*) hdmi_pinned=1 ;;
		esac
	done
}

nudge_drm() {
	# vc4 sends connector hotplug uevents on card0-HDMI-A-1. kmscon only
	# reacts to HOTPLUG=1 on the card device itself, so re-emit a card-level
	# change; 99-cpz-kmscon-nudge.rules marks it HOTPLUG=1 and kmscon
	# re-scans its connectors. This is what makes HDMI plug/unplug work
	# without restarting the session (and drops DRM master).
	for uevent in /sys/class/drm/card[0-9]*/uevent; do
		[ -w "$uevent" ] || continue
		printf 'change' >"$uevent" 2>/dev/null || true
	done
}

panel_off() {
	# Zero the brightness *and* power the backlight down. The m5stack driver
	# honours bl_power, but zeroing brightness as well keeps the panel dark on
	# drivers that ignore it. panel_on restores the value from the settings.
	for light in /sys/class/backlight/*; do
		[ -e "$light" ] || continue
		if [ -w "$light/brightness" ] &&
			[ "$(cat "$light/brightness" 2>/dev/null || true)" != 0 ]; then
			printf '0' >"$light/brightness" 2>/dev/null || true
		fi
		if [ -w "$light/bl_power" ] &&
			[ "$(cat "$light/bl_power" 2>/dev/null || true)" != 4 ]; then
			printf '4' >"$light/bl_power" 2>/dev/null || true
		fi
	done
	return 0
}

panel_on() {
	percent=$(get_setting brightness)
	case "$percent" in
		'' | *[!0-9]*) percent=100 ;;
	esac
	[ "$percent" -ge 1 ] || percent=1
	[ "$percent" -le 100 ] || percent=100
	for light in /sys/class/backlight/*; do
		[ -e "$light" ] || continue
		if [ -w "$light/bl_power" ] &&
			[ "$(cat "$light/bl_power" 2>/dev/null || true)" != 0 ]; then
			printf '0' >"$light/bl_power" 2>/dev/null || true
		fi
		[ -w "$light/brightness" ] || continue
		max=$(cat "$light/max_brightness" 2>/dev/null || true)
		case "$max" in
			'' | *[!0-9]* | 0) continue ;;
		esac
		value=$((percent * max / 100))
		[ "$value" -ge 1 ] || value=1
		[ "$(cat "$light/brightness" 2>/dev/null || true)" = "$value" ] ||
			printf '%s' "$value" >"$light/brightness" 2>/dev/null || true
	done
}

session_up() {
	# "activating" counts as up: kmscon needs a few seconds to draw, and a
	# restart in that window would loop at boot.
	systemctl is-active --quiet "$unit" ||
		systemctl is-activating --quiet "$unit"
}

restart_session() {
	if ! systemctl restart "$unit" >/dev/null 2>&1; then
		log "restart $unit failed"
		return 1
	fi
	tries=0
	while [ "$tries" -lt 50 ]; do
		systemctl is-active --quiet "$unit" && break
		sleep 0.2
		tries=$((tries + 1))
	done
	# kmscon sets the initial mode right after exec.
	sleep 0.7
	systemctl is-active --quiet "$unit"
}

hdmi_probe
conn_fingerprint="$hdmi_connected/$hdmi_edid/$hdmi_pinned"
mode=${override:-$(get_setting display)}
case "$mode" in
	panel | hdmi | auto) ;;
	*) mode=auto ;;
esac
if [ "$hdmi_connected" = 1 ] &&
	{ [ "$hdmi_edid" -ge 128 ] || [ "$hdmi_pinned" = 1 ]; }; then
	hdmi_usable=1
else
	hdmi_usable=0
fi

configured_target=$(sed -n 's/^target=//p' "$state_file" 2>/dev/null |
	tail -n 1)
retry_after=$(sed -n 's/^retry_after=//p' "$state_file" 2>/dev/null |
	tail -n 1)
last_conn=$(cat "$run_dir/conn.state" 2>/dev/null || true)
start_fail_until=$(cat "$run_dir/start-fail" 2>/dev/null || printf 0)
case "$start_fail_until" in
	'' | *[!0-9]*) start_fail_until=0 ;;
esac
fail_conn=$(sed -n 's/^fail_conn=//p' "$state_file" 2>/dev/null | tail -n 1)
fail_edid=$(sed -n 's/^fail_edid=//p' "$state_file" 2>/dev/null | tail -n 1)
now=$(date +%s 2>/dev/null || printf 0)
case "$now" in
	'' | *[!0-9]*) now=0 ;;
esac

case "$mode" in
	panel) target=panel ;;
	hdmi)
		if [ "$hdmi_connected" = 1 ]; then
			target=hdmi
		else
			target=panel
		fi
		;;
	*)
		if [ "$configured_target" = hdmi ] && [ "$hdmi_connected" = 1 ]; then
			# Hysteresis: a monitor that drops its EDID for a moment while
			# already active must not move the session back to the panel.
			target=hdmi
		elif [ "$hdmi_usable" = 1 ]; then
			target=hdmi
		else
			target=panel
		fi
		;;
esac

# The debug image masks kmsconvt@tty1 and runs a plain fbcon getty instead.
if [ -L /etc/systemd/system/kmsconvt@tty1.service ]; then
	if [ "$status_mode" = 1 ]; then
		printf 'session : masked (fbcon debug image)\n'
	fi
	exit 0
fi

if [ "$status_mode" = 1 ]; then
	printf 'mode    : %s%s\n' "$mode" \
		"$([ -n "$override" ] && printf ' (command line)')"
	printf 'HDMI    : %s, EDID %s bytes, pinned %s, enabled %s\n' \
		"$([ "$hdmi_connected" = 1 ] && printf connected || printf disconnected)" \
		"$hdmi_edid" \
		"$([ "$hdmi_pinned" = 1 ] && printf yes || printf no)" \
		"$([ "$hdmi_enabled" = 1 ] && printf yes || printf no)"
	printf 'target  : %s\n' "$target"
	printf 'current : %s\n' "${configured_target:-unknown}"
	printf 'drm     : %s\n' "${drm_state:-none}"
	for light in /sys/class/backlight/*; do
		[ -e "$light" ] || continue
		printf 'panel   : %s brightness=%s/%s bl_power=%s\n' \
			"${light##*/}" \
			"$(cat "$light/brightness" 2>/dev/null || true)" \
			"$(cat "$light/max_brightness" 2>/dev/null || true)" \
			"$(cat "$light/bl_power" 2>/dev/null || true)"
	done
	printf 'session : %s\n' \
		"$(systemctl is-active "$unit" 2>/dev/null || true)"
	exit 0
fi

# A connector change is not visible to kmscon, and the very first run after
# boot also has to make it re-scan the panel card. Nudge the DRM cards before
# the debounce so kmscon can re-scan while the switch settles.
if [ "${last_conn:-}" != "$conn_fingerprint" ]; then
	log "drm: $drm_state; nudging cards"
	nudge_drm
	last_conn=$conn_fingerprint
	printf '%s\n' "$last_conn" >"$run_dir/conn.state" 2>/dev/null || true
fi

# Debounce the HDMI direction in auto mode. A forced panel/HDMI choice and a
# --force/--recover run are explicit and apply immediately.
if [ "$target" = hdmi ] && [ "$configured_target" != hdmi ] &&
	[ "$force" = 0 ] && [ "$mode" = auto ]; then
	count=$(cat "$pending_file" 2>/dev/null || printf 0)
	case "$count" in
		'' | *[!0-9]*) count=0 ;;
	esac
	count=$((count + 1))
	printf '%s\n' "$count" >"$pending_file" 2>/dev/null || true
	if [ "$count" -lt "$hdmi_debounce" ]; then
		log "pending HDMI switch ($count/$hdmi_debounce)"
		exit 0
	fi
fi
rm -f "$pending_file"

config_state=$(/usr/local/bin/cpz-kmscon-config 2>/dev/null || printf 'error')
if [ "$config_state" = error ]; then
	# Keep the last good config instead of restarting kmscon every tick.
	log "kmscon config render failed"
fi

need_restart=0
if [ "$force" = 1 ] || [ "$recover" = 1 ] || [ "$config_state" = changed ]; then
	need_restart=1
fi

# Self-heal: if the session is not running (failed boot start, crash loop) and
# the start-failure backoff has expired, start it.
if [ "$need_restart" = 0 ] && ! session_up &&
	[ "$now" -ge "$start_fail_until" ]; then
	log "session is not active; starting it"
	need_restart=1
fi

# A failed restart is not retried in a loop: it waits until the connector
# state changes (the monitor was replugged or woke up) or --recover is used.
if [ -n "$retry_after" ] && [ "$retry_after" -gt "$now" ]; then
	case "$retry_after" in
		*[!0-9]*) retry_after=0 ;;
		*)
			if [ "${fail_conn:-}" != "$hdmi_connected" ] ||
				[ "${fail_edid:-}" != "$hdmi_edid" ]; then
				retry_after=0
			fi
			;;
	esac
fi

# Detect a hotplug that kmscon missed even after the nudges: HDMI is
# connected and usable, but no CRTC is attached to it. Give kmscon a few ticks
# first; a normal hotplug is handled without a restart.
if [ "$target" = hdmi ] && [ "$hdmi_enabled" = 0 ] && [ "$need_restart" = 0 ] &&
	session_up; then
	miss=$(cat "$miss_file" 2>/dev/null || printf 0)
	case "$miss" in
		'' | *[!0-9]*) miss=0 ;;
	esac
	miss=$((miss + 1))
	printf '%s\n' "$miss" >"$miss_file" 2>/dev/null || true
	case "$retry_after" in
		'' | *[!0-9]*) retry_after=0 ;;
	esac
	if [ "$miss" -ge "$hdmi_miss_ticks" ] && [ "$retry_after" -le "$now" ]; then
		log "HDMI was not picked up after nudging; restarting kmscon"
		need_restart=1
	fi
else
	rm -f "$miss_file"
fi

if [ "$need_restart" = 1 ]; then
	case "$config_state" in
		changed) log "restart: configuration changed" ;;
	esac
	if [ "$force" = 1 ]; then
		log "restart: forced"
	fi
	if restart_session; then
		rm -f "$miss_file"
		rm -f "$run_dir/start-fail"
		start_fail_until=0
		hdmi_probe
		if [ "$target" = hdmi ] && [ "$hdmi_connected" = 1 ] &&
			[ "$hdmi_enabled" = 0 ]; then
			log "HDMI is still not enabled after restart"
			retry_after=$((now + hdmi_fail_backoff))
			fail_conn=$hdmi_connected
			fail_edid=$hdmi_edid
		else
			retry_after=0
			fail_conn=""
			fail_edid=""
		fi
		log "output: $target (session restarted)"
	else
		# Do not hammer a failing unit: retry in a minute.
		printf '%s\n' "$((now + 60))" >"$run_dir/start-fail" 2>/dev/null || true
		log "restart failed; retrying in 60s"
	fi
fi

if [ "$target" = hdmi ] && [ "$hdmi_enabled" = 1 ] && session_up; then
	panel_off
else
	# Also the fallback when kmscon has not enabled HDMI yet: never hide the
	# panel while it may be the only working output.
	panel_on
fi

tmp=$state_file.tmp.$$
{
	printf 'target=%s\nmode=%s\n' "$target" "$mode"
	printf 'conn=%s\n' "$conn_fingerprint"
	case "$retry_after" in
		'' | *[!0-9]*) ;;
		*)
			if [ "$retry_after" -gt 0 ]; then
				printf 'retry_after=%s\n' "$retry_after"
				printf 'fail_conn=%s\n' "${fail_conn:-}"
				printf 'fail_edid=%s\n' "${fail_edid:-}"
			fi
			;;
	esac
} >"$tmp"
mv "$tmp" "$state_file"
