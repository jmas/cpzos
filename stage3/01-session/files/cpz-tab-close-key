#!/bin/sh
# Close-tab shortcut entry point (Alt+W by default): check the protected tabs
# before prompting. The binding is rebindable in Settings > Keyboard > Shortcuts.
#
# confirm-before needs a client context; run-shell does not have one, so the
# prompt is sent to an explicitly listed client.
set -eu

session=${1:-main}
tmux has-session -t "=$session" 2>/dev/null || exit 0

# tmux 3.5 replaces literal tabs in -F output with "_", so use spaces. The
# fixed fields come first and the window name is last.
windows=$(tmux list-windows -t "=$session" -F \
	"#{window_id} #{window_index} #{window_active} #{?@cpz_settings,1,0} #{window_name}")

current=$(printf '%s\n' "$windows" | awk '$3 == 1 { print; exit }')
[ -n "$current" ] || exit 0

read -r _window_id _index _active is_settings name <<EOF
$current
EOF

# Settings is not a terminal tab, so it never counts towards the last tab.
terminals=$(printf '%s\n' "$windows" |
	awk '$4 != 1 && $5 != "settings" { count++ } END { print count + 0 }')

notice=
if [ "$is_settings" = 1 ] || [ "$name" = settings ]; then
	notice="Settings stays open"
elif [ "$terminals" -le 1 ]; then
	notice="Last tab stays open"
fi

client=$(tmux list-clients -t "=$session" -F '#{client_name}' | head -n 1)
[ -n "$client" ] || exit 0

if [ -n "$notice" ]; then
	tmux display-message -c "$client" -d 3000 "$notice"
	exit 0
fi

tmux confirm-before -t "$client" -p "Close tab? (y/n)" \
	'run-shell -b /usr/local/bin/cpz-tab-close'
