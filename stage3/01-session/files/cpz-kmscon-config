#!/bin/sh
# Render the kmscon configuration used by cpz-kmscon.
#
# kmscon reads its configuration only once, at startup, and exposes no runtime
# API for fonts, palettes or timeouts. Everything that the Settings TUI can
# change is therefore rendered into /run/cpz-kmscon/kmscon.conf from the static
# template /etc/kmscon/kmscon.conf plus the current settings.
#
# Prints "changed" or "same" so cpz-kmscon-output can decide whether a restart
# is needed. The file is replaced atomically, so a concurrent kmscon start
# never reads a partial configuration.
set -eu

run_dir=/run/cpz-kmscon
out=$run_dir/kmscon.conf
base=/etc/kmscon/kmscon.conf
theme_dir=/etc/cpz/themes

first_home=$(getent passwd 1000 2>/dev/null | cut -d: -f6 || true)
[ -n "$first_home" ] || first_home=/root

get_setting() {
	for file in "$first_home/.config/cpz/settings.conf" /etc/cpz/settings.conf; do
		[ -r "$file" ] || continue
		value=$(sed -n "s/^$1=//p" "$file" | tail -n 1)
		[ -n "$value" ] && { printf '%s' "$value"; return 0; }
	done
	return 0
}

valid_hex() {
	case "$1" in
		??????) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*[!0-9a-fA-F]*) return 1 ;;
	esac
	return 0
}

# 1a1b26 -> 26,27,38 (kmscon palette entries are decimal RGB triples).
hex_rgb() {
	valid_hex "$1" || return 1
	r=$((0x${1%????}))
	g=$((0x$(printf '%s' "$1" | cut -c3-4)))
	b=$((0x${1#????}))
	printf '%s,%s,%s\n' "$r" "$g" "$b"
}

palette_name() {
	case "$1" in
		0) echo black ;;
		1) echo red ;;
		2) echo green ;;
		3) echo yellow ;;
		4) echo blue ;;
		5) echo magenta ;;
		6) echo cyan ;;
		7) echo light-grey ;;
		8) echo dark-grey ;;
		9) echo light-red ;;
		10) echo light-green ;;
		11) echo light-yellow ;;
		12) echo light-blue ;;
		13) echo light-magenta ;;
		14) echo light-cyan ;;
		15) echo white ;;
	esac
}

theme=$(get_setting theme)
case "$theme" in
	'' | *[!a-zA-Z0-9_-]*) theme=cpz-campbell ;;
esac
theme_conf=$theme_dir/$theme.conf
[ -r "$theme_conf" ] || theme_conf=$theme_dir/cpz-campbell.conf

# The tmux window style carries the theme's real body colours, which is what
# the console shows outside tmux as well. Fall back to the palette entries.
bg=""
fg=""
if [ -r "$theme_conf" ]; then
	style=$(sed -n 's/^set -g window-style "\(.*\)"$/\1/p' "$theme_conf" |
		head -n 1)
	bg=$(printf '%s' "$style" | sed -n 's/.*bg=#\([0-9a-fA-F]\{6\}\).*/\1/p')
	fg=$(printf '%s' "$style" | sed -n 's/.*fg=#\([0-9a-fA-F]\{6\}\).*/\1/p')
fi
valid_hex "$bg" || bg=$(sed -n 's/^# palette 0=//p' "$theme_conf" 2>/dev/null | tail -n 1)
valid_hex "$fg" || fg=$(sed -n 's/^# palette 7=//p' "$theme_conf" 2>/dev/null | tail -n 1)
valid_hex "$bg" || bg=101418
valid_hex "$fg" || fg=e6edf3

# Panel Text Size is a Terminus cell height; kmscon takes a pixel font size.
case "$(get_setting font_panel)" in
	8x16) font_size=16 ;;
	*) font_size=12 ;;
esac

case "$(get_setting screen_timeout)" in
	5) dpms=300 ;;
	10) dpms=600 ;;
	30) dpms=1800 ;;
	*) dpms=0 ;;
esac

layout=$(get_setting keyboard_layout_active)
case "$layout" in
	'' | *[!a-z0-9_-]*) layout=us ;;
esac

render() {
	# Drop the keys that are rendered below, then append this boot's values.
	sed -E \
		'/^(multi-monitor|font-size|dpms-timeout|xkb-layout|palette|palette-[a-z-]+)=/d' \
		"$base"
	printf '\n# Generated by cpz-kmscon-config from the CPZ settings.\n'
	printf 'multi-monitor=scaled\n'
	printf 'font-size=%s\n' "$font_size"
	printf 'dpms-timeout=%s\n' "$dpms"
	printf 'xkb-layout=%s\n' "$layout"
	printf 'palette=custom\n'
	index=0
	while [ "$index" -le 15 ]; do
		name=$(palette_name "$index")
		hex=$(sed -n "s/^# palette $index=//p" "$theme_conf" 2>/dev/null |
			tail -n 1)
		rgb=$(hex_rgb "$hex" 2>/dev/null || true)
		[ -n "$rgb" ] && [ -n "$name" ] &&
			printf 'palette-%s=%s\n' "$name" "$rgb"
		index=$((index + 1))
	done
	printf 'palette-background=%s\n' "$(hex_rgb "$bg")"
	printf 'palette-foreground=%s\n' "$(hex_rgb "$fg")"
}

mkdir -p "$run_dir"
tmp=$run_dir/.kmscon.conf.$$
trap 'rm -f "$tmp"' EXIT INT TERM
render >"$tmp"
chmod 0644 "$tmp"

if [ -f "$out" ] && cmp -s "$tmp" "$out"; then
	printf 'same\n'
else
	mv "$tmp" "$out"
	trap - EXIT INT TERM
	printf 'changed\n'
fi
