#!/bin/sh
# Control the running cmus from the media keys.
#
# Called by cpz-media-keys for the headset (centre KEY_PLAYPAUSE, side
# KEY_NEXTSONG/KEY_PREVIOUSSONG) and for the CPZ keyboard's Fn layer (Fn+Q
# play/pause, Fn+W previous, Fn+E next). Without a player the press is ignored.
set -u

action=${1:-}
case "$action" in
	next | prev | toggle) ;;
	*)
		printf 'usage: %s next|prev|toggle\n' "${0##*/}" >&2
		exit 2
		;;
esac

command -v cmus-remote >/dev/null 2>&1 || exit 1
pgrep -x cmus >/dev/null 2>&1 || exit 0

now_playing() {
	cmus-remote -Q 2>/dev/null | sed -n 's/^file //p'
}

case "$action" in
	toggle)
		cmus-remote -C "player-pause" >/dev/null 2>&1 || exit 1
		;;
	prev)
		# cmus restarts the current track when it has been playing for more
		# than a few seconds, and only goes to the previous track from the
		# start. The button should always step back, so restart first when
		# needed.
		pos=$(cmus-remote -Q 2>/dev/null | sed -n 's/^position //p') || pos=
		case "${pos:-0}" in
			'' | *[!0-9]*) pos=0 ;;
		esac
		if [ "$pos" -gt 3 ]; then
			cmus-remote -C "player-prev" >/dev/null 2>&1 || true
			sleep 0.3
		fi
		cmus-remote -C "player-prev" >/dev/null 2>&1 || exit 1
		;;
	next)
		before=$(now_playing)
		cmus-remote -C "player-next" >/dev/null 2>&1 || exit 1
		sleep 0.3
		after=$(now_playing)
		# cmus has no repeat at the end of the playlist: it keeps the last
		# track. The headset button should wrap to the first track instead.
		if [ -z "$after" ] || [ "$after" = "$before" ]; then
			cmus-remote -C "view 3" >/dev/null 2>&1 || true
			cmus-remote -C "win-top" >/dev/null 2>&1 || true
			cmus-remote -C "win-activate" >/dev/null 2>&1 || true
		fi
		;;
esac
