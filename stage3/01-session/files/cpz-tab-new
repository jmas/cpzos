#!/bin/sh
# Create a new tab immediately before the Settings tab, so Settings stays last,
# and switch the attached client to it.
set -eu

session=${1:-main}
tmux has-session -t "=$session" 2>/dev/null || exit 0

settings_id=$(tmux list-windows -t "=$session" -F \
	'#{window_id} #{?@cpz_settings,1,0} #{window_name}' |
	awk '$2 == 1 || $3 == "settings" { print $1; exit }')

if [ -n "$settings_id" ]; then
	new_id=$(tmux new-window -d -P -F '#{window_id}' -b -t "$settings_id" \
		-c "${HOME:-/}" -n shell)
else
	next=$(tmux list-windows -t "=$session" -F '#{window_index}' |
		awk '{ if ($1 + 0 > max) max = $1 + 0 } END { print max + 1 }')
	new_id=$(tmux new-window -d -P -F '#{window_id}' -t "=$session:$next" \
		-c "${HOME:-/}" -n shell)
fi

# run-shell has no client context, so select the tab on the attached client.
client=$(tmux list-clients -t "=$session" -F '#{client_name}' | head -n 1)
if [ -n "$client" ]; then
	tmux switch-client -c "$client" -t "$new_id"
else
	tmux select-window -t "$new_id" 2>/dev/null || true
fi

/usr/local/bin/cpz-tab-info "$session" 2>/dev/null || true
