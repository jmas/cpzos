#!/usr/bin/env python3
"""Volume and media buttons on a USB headset and the CPZ keyboard.

cage delivers key presses to the focused Wayland client, and foot has no
terminal sequence for KEY_VOLUMEUP/DOWN or the media keys, so the buttons on a
USB headset would otherwise do nothing.

This daemon reads the evdev devices (the CPZ user is in the input group),
reacts to press events only, and runs the matching helper. It rescans
/dev/input so a headset plugged in later starts working without a restart.

Headset: the volume rocker only changes the PipeWire volume; the centre button
toggles play/pause on a single press and skips to the next track on a double
press. The keyboard's Fn layer reports the same keycodes (Fn+A/S/D volume,
Fn+Q play/pause, Fn+W previous, Fn+E next, Fn+I/Fn+O brightness) and acts
immediately, like every other key.
"""

import glob
import os
import select
import struct
import subprocess
import sys
import time

EVENT = struct.Struct("llHHi")  # struct input_event, 64-bit timeval
EV_KEY = 0x01
VOLUME = "/usr/local/bin/cpz-volume"
BRIGHTNESS = "/usr/local/bin/cpz-brightness"
TRACK = "/usr/local/bin/cpz-track"
RESCAN = 2.0
DOUBLE_PRESS = 0.35
KEYBOARD = "tca8418c"
LOCK_MARKER = "/run/cpz-cage/screen.locked"

ACTIONS = {
    113: [VOLUME, "mute"],  # KEY_MUTE
    114: [VOLUME, "down"],  # KEY_VOLUMEDOWN
    115: [VOLUME, "up"],  # KEY_VOLUMEUP
    163: [TRACK, "next"],  # KEY_NEXTSONG
    165: [TRACK, "prev"],  # KEY_PREVIOUSSONG
    224: [BRIGHTNESS, "down"],  # KEY_BRIGHTNESSDOWN (Fn+I)
    225: [BRIGHTNESS, "up"],  # KEY_BRIGHTNESSUP (Fn+O)
}
CENTRE = 164  # KEY_PLAYPAUSE


def log(message):
    print(f"cpz-media-keys: {message}", file=sys.stderr, flush=True)


def run(command):
    subprocess.run(
        command,
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def device_name(path):
    try:
        with open(f"/sys/class/input/{os.path.basename(path)}/device/name") as handle:
            return handle.read().strip()
    except OSError:
        return ""


def brightness_level():
    """Return the saved panel brightness, or None when it is unreadable.

    cpz-brightness keeps the user's override in the same file Settings writes;
    the system file is only the fallback. Reading it here avoids starting a
    shell helper on every key press.
    """
    config = os.environ.get("XDG_CONFIG_HOME")
    if not config:
        config = os.path.join(os.environ.get("HOME") or "/home/cpz", ".config")
    for path in (
        os.path.join(config, "cpz", "settings.conf"),
        "/etc/cpz/settings.conf",
    ):
        value = None
        try:
            with open(path, encoding="utf-8") as handle:
                for line in handle:
                    if line.startswith("brightness="):
                        value = line.split("=", 1)[1].strip()
        except OSError:
            continue
        if value is not None:
            if not value:
                continue
            try:
                return int(value)
            except ValueError:
                return None
    return None


def wake_panel(code):
    """Restore a dim backlight on the first key press after 0%.

    A user who sets brightness to 0 can still type, but the panel looks dead;
    the first press brings it back to the 10% step. The brightness keys are
    excluded so Fn+I can keep the panel dark instead of turning it back on.
    """
    if code in (224, 225):  # KEY_BRIGHTNESSDOWN / KEY_BRIGHTNESSUP
        return
    # The lock screen restores the backlight itself. Letting both processes
    # react to the same key could apply the 0 -> 10% wake twice.
    if os.path.exists(LOCK_MARKER):
        return
    if brightness_level() == 0:
        run([BRIGHTNESS, "up"])


def rescan(open_fds, names):
    for path in sorted(glob.glob("/dev/input/event*")):
        if path in open_fds:
            continue
        try:
            open_fds[path] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        names[path] = device_name(path)


def close_all(open_fds):
    for handle in open_fds.values():
        try:
            os.close(handle)
        except OSError:
            pass
    open_fds.clear()


def press(code, device, pending, now):
    """Handle one press: volume keys act at once, the centre may be double."""
    if code == CENTRE:
        if device == KEYBOARD:
            # Fn+Q on the device is an ordinary key: play/pause immediately.
            run([TRACK, "toggle"])
            return
        if device in pending and now - pending[device] <= DOUBLE_PRESS:
            del pending[device]
            run([TRACK, "next"])
            return
        pending[device] = now
        return
    command = ACTIONS.get(code)
    if command:
        run(command)


def consume(handle, open_fds, names, pending, now):
    try:
        data = os.read(handle, EVENT.size * 64)
    except OSError:
        data = b""
    if not data:
        # Device unplugged or unreadable: drop it and wait for the rescan.
        for path, fd in list(open_fds.items()):
            if fd == handle:
                del open_fds[path]
                try:
                    os.close(fd)
                except OSError:
                    pass
                break
        return
    path = next((p for p, fd in open_fds.items() if fd == handle), "")
    device = names.get(path, "")
    for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
        _, _, etype, code, value = EVENT.unpack_from(data, offset)
        if etype != EV_KEY or value != 1:
            # Only presses: releases and autorepeat are ignored.
            continue
        wake_panel(code)
        press(code, device, pending, now)


def fire_pending(pending, now):
    """Resolve single centre presses; return how long select may wait."""
    wait = RESCAN
    for device, pressed in list(pending.items()):
        remaining = DOUBLE_PRESS - (now - pressed)
        # The test (and a timer firing at the deadline) lands exactly on the
        # threshold; floating point must not hold the press back.
        if remaining <= 1e-9:
            del pending[device]
            run([TRACK, "toggle"])
        else:
            wait = min(wait, remaining)
    return wait


def main():
    fds = {}
    names = {}
    pending = {}
    log("watching media keys")
    while True:
        rescan(fds, names)
        if not fds:
            time.sleep(RESCAN)
            continue
        wait = fire_pending(pending, time.monotonic())
        try:
            ready, _, _ = select.select(
                list(fds.values()), [], [], max(0.01, wait)
            )
        except OSError:
            # A device vanished between the scan and select(); start over.
            close_all(fds)
            time.sleep(0.2)
            continue
        for handle in ready:
            consume(handle, fds, names, pending, time.monotonic())


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
