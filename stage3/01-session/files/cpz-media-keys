#!/usr/bin/env python3
"""Volume and track buttons on a USB headset and the CPZ keyboard.

cage delivers key presses to the focused Wayland client, and foot has no
terminal sequence for KEY_VOLUMEUP/DOWN or the media keys. The buttons on a USB
headset therefore never reached cpz-volume or the player.

This daemon reads the evdev devices (the CPZ user is in the input group),
reacts to press events only, and runs the matching helper. It rescans
/dev/input so a headset plugged in later starts working without a restart.

The volume rocker is shared: a short press changes the PipeWire volume, a hold
of half a second skips to the previous/next track. The centre button toggles
play/pause. The CPZ keyboard's Fn layer reports the standard media keycodes
(Fn+Q play/pause, Fn+W previous, Fn+E next) and they are handled here as well.
"""

import glob
import os
import select
import struct
import subprocess
import sys
import time

EVENT = struct.Struct("llHHi")  # struct input_event, 64-bit timeval
EV_KEY = 0x01
VOLUME = "/usr/local/bin/cpz-volume"
TRACK = "/usr/local/bin/cpz-track"
RESCAN = 2.0
LONG_PRESS = 0.6

# Keys that act on the press: mute, the dedicated media keys and the centre
# button (KEY_PLAYPAUSE on the headset, Fn+Q on the keyboard).
TAP_ACTIONS = {
    113: [VOLUME, "mute"],  # KEY_MUTE
    163: [TRACK, "next"],  # KEY_NEXTSONG
    164: [TRACK, "toggle"],  # KEY_PLAYPAUSE
    165: [TRACK, "prev"],  # KEY_PREVIOUSSONG
}
# The volume rocker acts on release (short) or after LONG_PRESS (long).
HOLD_ACTIONS = {
    114: [VOLUME, "down"],  # KEY_VOLUMEDOWN
    115: [VOLUME, "up"],  # KEY_VOLUMEUP
}
LONG_ACTIONS = {
    114: [TRACK, "prev"],
    115: [TRACK, "next"],
}


def log(message):
    print(f"cpz-media-keys: {message}", file=sys.stderr, flush=True)


def run(command):
    subprocess.run(
        command,
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def rescan(open_fds):
    for path in sorted(glob.glob("/dev/input/event*")):
        if path in open_fds:
            continue
        try:
            open_fds[path] = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue


def close_all(open_fds):
    for handle in open_fds.values():
        try:
            os.close(handle)
        except OSError:
            pass
    open_fds.clear()


def consume(handle, open_fds, held, now):
    try:
        data = os.read(handle, EVENT.size * 64)
    except OSError:
        data = b""
    if not data:
        # Device unplugged or unreadable: drop it and wait for the rescan.
        for path, fd in list(open_fds.items()):
            if fd == handle:
                del open_fds[path]
                try:
                    os.close(fd)
                except OSError:
                    pass
                break
        return
    for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
        _, _, etype, code, value = EVENT.unpack_from(data, offset)
        if etype != EV_KEY:
            continue
        # value 1 is a press, 0 a release and 2 autorepeat (ignored).
        if value == 1 and code in TAP_ACTIONS:
            run(TAP_ACTIONS[code])
        elif value == 1 and code in HOLD_ACTIONS:
            held[code] = (now, False)
        elif value == 0 and code in held:
            started, fired = held.pop(code)
            if not fired:
                run(HOLD_ACTIONS[code])


def fire_long_presses(held, now):
    """Run the long action for keys held past the threshold; return the wait."""
    wait = RESCAN
    for code, (started, fired) in list(held.items()):
        if fired:
            # A missed release must not keep the key armed forever.
            if now - started > 5:
                held.pop(code, None)
            continue
        remaining = LONG_PRESS - (now - started)
        if remaining <= 0:
            run(LONG_ACTIONS[code])
            held[code] = (started, True)
        else:
            wait = min(wait, remaining)
    return wait


def main():
    fds = {}
    held = {}
    log("watching media keys")
    while True:
        rescan(fds)
        if not fds:
            time.sleep(RESCAN)
            continue
        now = time.monotonic()
        wait = fire_long_presses(held, now)
        try:
            ready, _, _ = select.select(
                list(fds.values()), [], [], max(0.01, wait)
            )
        except OSError:
            # A device vanished between the scan and select(); start over.
            close_all(fds)
            time.sleep(0.2)
            continue
        for handle in ready:
            consume(handle, fds, held, time.monotonic())


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
