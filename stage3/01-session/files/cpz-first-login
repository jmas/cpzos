#!/bin/sh
# Recommend setting a new password while the factory password is still in use.
# The prompt is bounded: it defaults to "keep" after a short timeout, so a
# first login cannot hang before tmux starts. cpz-settings keeps showing a
# warning until the password is changed.
#
# The build records /etc/shadow's mtime in /etc/cpz/shadow-mtime. Imager,
# rpi-preseed, passwd, usermod and chage all update that mtime, so any real
# password change clears the reminder automatically.
set -u

check_only=0
case "${1:-}" in
	'') ;;
	--check) check_only=1 ;;
	*)
		printf 'usage: %s [--check]\n' "${0##*/}" >&2
		exit 2
		;;
esac

stamp=/etc/cpz/shadow-mtime
needed=0
# /etc/shadow itself is not readable by the console user, but its mtime is
# available through stat(2) and is exactly what the build recorded. Checking
# -r here made the prompt dead code for uid 1000.
if [ -r "$stamp" ] && command -v passwd >/dev/null 2>&1; then
	current=$(stat -c %Y /etc/shadow 2>/dev/null || true)
	if [ -n "$current" ] &&
		[ "$current" = "$(cat "$stamp" 2>/dev/null || true)" ]; then
		needed=1
	fi
fi

if [ "$check_only" = 1 ]; then
	[ "$needed" = 1 ]
	exit
fi
[ "$needed" = 1 ] || exit 0

i18n() {
	if [ -x /usr/local/bin/cpz-i18n ]; then
		/usr/local/bin/cpz-i18n get "$@" 2>/dev/null || printf '%s' "${2:-$1}"
	else
		printf '%s' "${2:-$1}"
	fi
}

clear
printf '%s\n\n' "$(i18n 'CPZ is using the factory password.' 'CPZ is using the factory password.')"
prompt_timeout=${CPZ_PASSWORD_PROMPT_TIMEOUT:-3}
printf '%s' "$(i18n 'Change it now? [y/N] (default N in {seconds}s) ' 'Change it now? [y/N] ' | sed "s/{seconds}/$prompt_timeout/")"
answer=
if command -v timeout >/dev/null 2>&1; then
	# The single quotes are intentional: sh -c expands $answer in the child.
	# shellcheck disable=SC2016
	answer=$(timeout "$prompt_timeout" sh -c \
		'IFS= read -r answer && printf "%s" "$answer"' </dev/tty) || true
else
	read -r answer || exit 0
fi
case "$answer" in
y | Y | yes | YES | Yes) ;;
*)
	clear
	printf '%s\n' "$(i18n 'Skipped. Later: Settings > System > Password.' 'Skipped. Later: Settings > System > Password.')"
	sleep 1
	exit 0
	;;
esac

if passwd; then
	clear
	printf '%s\n' "$(i18n 'Password updated.' 'Password updated.')"
else
	clear
	printf '%s\n' "$(i18n 'Password not changed. Settings > System > Password.' 'Password not changed. Settings > System > Password.')"
	sleep 1
fi
exit 0
