#!/bin/sh
# Recommend setting a new password while the factory password is still in use.
# The prompt is bounded: it defaults to "keep" after a short timeout, so a
# first login cannot hang before tmux starts. cpz-settings keeps showing a
# warning until the password is changed.
#
# The build records /etc/shadow's mtime in /etc/cpz/shadow-mtime. Imager,
# rpi-preseed, passwd, usermod and chage all update that mtime, so any real
# password change clears the reminder automatically.
set -u

stamp=/etc/cpz/shadow-mtime
[ -r "$stamp" ] || exit 0
[ -r /etc/shadow ] || exit 0
command -v passwd >/dev/null 2>&1 || exit 0

current=$(stat -c %Y /etc/shadow 2>/dev/null || true)
[ -n "$current" ] || exit 0
[ "$current" = "$(cat "$stamp" 2>/dev/null || true)" ] || exit 0

clear
printf 'CPZ: the factory password is still in use.\n\n'
printf 'It is recommended to set a new password for this account.\n'
printf 'You can do it now, or later from Settings.\n\n'
prompt_timeout=${CPZ_PASSWORD_PROMPT_TIMEOUT:-10}
printf 'Set a new password now? [y/N] (default N in %ss) ' "$prompt_timeout"
answer=
if command -v timeout >/dev/null 2>&1; then
	# The single quotes are intentional: sh -c expands $answer in the child.
	# shellcheck disable=SC2016
	answer=$(timeout "$prompt_timeout" sh -c \
		'IFS= read -r answer && printf "%s" "$answer"' </dev/tty) || true
else
	read -r answer || exit 0
fi
case "$answer" in
y | Y | yes | YES | Yes) ;;
*)
	clear
	printf 'Keeping the factory password. You can change it later from Settings.\n'
	sleep 2
	exit 0
	;;
esac

if passwd; then
	clear
	printf 'Password updated.\n'
else
	clear
	printf 'Password not changed. You can set it later from Settings.\n'
	sleep 2
fi
exit 0
