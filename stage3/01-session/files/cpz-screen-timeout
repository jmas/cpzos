#!/bin/sh
# Apply the saved console blanking timeout to tty1.
#
# Blank the console only; do not power the HDMI link down. DPMS powerdown
# makes many Dell monitors sleep and renegotiate/re-read EDID on wake, which
# shows up as the display turning off/on and the console scale changing.
set -eu

home=${HOME:-/root}
user_settings=${XDG_CONFIG_HOME:-$home/.config}/cpz/settings.conf
system_settings=/etc/cpz/settings.conf

get() {
	for file in "$user_settings" "$system_settings"; do
		[ -r "$file" ] || continue
		value=$(sed -n "s/^$1=//p" "$file" | tail -n 1)
		[ -n "$value" ] && { printf '%s' "$value"; return 0; }
	done
	return 0
}

minutes=$(get screen_timeout)
case "$minutes" in
	'' | *[!0-9]*) minutes=0 ;;
esac
case "$minutes" in
	0 | 5 | 10 | 30) ;;
	*) minutes=0 ;;
esac

[ -w /dev/tty1 ] || exit 0
command -v setterm >/dev/null 2>&1 || exit 0

setterm -blank "$minutes" -powerdown 0 >/dev/tty1 2>/dev/null || true
