ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_PATH}=="platform-3f804000.i2c", ENV{ID_SEAT}="seat1", GROUP="input", MODE="0660"
# Stable name for the built-in keyboard, used by cpz-keyboard-layout to tell
# the TCA8418 apart from an external keyboard even if its path or name changes.
ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_PATH}=="platform-3f804000.i2c", ENV{ID_INPUT_KEYBOARD}=="1", SYMLINK+="input/cardputer-zero-internal"
