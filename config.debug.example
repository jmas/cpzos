# CPZ fbcon debug-image configuration.
# Copy to ./config or pass with ./build-docker.sh -c FILE.
# This image boots to a visible getty with verbose logs and no autologin.

IMG_NAME="cardputerzero-trixie-arm64-debug"
# Output names default to a dated name (YYYY-MM-DD-IMG_NAME). Set IMG_FILENAME
# or ARCHIVE_FILENAME only when you need a stable name; that file is replaced
# on every build.
RELEASE="trixie"
DEPLOY_COMPRESSION="xz"
TARGET_HOSTNAME="cpz"
FIRST_USER_NAME="cpz"
FIRST_USER_PASS="cpz"
ENABLE_SSH=1
LOCALE_DEFAULT="en_US.UTF-8"
KEYBOARD_KEYMAP="us"
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT="UTC"

PASSWORDLESS_SUDO=0
CPZ_DEBUG_BOOT=1

# See config.cpz.example for both settings.
WPA_COUNTRY=""
CPZ_DTOVERLAYS_REF="4f7aeee9fc103ebb03d22cac476bb191ecfb321e"

# Optional HDMI mode pin (see config.cpz.example).
CPZ_HDMI_VIDEO=""

# Terminal Trove catalog index (see config.cpz.example). Empty uses default.
CPZ_TROVE_INDEX_URL=""
